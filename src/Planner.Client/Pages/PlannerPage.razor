@page "/"
@inherits StateComponent
@inject LayoutState Layout
@inject DragDropService DragDrop
@inject TodayWatcher Today
@inject WindowHost Windows
@inject IJSRuntime JS
@inject ThemeState Theme
@inject RoleTasksState RoleTasks

<PageTitle>CoveyPlanner</PageTitle>

@if (State.IsLoaded)
{
    <div class="app @(Layout.Left == PanelMode.Open ? "" : "left-collapsed") @(Layout.Right == PanelMode.Open ? "" : "right-collapsed")">
        <SidePanel Side="PanelSide.Left" Title="Роли и цели">
            <RolesPanel />
        </SidePanel>
        <WeekView />
        <SidePanel Side="PanelSide.Right" Title="Когда-нибудь">
            <SomedayPanel />
        </SidePanel>
    </div>

    @* Окна — поверх всего экрана (см. WindowHost) *@
    @if (Windows.GoalId is { } goalId && State.FindGoal(goalId) is { } goal)
    {
        <GoalEditor @key="goalId" EditedGoal="goal" OnClose="Windows.Close" />
    }
    else if (Windows.RoleId is { } roleId && State.FindRole(roleId) is { } role)
    {
        <RoleEditor @key="roleId" Role="role" OnClose="Windows.Close" />
    }
    else if (Windows.IsNewRole)
    {
        <RoleEditor OnClose="Windows.Close" />
    }
    else if (Windows.SomedayTaskId is { } somedayTaskId && State.FindTask(somedayTaskId) is { } somedayTask)
    {
        <SomedayTaskEditor @key="somedayTaskId" EditedTask="somedayTask" OnClose="Windows.Close" />
    }
    else if (Windows.TaskId is { } taskId && State.FindTask(taskId) is { } task)
    {
        <TaskEditor @key="taskId" EditedTask="task" OnClose="Windows.Close" />
    }
}
else if (State.LoadError is not null)
{
    <div class="app-message">
        <p>Не удалось загрузить данные: @State.LoadError</p>
        <button class="add" @onclick="State.LoadAsync">Повторить</button>
    </div>
}
else
{
    <div class="app-message">Загрузка…</div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Layout.Changed += OnLayoutChanged;
        Windows.Changed += OnLayoutChanged;

        // Раскладку узнаём вместе с данными, чтобы панели не «прыгали» после первой отрисовки
        await Task.WhenAll(Layout.InitAsync(), State.LoadAsync(), DragDrop.InitAsync(), Today.InitAsync(), Theme.InitAsync(), RoleTasks.InitAsync(),
            WatchLongTitlesAsync());
    }

    /// <summary>Длинные названия записей: «…» и подсказка с полным текстом (js/clamp.js).</summary>
    private async Task WatchLongTitlesAsync()
    {
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/clamp.js");
            await module.InvokeVoidAsync("watch");
        }
        catch (JSException)
        {
            // Без JS длинные названия просто обрезаются на двух строках
        }
    }

    public override void Dispose()
    {
        Layout.Changed -= OnLayoutChanged;
        Windows.Changed -= OnLayoutChanged;
        base.Dispose();
    }

    private void OnLayoutChanged() => InvokeAsync(StateHasChanged);
}
