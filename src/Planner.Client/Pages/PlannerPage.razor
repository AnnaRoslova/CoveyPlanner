@page "/"
@inherits StateComponent
@inject LayoutState Layout
@inject DragDropService DragDrop
@inject TodayWatcher Today
@inject GoalEditorHost EditorHost
@inject ThemeState Theme

<PageTitle>CoveyPlanner</PageTitle>

@if (State.IsLoaded)
{
    <div class="app @(Layout.Left == PanelMode.Open ? "" : "left-collapsed") @(Layout.Right == PanelMode.Open ? "" : "right-collapsed")">
        <SidePanel Side="PanelSide.Left" Title="Роли и цели">
            <RolesPanel />
        </SidePanel>
        <WeekView />
        <SidePanel Side="PanelSide.Right" Title="Когда-нибудь">
            <SomedayPanel />
        </SidePanel>
    </div>

    @if (EditorHost.GoalId is { } goalId && State.FindGoal(goalId) is { } goal)
    {
        <GoalEditor @key="goalId" EditedGoal="goal" OnClose="EditorHost.Close" />
    }
}
else if (State.LoadError is not null)
{
    <div class="app-message">
        <p>Не удалось загрузить данные: @State.LoadError</p>
        <button class="add" @onclick="State.LoadAsync">Повторить</button>
    </div>
}
else
{
    <div class="app-message">Загрузка…</div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Layout.Changed += OnLayoutChanged;
        EditorHost.Changed += OnLayoutChanged;

        // Раскладку узнаём вместе с данными, чтобы панели не «прыгали» после первой отрисовки
        await Task.WhenAll(Layout.InitAsync(), State.LoadAsync(), DragDrop.InitAsync(), Today.InitAsync(), Theme.InitAsync());
    }

    public override void Dispose()
    {
        Layout.Changed -= OnLayoutChanged;
        EditorHost.Changed -= OnLayoutChanged;
        base.Dispose();
    }

    private void OnLayoutChanged() => InvokeAsync(StateHasChanged);
}
