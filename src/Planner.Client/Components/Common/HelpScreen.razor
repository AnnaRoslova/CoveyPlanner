@* «Как это устроено» (docs/specs/batch-ux.md, BG3) — экран поверх недели: словарь (одни и те же слова во всём интерфейсе, BG1),
   схема — как одно переходит в другое, пояснения, убранные из интерфейса (ui-declutter.md, D5), и горячие клавиши (BK).
   Вход — клавиша «?» и «⚙ Настройки → Как это устроено». Esc или клик мимо — закрыть. *@
@inject WindowHost Windows

<div class="help-backdrop" @onclick="Windows.Close"></div>

<section @ref="_root" class="help-screen" role="dialog" aria-label="Как это устроено" tabindex="-1" @onkeydown="OnKeyDown">
    <header class="help-h">
        <h2>Как это устроено</h2>
        <button type="button" class="close" title="Закрыть" aria-label="Закрыть" @onclick="Windows.Close"><Icon Name="x" Size="16" /></button>
    </header>

    <h3>Словарь</h3>
    <dl class="glossary">
        @foreach (var (word, meaning) in Glossary)
        {
            <dt>@word</dt>
            <dd>@meaning</dd>
        }
    </dl>

    <h3>Как одно переходит в другое</h3>
    @* Схема — свой SVG, цвета темы (BD7: без библиотек) *@
    <svg class="scheme" viewBox="0 0 640 250" role="img"
         aria-label="Мысль ставят в день — она становится делом, отмеченное дело — в «Выполненном». Мысль можно сделать проектом: у проекта шаги, их раскладывают по дням. Цель недели — это занятия; цель «каждую неделю» с «копить» — привычка, её занятия — скрепки в банке.">
        <defs>
            <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" class="arrow-head" />
            </marker>
        </defs>
        @foreach (var (x, y, w, label) in Boxes)
        {
            <rect x="@x" y="@y" width="@w" height="34" rx="12" class="box" />
            @Svg.Text(x + w / 2, y + 22, "box-t", label)
        }
        @foreach (var (x1, y1, x2, y2, label) in Arrows)
        {
            <line x1="@x1" y1="@y1" x2="@x2" y2="@y2" class="arrow" marker-end="url(#arr)" />
            @if (label is not null)
            {
                @Svg.Text((x1 + x2) / 2, (y1 + y2) / 2 - 6, "arrow-t", label)
            }
        }
    </svg>

    <h3>Если непонятно</h3>
    <ul class="notes">
        @foreach (var note in Notes)
        {
            <li>@note</li>
        }
    </ul>

    <h3>Горячие клавиши</h3>
    <table class="keys">
        @foreach (var (key, action) in Keys)
        {
            <tr><td><kbd>@key</kbd></td><td>@action</td></tr>
        }
    </table>
    <p class="hint">Клавиши без Ctrl не срабатывают, пока вы печатаете в поле.</p>
</section>

@code {
    private ElementReference _root;

    /// <summary>Словарь BG1 — каждое понятие одной фразой.</summary>
    public static readonly (string Word, string Meaning)[] Glossary =
    [
        ("мысль", "запись в ленте «Когда-нибудь», без даты"),
        ("дело", "то, что делают в конкретный день или на этой неделе; мысль, поставленная в день, — уже дело"),
        ("проект", "дело из нескольких шагов, например «Ремонт» или книга; живёт во вкладке «Проекты»"),
        ("шаг", "часть проекта; его можно поставить в день, у шага своих шагов нет"),
        ("цель недели", "«большой камень» роли на неделю: что сделать N раз"),
        ("камень", "то же, что цель недели"),
        ("занятие", "дело, которое засчитывается в цель; на записи — значок ◆"),
        ("привычка", "цель «каждую неделю» с «🫙 копить»"),
        ("скрепка", "одно выполненное занятие привычки; скрепки копятся в банку"),
        ("роль", "кто я: Работа, Семья…; 4 измерения пилы — Тело, Ум, Дух, Общение"),
        ("категория", "папка ленты — о чём мысль; к ролям отношения не имеет"),
        ("на неделе", "дело этой недели без дня — ждёт под своей ролью"),
    ];

    private static readonly (int X, int Y, int W, string Label)[] Boxes =
    [
        (10, 20, 110, "мысль"), (200, 20, 110, "дело"), (390, 20, 140, "✓ выполненное"),
        (10, 110, 110, "🛠 проект"), (200, 110, 110, "шаги"), (390, 110, 140, "шаг в дне"),
        (10, 200, 120, "цель недели"), (200, 200, 110, "занятия ◆"), (390, 200, 240, "привычка → скрепки в банке"),
    ];

    private static readonly (int X1, int Y1, int X2, int Y2, string? Label)[] Arrows =
    [
        (120, 37, 198, 37, "в день"), (310, 37, 388, 37, "отметить"),
        (65, 54, 65, 108, null), (120, 127, 198, 127, "+ шаг"), (310, 127, 388, 127, "в день"),
        (130, 217, 198, 217, "N раз"), (310, 217, 388, 217, "каждую неделю + 🫙"),
    ];

    /// <summary>Пояснения, которые раньше стояли в интерфейсе (ui-declutter.md, D5).</summary>
    private static readonly string[] Notes =
    [
        "Роли и цели — «большие камни» этой недели: лучше 1–3 на роль.",
        "Цель — шаблон занятий: новые занятия берут её время, длительность, квадрант и заметки.",
        "Правка постоянной цели («каждую неделю») действует с этой недели и дальше; прошлые недели не меняются.",
        "Одно занятие цели в день — если в окне цели не включено «можно несколько раз в день».",
        "Стартовое число банки — скрепки, накопленные до привычки: они идут только в общий счёт.",
        "Неделя привычки засчитана, если скрепок не меньше нормы; первый пропуск — пауза ⚠, второй подряд — серия обрывается.",
        "Пока у цели нет выполненных занятий, справа пустой кружок; потом — процент.",
        "Выполненные дела стоят внизу дня; сняли отметку — дело вернулось на своё место.",
    ];

    /// <summary>Горячие клавиши (batch-ux.md, BK).</summary>
    public static readonly (string Key, string Action)[] Keys =
    [
        ("N", "записать мысль"), ("D", "дело на сегодня"), ("← →", "прошлая / следующая неделя"), ("T", "к сегодня"),
        ("Ctrl+K или /", "быстрый поиск по всему"), ("H", "📈 Итоги"), ("W", "недельный обзор"), ("P", "вкладки «Мысли ⇄ Проекты»"),
        ("?", "как это устроено"), ("Ctrl+Enter", "сохранить окно"), ("Esc", "закрыть меню, окно, экран"),
        ("Ctrl+Z", "«Вернуть» на последней плашке (вне поля ввода)"),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _root.FocusAsync(); // Esc закрывает экран сразу
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Windows.Close();
        }
    }
}
