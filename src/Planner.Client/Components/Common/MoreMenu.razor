@* «⋯» внизу окна (docs/specs/ui-declutter.md, U2.3): меню редких действий. Пункты — MenuItem (опасный — последним, за чертой
   <div class="menu-sep">, розовым; недоступный — бледный, с причиной справа). Esc и клик мимо закрывают только меню, окно остаётся
   (Popover, js/popover.js); ↑↓ — по пунктам. Стили — css/editor.css. *@

<button @ref="_button" type="button" class="btn more-b @Class" title="@Title" aria-label="@Title" aria-haspopup="menu"
        aria-expanded="@(_open ? "true" : "false")" @onclick="() => _open = !_open">
    <Icon Name="more" Size="16" />
</button>

@if (_open)
{
    <Popover Anchor="_button" OnClose="Close" Class="options more-menu" Role="menu" Label="@Title" Arrows="true">
        <CascadingValue Value="this" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </Popover>
}

@code {
    private ElementReference _button;
    private bool _open;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string Title { get; set; } = "Ещё действия";

    [Parameter]
    public string? Class { get; set; }

    /// <summary>Закрыть меню (пункт выбран, клик мимо, Esc).</summary>
    public void Close()
    {
        _open = false;
        StateHasChanged();
    }
}
