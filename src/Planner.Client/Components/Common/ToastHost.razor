@* Всплывающее сообщение в шапке недели, между подписью периода и «📈 ⚙» (все плашки — в одном месте, polish-1.md P1; место — Notices);
   исчезает само через несколько секунд. Текст — в одну-две строки, дальше «…» и полный в подсказке; действия видны всегда (P3).
   У сообщения может быть одна-две кнопки-действия («Вернуть», «Показать», «в корзину · вернуть»); клик по остальному — закрыть. *@
@implements IDisposable
@inject Notifier Notifier

@if (Notifier.Message is { } message)
{
    var version = Notifier.Version;
    <div class="toast @(Notifier.IsError ? "error" : "") @(Notifier.IsClip ? "clip-toast" : "") @(Notifier.IsNearTrash ? "near-trash" : "")" role="status" @onclick="() => Notifier.Dismiss(version)">
        @if (Notifier.IsClip)
        {
            @* @key — у каждой подсказки анимация заново *@
            <span @key="version" class="clip" aria-hidden="true">📎</span>
        }
        <span class="msg" title="@message">@message</span>
        @if (Notifier.ActionLabel is { } label)
        {
            <span class="sep">·</span>
            <button type="button" class="action @(IsDanger(label) ? "danger" : "")" @onclick="() => Notifier.RunActionAsync(version)" @onclick:stopPropagation="true">@label</button>
        }
        @if (Notifier.SecondActionLabel is { } second)
        {
            <span class="sep">·</span>
            <button type="button" class="action @(IsDanger(second) ? "danger" : "")" @onclick="() => Notifier.RunActionAsync(version, second: true)" @onclick:stopPropagation="true">@second</button>
        }
    </div>
}

@code {
    private int _shownVersion;

    /// <summary>«в корзину» на плашке — опасная пилюля (D1), остальные действия — обычные.</summary>
    private static bool IsDanger(string label) => label == "в корзину";

    protected override void OnInitialized() => Notifier.Changed += OnChanged;

    public void Dispose() => Notifier.Changed -= OnChanged;

    private void OnChanged()
    {
        var version = Notifier.Version;
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();

            // Таймер — один на сообщение (Changed приходит и при его закрытии)
            if (Notifier.Message is not null && version != _shownVersion)
            {
                _shownVersion = version;
                await Task.Delay(Notifier.Duration);
                Notifier.Dismiss(version);
            }
        });
    }
}
