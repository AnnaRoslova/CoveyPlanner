@* Запись-строка (не карточка): дело в дне, дело в ленте или цель роли.
   Слева квадратный чекбокс цвета роли (или точка-маркер в ленте), справа пилюли и действия. *@

<div class="item @(IsDone ? "done" : "") @(OnClick.HasDelegate ? "clickable" : "") @(IsPending ? "pending" : "")"
     style="@(Color is null ? null : $"--c: {Color}")"
     data-drag="@DragKind" data-id="@DragId" data-fixed="@DragFixed" data-press
     @onclick="OnClick">
    @if (Marker == ItemMarker.Check && OnToggle.HasDelegate)
    {
        @* Зона нажатия — вся левая полоса записи (~30px, на всю высоту); квадратик внутри прежний *@
        <button type="button" class="ck-hit" role="checkbox" aria-checked="@(IsDone ? "true" : "false")"
                title="@(IsDone ? "Снять отметку" : "Выполнено")"
                @onclick="OnToggle" @onclick:stopPropagation="true"><span class="ck"></span></button>
    }
    else if (Marker == ItemMarker.Check)
    {
        <span class="ck"></span>
    }
    else
    {
        <span class="dot"></span>
    }
    <div class="tx">
        @foreach (var segment in TextSearch.Split(Title, Highlight))
        {
            if (segment.IsMatch)
            {
                <mark class="hit">@segment.Text</mark>
            }
            else
            {
                @segment.Text
            }
        }
        @if (!string.IsNullOrWhiteSpace(Notes))
        {
            <span class="note" title="@NotesPreview"><Icon Name="note" Size="11" /></span>
        }
        @if (TimeLabel is not null || DurationLabel is not null || IsRock)
        {
            <div class="pills">
                @if (TimeLabel is not null)
                {
                    <span class="pill time">@TimeLabel</span>
                }
                @if (DurationLabel is not null)
                {
                    <span class="pill dur">@DurationLabel</span>
                }
                @if (IsRock)
                {
                    <span class="pill rock">камень</span>
                }
            </div>
        }
        @if (Days is { Count: > 0 })
        {
            <div class="goal-days">
                @for (var i = 0; i < Days.Count; i++)
                {
                    if (i > 0)
                    {
                        <span class="sep">·</span>
                    }
                    <span class="d @(Days[i].IsDone ? "done" : "")">@Days[i].Label</span>
                }
            </div>
        }
    </div>
    @if (Progress is not null)
    {
        <span class="progress">@Progress</span>
    }
    @if (Actions is not null)
    {
        <div class="actions" @onclick:stopPropagation="true">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>Цвет роли (чекбокс). null — бледный по умолчанию.</summary>
    [Parameter]
    public string? Color { get; set; }

    [Parameter]
    public bool IsDone { get; set; }

    [Parameter]
    public ItemMarker Marker { get; set; } = ItemMarker.Check;

    /// <summary>Пилюля времени «15:00» (бирюзовая).</summary>
    [Parameter]
    public string? TimeLabel { get; set; }

    /// <summary>Пилюля «камень» (розовая) — дело связано с целью недели.</summary>
    [Parameter]
    public bool IsRock { get; set; }

    /// <summary>Пилюля длительности «~30 мин».</summary>
    [Parameter]
    public string? DurationLabel { get; set; }

    /// <summary>Прогресс цели «2/5» — справа в строке названия.</summary>
    [Parameter]
    public string? Progress { get; set; }

    /// <summary>Дни, на которые стоят занятия цели («Чт · Пт»), — мелко под названием.</summary>
    [Parameter]
    public IReadOnlyList<DayMark>? Days { get; set; }

    /// <summary>Заметки дела: если есть — маленький значок, текст во всплывающей подсказке.</summary>
    [Parameter]
    public string? Notes { get; set; }

    private string? NotesPreview =>
        Notes is { Length: > 300 } longNotes ? longNotes[..300] + "…" : Notes;

    /// <summary>Текст поиска — совпадения в названии подсвечиваются.</summary>
    [Parameter]
    public string? Highlight { get; set; }

    /// <summary>Клик по чекбоксу — отметить / снять «выполнено».</summary>
    [Parameter]
    public EventCallback OnToggle { get; set; }

    /// <summary>Клик по записи (например, переименование).</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>Кнопки справа, видны при наведении (клик по ним не считается кликом по записи).</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>Запись ещё сохраняется на сервере.</summary>
    [Parameter]
    public bool IsPending { get; set; }

    /// <summary>Вид для перетаскивания (data-drag, см. DragDropService). null — запись не перетаскивается.</summary>
    [Parameter]
    public string? DragKind { get; set; }

    [Parameter]
    public int DragId { get; set; }

    /// <summary>У записи своё место в зоне (дело со временем в дне) — ручной порядок на неё не влияет.</summary>
    [Parameter]
    public bool DragFixed { get; set; }
}
