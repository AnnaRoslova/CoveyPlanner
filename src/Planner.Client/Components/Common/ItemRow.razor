@* Запись-строка (не карточка): дело в дне, дело в ленте или цель роли.
   Слева квадратный чекбокс цвета роли (или точка-маркер в ленте), справа пилюли и действия.
   Clamp: название не длиннее двух строк, с «…»; полный текст — в подсказке при наведении (только у обрезанных:
   их отмечает js/clamp.js атрибутом data-long, он же показывает подсказку) и в окне по клику. *@

<div class="item @(IsDone ? "done" : "") @(Compact ? "compact" : "") @(OnTrash.HasDelegate ? "trashable" : "") @(OnClick.HasDelegate ? "clickable" : "") @(IsPending ? "pending" : "") @(IsFlashing ? "flash" : "")"
     style="@(Color is null ? null : $"--c: {Color}")"
     data-drag="@DragKind" data-id="@DragId" data-fixed="@DragFixed" data-press data-swipe="@OnTrash.HasDelegate"
     data-drop="@DropZone" data-key="@DropKey" data-accept="@DropAccept" data-drop-index="@(DropZone is null ? null : "0")"
     data-drop-hover="@(DropZone is not null)" data-drop-middle="@(DropZone is not null)" data-drop-hint="@DropHint"
     @onclick="OnClick">
    @if (Marker == ItemMarker.Check && OnToggle.HasDelegate)
    {
        @* Зона нажатия — вся левая полоса записи (~30px, на всю высоту); квадратик внутри прежний *@
        <button type="button" class="ck-hit" role="checkbox" aria-checked="@(IsDone ? "true" : "false")"
                title="@(IsDone ? "Снять отметку" : "Выполнено")"
                @onclick="OnToggle" @onclick:stopPropagation="true"><span class="ck"></span></button>
    }
    else if (Marker == ItemMarker.Check)
    {
        <span class="ck"></span>
    }
    else
    {
        <span class="dot"></span>
    }
    <div class="tx">
        <span class="title @(Clamp ? "clamp" : "") @(Compact ? "one-line" : "")">@foreach (var segment in TextSearch.Split(Title, Highlight))
        {
            if (segment.IsMatch)
            {
                <mark class="hit">@segment.Text</mark>
            }
            else
            {
                @segment.Text
            }
        }@if (!string.IsNullOrWhiteSpace(Notes))
        {
            <span class="note" title="@NotesPreview"><Icon Name="note" Size="11" /></span>
        }</span>
        @if (RoleDots is { Count: > 0 } dots)
        {
            <span class="role-dots" title="@string.Join(", ", dots.Select(r => r.Name))">
                @foreach (var role in dots)
                {
                    <i style="--c: @role.Color"></i>
                }
            </span>
        }
        @if (TimeLabel is not null || DurationLabel is not null || IsRock || Badge is not null)
        {
            <div class="pills">
                @if (TimeLabel is not null)
                {
                    <span class="pill time">@TimeLabel</span>
                }
                @if (DurationLabel is not null)
                {
                    <span class="pill dur">@DurationLabel</span>
                }
                @if (IsRock)
                {
                    <span class="pill rock">камень</span>
                }
                @Badge
            </div>
        }
        @if (Days is { Count: > 0 } || ProgressBelow)
        {
            <div class="goal-days">
                @if (ProgressBelow)
                {
                    <span class="progress below">@Progress</span>
                }
                @for (var i = 0; i < (Days?.Count ?? 0); i++)
                {
                    if (i > 0 || ProgressBelow)
                    {
                        <span class="sep">·</span>
                    }
                    <span class="d @(Days![i].IsDone ? "done" : "")">@Days[i].Label</span>
                }
            </div>
        }
    </div>
    @if (Progress is not null && !ProgressBelow)
    {
        <span class="progress">@Progress</span>
    }
    @if (Percent is { } percent)
    {
        <span class="pct @(percent >= 100 ? "full" : "")" title="Выполнено занятий этой недели: @percent%">@(percent >= 100 ? "100% ✓" : $"{percent}%")</span>
    }
    @if (Actions is not null)
    {
        <div class="actions" @onclick:stopPropagation="true">@Actions</div>
    }
    @if (OnTrash.HasDelegate)
    {
        @* В корзину без подтверждения (с «Вернуть»): мышью — при наведении; на касании — после свайпа влево (js/dnd.js, класс swiped) *@
        <button type="button" class="trash-btn" title="В корзину" aria-label="В корзину" data-strict-click
                @onclick="OnTrash" @onclick:stopPropagation="true"><Icon Name="trash" Size="13" /></button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>Название — не больше двух строк, с «…»; полный текст — в подсказке и в окне (дела в днях и в ленте).</summary>
    [Parameter]
    public bool Clamp { get; set; }

    /// <summary>Роли дела, когда их несколько: маленькие точки их цветов после названия.</summary>
    [Parameter]
    public IReadOnlyList<RoleDto>? RoleDots { get; set; }

    /// <summary>Цвет роли (чекбокс). null — бледный по умолчанию.</summary>
    [Parameter]
    public string? Color { get; set; }

    [Parameter]
    public bool IsDone { get; set; }

    [Parameter]
    public ItemMarker Marker { get; set; } = ItemMarker.Check;

    /// <summary>Пилюля времени «15:00» (бирюзовая).</summary>
    [Parameter]
    public string? TimeLabel { get; set; }

    /// <summary>Пилюля «камень» (розовая) — дело связано с целью недели.</summary>
    [Parameter]
    public bool IsRock { get; set; }

    /// <summary>Своя пилюля после остальных (у цели — «🫙 102 · 🔥13» её копилки).</summary>
    [Parameter]
    public RenderFragment? Badge { get; set; }

    /// <summary>Пилюля длительности «~30 мин».</summary>
    [Parameter]
    public string? DurationLabel { get; set; }

    /// <summary>Прогресс цели «2/5» — справа в строке названия.</summary>
    [Parameter]
    public string? Progress { get; set; }

    /// <summary>Процент выполнения цели («50%», 100 — «100% ✓» мятным) — справа в строке. null — не показывать.</summary>
    [Parameter]
    public int? Percent { get; set; }

    /// <summary>Справа уже процент — «2/5» переезжает под название, в начало строки дней («2/5 · Чт · Пт»): узкой панели не тесно.</summary>
    private bool ProgressBelow => Progress is not null && Percent is not null;

    /// <summary>Свёрнутая запись: название в одну строку с «…» (цели в левой панели, «свернуть все цели»).</summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>«В корзину» прямо из строки (дела в днях): серая иконка справа при наведении. Нет делегата — нет иконки.</summary>
    [Parameter]
    public EventCallback OnTrash { get; set; }

    /// <summary>Дни, на которые стоят занятия цели («Чт · Пт»), — мелко под названием.</summary>
    [Parameter]
    public IReadOnlyList<DayMark>? Days { get; set; }

    /// <summary>Заметки дела: если есть — маленький значок, текст во всплывающей подсказке.</summary>
    [Parameter]
    public string? Notes { get; set; }

    private string? NotesPreview =>
        Notes is { Length: > 300 } longNotes ? longNotes[..300] + "…" : Notes;

    /// <summary>Текст поиска — совпадения в названии подсвечиваются.</summary>
    [Parameter]
    public string? Highlight { get; set; }

    /// <summary>Клик по чекбоксу — отметить / снять «выполнено».</summary>
    [Parameter]
    public EventCallback OnToggle { get; set; }

    /// <summary>Клик по записи (например, переименование).</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>Кнопки справа, видны при наведении (клик по ним не считается кликом по записи).</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>Коротко подсветить запись (например, «уже есть в этот день»).</summary>
    [Parameter]
    public bool IsFlashing { get; set; }

    /// <summary>Запись ещё сохраняется на сервере.</summary>
    [Parameter]
    public bool IsPending { get; set; }

    /// <summary>Вид для перетаскивания (data-drag, см. DragDropService). null — запись не перетаскивается.</summary>
    [Parameter]
    public string? DragKind { get; set; }

    [Parameter]
    public int DragId { get; set; }

    /// <summary>Запись — ещё и место, куда можно бросить (цель: «сделать дело занятием этой цели»); null — нет.</summary>
    [Parameter]
    public string? DropZone { get; set; }

    [Parameter]
    public string? DropKey { get; set; }

    [Parameter]
    public string? DropAccept { get; set; }

    /// <summary>Подпись при наведении с записью («сделать занятием этой цели»).</summary>
    [Parameter]
    public string? DropHint { get; set; }

    /// <summary>У записи своё место в зоне (дело со временем в дне) — ручной порядок на неё не влияет.</summary>
    [Parameter]
    public bool DragFixed { get; set; }
}
