@* Раскрытый список шагов проекта — прямо в дне или в ленте, под строкой «▸ Ремонт ☑ 2/5» (S2, S11, S19, S20).
   Шаг: чекбокс (общий с его строкой в дне), название, метка дня, 🗑 при наведении (в корзину с «Вернуть», R3); клик — окно шага. Шаг можно перетащить в любой день,
   на другую неделю, на цель, в ленту (станет мыслью); бросить сюда же — порядок и «снять с дня». В конце — «+ шаг».
   Занятия целей среди шагов здесь не показываются — они в счёте «12 занятий» (S17). *@
@inherits StateComponent
@inject WindowHost Windows

<div class="steps" data-drop="@(ParentId > 0 ? DragDropService.StepsZone : null)" data-key="@ParentId" data-accept="@DragDropService.StepsAccepts">
    @foreach (var step in ParentId > 0 ? State.CountedStepsOf(ParentId) : Array.Empty<TaskDto>())
    {
        var roles = State.RolesOf(step);
        var id = step.Id;
        <ItemRow @key="id" Title="@step.Title" Clamp="true" Highlight="@Highlight"
                 Color="@roles.FirstOrDefault()?.Color"
                 IsDone="step.State == TaskStateDto.Done"
                 DayLabel="@DayLabel(step)"
                 IsPending="id < 0"
                 OnToggle="() => State.SetDoneAsync(id, step.State != TaskStateDto.Done, ViaSessionId)"
                 OnTrash="() => id > 0 ? State.TrashTaskAsync(id) : Task.CompletedTask"
                 OnClick="() => id > 0 ? OpenStep(id) : Task.CompletedTask"
                 DragKind="@(id > 0 ? DragDropService.StepItem : null)"
                 DragId="id" />
    }

    @if (_adding)
    {
        <Dismissable OnDismiss="StopAdding" OnClickOutside="SaveAndCloseAsync">
            <InlineInput @bind-Value="_newTitle" Placeholder="Новый шаг — Enter" MaxLength="500"
                         OnSubmit="AddAsync" OnCancel="StopAdding" CancelOnEmptyBlur="false" />
        </Dismissable>
    }
    else
    {
        <button type="button" class="add add-step" @onclick="() => _adding = true">+ шаг</button>
    }
</div>

@code {
    private bool _adding;
    private string _newTitle = "";

    /// <summary>Дело-проект, чьи шаги в списке; 0 — проекта пока нет (у цели), список пуст, есть только «+ шаг».</summary>
    [Parameter, EditorRequired]
    public int ParentId { get; set; }

    /// <summary>Шаги цели (её проекта): «+ шаг» идёт через цель — нет проекта, он создаётся (G3).</summary>
    [Parameter]
    public int? GoalId { get; set; }

    /// <summary>Список показан в строке или окне этого занятия цели: последний шаг отмечает проект и это занятие (R4).</summary>
    [Parameter]
    public int? ViaSessionId { get; set; }

    /// <summary>Текст поиска — совпадения в названиях шагов подсвечиваются.</summary>
    [Parameter]
    public string? Highlight { get; set; }

    /// <summary>В ленте шаги из разных недель — метка с датой («Чт 9 окт»), в дне хватает дня недели («Чт»).</summary>
    [Parameter]
    public bool LongDates { get; set; }

    private string? DayLabel(TaskDto step) => step.PlannedDate is { } date
        ? LongDates || RuDates.WeekStartOf(date) != State.WeekStart ? RuDates.ShortDate(date) : RuDates.ShortDay(date)
        : null;

    private Task OpenStep(int stepId)
    {
        Windows.OpenTask(stepId);
        return Task.CompletedTask;
    }

    private async Task AddAsync(string title)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            return;
        }

        _newTitle = "";
        if (GoalId is { } goalId)
        {
            await State.AddGoalStepAsync(goalId, title);
        }
        else
        {
            await State.AddProjectStepAsync(ParentId, title);
        }
    }

    private async Task SaveAndCloseAsync()
    {
        var title = _newTitle;
        StopAdding();
        await AddAsync(title);
    }

    private void StopAdding()
    {
        _adding = false;
        _newTitle = "";
    }
}
