@* Квадрант: одно поле «II · важно, не срочно ▾» (docs/specs/ui-declutter.md, U2.5; было — 5 кнопок и подсказка под ними). *@

<ChoiceField TValue="int?" Items="Choices" Value="Value" ValueChanged="ValueChanged" Label="Квадрант" />

@code {
    public static readonly (int Value, string Roman, string Hint)[] Quadrants =
    [
        (1, "I", "важно и срочно"),
        (2, "II", "важно, не срочно"),
        (3, "III", "срочно, не важно"),
        (4, "IV", "не срочно и не важно"),
    ];

    private static readonly IReadOnlyList<Choice<int?>> Choices =
    [
        new(null, "—"),
        .. Quadrants.Select(q => new Choice<int?>(q.Value, Label(q.Value))),
    ];

    [Parameter]
    public int? Value { get; set; }

    [Parameter]
    public EventCallback<int?> ValueChanged { get; set; }

    public static string Roman(int quadrant) => Quadrants.First(q => q.Value == quadrant).Roman;

    public static string Hint(int quadrant) => Quadrants.First(q => q.Value == quadrant).Hint;

    /// <summary>«II · важно, не срочно».</summary>
    public static string Label(int quadrant) => $"{Roman(quadrant)} · {Hint(quadrant)}";
}
