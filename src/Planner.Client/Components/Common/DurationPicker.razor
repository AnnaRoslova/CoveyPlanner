@* Примерная длительность «⏱ 1 ч 30 мин» — барабан часы (0–12) | минуты (0–59, шаг 1); пустое — «⏱ длительность» приглушённо
   (polish-3.md, T1), «очистить» — не задана; 0 ч 0 мин — тоже не задана. Пустое поле при открытии получает 30 минут. *@

<WheelField Text="@(Value is { } minutes ? $"⏱ {Format(minutes)}" : "⏱ длительность")" IsEmpty="Value is null"
            Hours="Math.Min(MaxHours, _shown / 60)" Minutes="_shown % 60" MaxHours="MaxHours" Units="true" Label="Длительность"
            Changed="v => SetAsync(v.Hours * 60 + v.Minutes)" OnOpenEmpty="() => SetAsync(DefaultMinutes)"
            OnClear="ClearAsync" />

@code {
    private const int MaxHours = 12;
    private const int DefaultMinutes = 30;

    [Parameter]
    public int? Value { get; set; }

    [Parameter]
    public EventCallback<int?> ValueChanged { get; set; }

    // Что стоит на барабане: при 0 ч 0 мин значения нет, а барабан остаётся на нуле
    private int _shown = DefaultMinutes;

    protected override void OnParametersSet()
    {
        if (Value is { } minutes)
        {
            _shown = minutes;
        }
    }

    private Task ClearAsync()
    {
        _shown = DefaultMinutes;
        return SetAsync(null);
    }

    /// <summary>«1 ч 30 мин», «2 ч», «45 мин».</summary>
    public static string Format(int minutes) => (minutes / 60, minutes % 60) switch
    {
        (0, var m) => $"{m} мин",
        (var h, 0) => $"{h} ч",
        var (h, m) => $"{h} ч {m} мин",
    };

    private async Task SetAsync(int? minutes)
    {
        _shown = minutes ?? _shown;
        var value = minutes is > 0 ? minutes : null;
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
