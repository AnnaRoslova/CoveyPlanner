@* Примерная длительность: «− 30 мин +», шаг 15 минут; можно ввести число минут или крутить колесом.
   Пусто — «без». От часа справа подсказка «≈1,5 ч». *@

<Stepper Value="Value" ValueChanged="ValueChanged" Min="1" Max="MaxMinutes" Step="15" AllowEmpty="true"
         EmptyText="без" Unit="мин" Label="Длительность, минут" Hint="HintFor" />

@code {
    private const int MaxMinutes = 24 * 60;

    [Parameter]
    public int? Value { get; set; }

    [Parameter]
    public EventCallback<int?> ValueChanged { get; set; }

    private static string? HintFor(int? minutes) =>
        minutes is >= 60 ? "≈" + RuDates.Duration(minutes.Value) : null;
}
