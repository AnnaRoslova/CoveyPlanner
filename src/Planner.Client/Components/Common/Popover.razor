@* Всплывающее окошко у поля окна (роли, категория, повтор, барабан времени): стоит под кнопкой Anchor,
   закрывается кликом мимо и по Esc (js/popover.js) — Esc закрывает только окошко, не окно под ним.
   Arrows — стрелки ↑↓ переводят фокус между пунктами .option (список). Стили — css/editor.css. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_popup" class="popover @Class" tabindex="-1" role="@Role" aria-label="@Label" data-arrows="@(Arrows ? "" : null)"
     @onkeydown:stopPropagation="true">
    @ChildContent
</div>

@code {
    private ElementReference _popup;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Popover>? _self;
    private int _id;
    private bool _disposed;

    /// <summary>Кнопка, у которой окошко открывается (клик по ней — не «клик мимо»).</summary>
    [Parameter, EditorRequired]
    public ElementReference Anchor { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Клик мимо или Esc.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Role { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool Arrows { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/popover.js");
            _self = DotNetObjectReference.Create(this);
            _id = await _module.InvokeAsync<int>("open", _popup, Anchor, _self);
            if (_disposed)
            {
                await _module.InvokeVoidAsync("close", _id);
            }
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or ObjectDisposedException)
        {
            // Окошко уже закрыли или страница закрыта
        }
    }

    /// <summary>Вызывает js/dismiss.js: клик мимо или Esc.</summary>
    [JSInvokable]
    public Task Dismiss(bool byClick) => OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("close", _id);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Страница уже закрыта
            }
        }

        _self?.Dispose();
    }
}
