@* Простые линейные иконки (SVG, цвет — currentColor) *@

<svg class="icon" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @((MarkupString)Path)
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter]
    public int Size { get; set; } = 16;

    private string Path => Name switch
    {
        "chevron-left" => """<polyline points="15 6 9 12 15 18"/>""",
        "chevron-right" => """<polyline points="9 6 15 12 9 18"/>""",
        "chevron-down" => """<polyline points="6 9 12 15 18 9"/>""",
        "chevrons-left" => """<polyline points="11 17 6 12 11 7"/><polyline points="18 17 13 12 18 7"/>""",
        "chevrons-right" => """<polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/>""",
        "trash" => """<path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/>""",
        "search" => """<circle cx="11" cy="11" r="6"/><path d="M20 20l-4.5-4.5"/>""",
        "x" => """<path d="M6 6l12 12M18 6L6 18"/>""",
        "restore" => """<path d="M4 12a8 8 0 1 0 3-6.2"/><polyline points="4 4 4 9 9 9"/>""",
        "more" => """<circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/>""",
        "note" => """<path d="M6 3h9l4 4v14H6z"/><path d="M9 11h7M9 15h7M9 19h4"/>""",
        "fold" => """<polyline points="7 20 12 15 17 20"/><polyline points="7 4 12 9 17 4"/>""",
        "unfold" => """<polyline points="7 15 12 20 17 15"/><polyline points="7 9 12 4 17 9"/>""",
        "check" => """<polyline points="5 12.5 10 17 19 7"/>""",
        "palette" => """<path d="M12 3a9 9 0 1 0 0 18c1 0 1.6-.8 1.6-1.6 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.7-1.6 1.6-1.6H16a5 5 0 0 0 5-5c0-4-4-7.4-9-7.4z"/><circle cx="7.5" cy="11" r="1.2"/><circle cx="10.5" cy="7" r="1.2"/><circle cx="15" cy="7.5" r="1.2"/>""",
        _ => "",
    };
}
