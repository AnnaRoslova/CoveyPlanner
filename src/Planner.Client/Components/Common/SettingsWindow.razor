@* «⚙ Настройки» (docs/specs/batch-ux.md, BI5) — небольшое окно поверх недели: тема оформления (список с превью, сразу применяется),
   ссылка «Как это устроено». Срок «давно лежат» (BS2) и миссия (BM) — тоже здесь. Esc или клик мимо — закрыть. *@
@inject WindowHost Windows
@inject PlannerState State

<div class="editor-backdrop" @onclick="Windows.Close"></div>

<div @ref="_root" class="editor settings" role="dialog" aria-label="Настройки" tabindex="-1" @onkeydown="OnKeyDown">
    <div class="settings-h">
        <h2>⚙ Настройки</h2>
        <button type="button" class="close" title="Закрыть" aria-label="Закрыть" @onclick="Windows.Close"><Icon Name="x" Size="16" /></button>
    </div>

    <div class="field">
        <div class="label">Тема оформления</div>
        <ThemePicker Inline="true" />
    </div>

    @* BS2: срок «давно лежат» — 1 / 3 / 6 / 12 мес или своё (1–36); хранится на сервере *@
    <div class="field stale-term">
        <div class="label">Мысль «давно лежит» через</div>
        <div class="stale-row">
            <ChoiceField TValue="int" Items="TermChoices" Value="TermChoice" ValueChanged="SetTermAsync" Label="Срок" />
            @if (_custom || !Presets.Contains(State.StaleMonths))
            {
                <label class="custom-term"><input type="number" min="1" max="36" value="@State.StaleMonths" aria-label="Своё число месяцев"
                       @onchange="SetCustomAsync" /> мес</label>
            }
        </div>
        <div class="hint">Старше срока — розовая метка в ленте и одно напоминание.</div>
    </div>

    <div class="settings-links">
        <button type="button" class="btn small help-link" @onclick="Windows.OpenHelp"><Icon Name="help" Size="14" /> Как это устроено</button>
    </div>
</div>

@code {
    private static readonly int[] Presets = [1, 3, 6, 12];

    /// <summary>«своё…» в списке — 0.</summary>
    private const int Custom = 0;

    private static readonly IReadOnlyList<Choice<int>> TermChoices =
        [.. Presets.Select(m => new Choice<int>(m, $"{m} мес")), new(Custom, "своё…")];

    private ElementReference _root;
    private bool _custom;

    private int TermChoice => _custom || !Presets.Contains(State.StaleMonths) ? Custom : State.StaleMonths;

    private async Task SetTermAsync(int months)
    {
        _custom = months == Custom;
        if (!_custom)
        {
            await State.SetStaleMonthsAsync(months);
        }
    }

    private async Task SetCustomAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var months))
        {
            await State.SetStaleMonthsAsync(Math.Clamp(months, 1, 36));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _root.FocusAsync(); // Esc закрывает окно сразу
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Windows.Close();
        }
    }
}
