@* Встроенный редактор, который закрывается, как окно: кликом мимо и по Esc (js/dismiss.js).
   Своей рамки нет (display: contents) — раскладка содержимого не меняется. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_scope" class="dismiss-scope">@ChildContent</div>

@code {
    private ElementReference _scope;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Dismissable>? _self;
    private int _layerId;
    private bool _disposed;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Клик мимо или Esc.</summary>
    [Parameter]
    public EventCallback OnDismiss { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dismiss.js");
            _self = DotNetObjectReference.Create(this);
            _layerId = await _module.InvokeAsync<int>("register", _scope, _self);
            if (_disposed)
            {
                // Редактор закрыли, пока слой регистрировался
                await _module.InvokeVoidAsync("unregister", _layerId);
            }
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or ObjectDisposedException)
        {
            // Без JS редактор закрывается своими кнопками и Esc в поле; или страница/редактор уже закрыты
        }
    }

    [JSInvokable]
    public Task Dismiss() => OnDismiss.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregister", _layerId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Страница уже закрыта
            }
        }

        _self?.Dispose();
    }
}
