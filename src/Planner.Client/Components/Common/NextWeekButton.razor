@* «→ на след. неделю» в окнах дела и мысли (docs/specs/fixes-2026-10.md, B1–B3). Есть роль — сразу (дело встанет под ней на той неделе);
   нет роли — маленькое меню: «в роль: ● Работа», … и «в ленту» (у мысли его нет — она и так в ленте). Esc или клик мимо — меню закрывается,
   окно под ним остаётся. Стили меню — как у списков полей (css/editor.css). *@
@inject PlannerState State

<div class="field next-week-row">
    <button @ref="_button" type="button" class="btn next-week" disabled="@Disabled"
            title="@(Disabled ? "у занятия цели своя неделя — неделя цели" : "дело будет ждать на следующей неделе слева под ролью, день выберете потом")"
            aria-haspopup="@(HasRoles ? null : "menu")" aria-expanded="@(HasRoles ? null : _open ? "true" : "false")"
            @onclick="OnClickAsync">→ на след. неделю</button>
    @if (Disabled)
    {
        <span class="date-hint">у занятия цели своя неделя — неделя цели</span>
    }
</div>

@if (_open)
{
    <Popover Anchor="_button" OnClose="() => _open = false" Class="options next-week-menu" Role="menu" Label="На след. неделю" Arrows="true">
        @foreach (var role in State.OrderedRoles)
        {
            var id = role.Id;
            <button type="button" class="option" role="menuitem" @onclick="() => ChooseAsync(id)">
                <ChoiceMark Color="@role.Color" />
                <span class="option-name">в роль: @role.Name</span>
            </button>
        }
        @if (ShowFeed)
        {
            <button type="button" class="option to-feed" role="menuitem" @onclick="() => ChooseAsync(null, toFeed: true)">
                <span class="option-name">в ленту</span>
            </button>
        }
    </Popover>
}

@code {
    private ElementReference _button;
    private bool _open;

    /// <summary>Роли дела сейчас (в окне их могли поменять до нажатия).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyCollection<int> RoleIds { get; set; } = [];

    /// <summary>Пункт «в ленту» в меню (у мысли — нет).</summary>
    [Parameter]
    public bool ShowFeed { get; set; } = true;

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Выбрано: роль из меню (null — у дела есть свои роли) или «в ленту» (ToFeed).</summary>
    [Parameter]
    public EventCallback<NextWeekChoice> OnChoose { get; set; }

    private bool HasRoles => RoleIds.Count > 0;

    private async Task OnClickAsync()
    {
        if (HasRoles)
        {
            await OnChoose.InvokeAsync(new NextWeekChoice(null, false));
        }
        else
        {
            _open = !_open;
        }
    }

    private async Task ChooseAsync(int? roleId, bool toFeed = false)
    {
        _open = false;
        await OnChoose.InvokeAsync(new NextWeekChoice(roleId, toFeed));
    }

    /// <summary>Что выбрали в «→ на след. неделю»: роль меню (null — свои роли дела) или «в ленту».</summary>
    public sealed record NextWeekChoice(int? RoleId, bool ToFeed);
}
