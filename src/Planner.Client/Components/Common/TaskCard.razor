@* Карточка дела: в ленте, в «Приоритетах дня» и в сетке часов *@
@inject PlannerState State

@if (Variant == TaskCardVariant.Grid)
{
    @* В сетке: сверху время и отметки, ниже название — блок бывает очень узким и низким *@
    <div class="task-card variant-grid @(Compact ? "compact" : "") @(IsDone ? "done" : "")"
         style="--role-color: @(Role?.Color ?? "transparent")"
         data-drag="task" data-id="@Task.Id" title="@Tooltip">
        <div class="grid-meta">
            <span class="time">@(Task.StartTime is { } start ? RuDates.Time(start) : "")</span>
            @if (Compact)
            {
                <span class="title">@Task.Title</span>
            }
            @if (Task.Quadrant is { } quadrant)
            {
                <span class="quadrant">@Roman(quadrant)</span>
            }
            <span class="check @(IsDone ? "checked" : "")">
                @if (IsDone)
                {
                    <Icon Name="check" Size="10" />
                }
            </span>
        </div>
        @if (!Compact)
        {
            <div class="title">@Task.Title</div>
        }
    </div>
}
else
{
    <div class="task-card @VariantClass @(IsDone ? "done" : "")"
         style="--role-color: @(Role?.Color ?? "transparent")"
         data-drag="task" data-id="@Task.Id" title="@Tooltip">
        @if (Variant == TaskCardVariant.Priority)
        {
            <span class="check @(IsDone ? "checked" : "")">
                @if (IsDone)
                {
                    <Icon Name="check" Size="12" />
                }
            </span>
        }
        <span class="title">@Task.Title</span>
        @if (Task.Quadrant is { } quadrant)
        {
            <span class="quadrant" title="Квадрант @Roman(quadrant)">@Roman(quadrant)</span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public TaskDto Task { get; set; } = null!;

    [Parameter]
    public TaskCardVariant Variant { get; set; } = TaskCardVariant.Someday;

    /// <summary>Низкий блок в сетке: время и название в одну строку.</summary>
    [Parameter]
    public bool Compact { get; set; }

    private RoleDto? Role => State.FindRole(Task.RoleId);

    private bool IsDone => Task.State == TaskStateDto.Done;

    private string VariantClass => Variant == TaskCardVariant.Priority ? "variant-priority" : "variant-someday";

    private string Tooltip => Role is null ? Task.Title : $"{Task.Title} · {Role.Name}";

    private static string Roman(int quadrant) => quadrant switch
    {
        1 => "I",
        2 => "II",
        3 => "III",
        _ => "IV",
    };
}
