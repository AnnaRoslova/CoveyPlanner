@* Поле «Проект: [▾]» в окне дела (S6–S10): выбор родителя — открытые дела без родителя и не занятия целей (из ленты и показанной недели,
   с поиском), «— нет» — убрать из проекта. У дела со своими шагами поле неактивно: «у дела есть шаги — оно само проект» (S7, один уровень).
   Значение применяется по «Сохранить» окна. *@
@inject PlannerState State

<div class="field">
    <div class="project-row">
        <span class="label">Проект</span>
        @if (HasOwnSteps)
        {
            <span class="select-field off" title="Один уровень: проект не бывает шагом">у дела есть шаги — оно само проект</span>
        }
        else
        {
            <ChoiceField TValue="int" Items="Choices" Value="Value" ValueChanged="ValueChanged" Label="Проект" Searchable="true" />
        }
    </div>
</div>

@code {
    /// <summary>Дело, у которого выбирают проект.</summary>
    [Parameter, EditorRequired]
    public TaskDto Task { get; set; } = null!;

    /// <summary>Id проекта; 0 — без проекта.</summary>
    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    private bool HasOwnSteps => Task.Id > 0 && State.StepsOf(Task.Id).Count > 0;

    private IReadOnlyList<Choice<int>> Choices
    {
        get
        {
            var list = new List<Choice<int>> { new(0, "— нет") };
            if (Task.ParentId is { } current)
            {
                list.Add(new(current, State.ParentTitleOf(Task) ?? "проект"));
            }

            list.AddRange(State.ProjectCandidates().Where(t => t.Id != Task.Id).Select(t => new Choice<int>(t.Id, t.Title)));
            return list.DistinctBy(c => c.Value).ToList();
        }
    }
}
