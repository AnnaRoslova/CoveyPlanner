@* Карточка коллекции (книги, проекты, поездки): вместо банки — полка с корешками цвета копилки (по одному на запись,
   последние MaxSpines, остальное — «ещё N»), счёт за всё время, цель года «9 из 12 в 2026», разбивка по годам.
   Ниже — записи, свежие сверху: «название · дата»; у дела с шагами — «14 шагов · 5 недель», клик по строке раскрывает
   шаги (только просмотр), клик по названию — окно дела. Всё посчитано на сервере (CollectionStatsCalculator). *@
@inject PlannerState State
@inject WindowHost Windows

<article @ref="_card" class="jar-card collection @(Focused ? "focused" : "") @(Habit.IsArchived ? "archived" : "")" tabindex="-1"
         style="--c: @Habit.Color" data-habit="@Habit.Id" aria-label="Копилка «@Habit.Name»">
    <div class="jar-top">
        <div class="shelf-box" aria-hidden="true">
            <div class="spines">
                @foreach (var entry in Spines)
                {
                    <span class="spine" style="height: @SpineHeight(entry.TaskId)px; --shade: @SpineShade(entry.TaskId)%" title="@entry.Title"></span>
                }
                @if (Collection.Entries.Count == 0)
                {
                    <span class="spine-empty">пока пусто</span>
                }
            </div>
            <div class="plank"></div>
            @if (Collection.Entries.Count > MaxSpines)
            {
                <div class="more-spines">ещё @(Collection.Entries.Count - MaxSpines)</div>
            }
        </div>
        <div class="jar-info">
            <div class="jar-name"><span class="dot"></span>@if (Habit.Emoji is { } emoji) { <span class="emoji">@emoji</span> }<span class="name">@Habit.Name</span></div>
            <div class="total"><span class="total-n">@Collection.Total</span> <small>за всё время</small></div>
            <div class="year-goal">
                @if (Collection.YearGoal is { } goal)
                {
                    <span class="goal-text"><b>@Collection.ThisYear</b> из @goal в @Year@(Collection.ThisYear >= goal ? " ✓" : "")</span>
                    <span class="goal-bar" role="progressbar" aria-valuemin="0" aria-valuemax="@goal" aria-valuenow="@Collection.ThisYear">
                        <i style="width: @Percent(Collection.ThisYear, goal)%"></i>
                    </span>
                }
                else
                {
                    <span class="goal-text"><b>@Collection.ThisYear</b> в @Year</span>
                }
            </div>
            @if (Collection.Years.Count > 0)
            {
                <div class="years">@string.Join(" · ", Collection.Years.Select(y => $"{y.Year}: {y.Count}"))</div>
            }
            @if (LinkedCategories.Count > 0)
            {
                <div class="linked">из ленты: @string.Join(", ", LinkedCategories)</div>
            }
        </div>
    </div>

    @if (Collection.Entries.Count > 0)
    {
        <ul class="entries">
            @foreach (var entry in Shown)
            {
                var id = entry.TaskId;
                var open = _expanded.Contains(id);
                <li class="entry @(entry.StepCount > 0 ? "has-steps" : "")">
                    <div class="entry-row" @onclick="() => Toggle(entry)">
                        @if (entry.StepCount > 0)
                        {
                            <span class="chev @(open ? "open" : "")" aria-hidden="true"><Icon Name="chevron-right" Size="10" /></span>
                        }
                        <button type="button" class="entry-title" title="Открыть дело" @onclick="() => OpenTaskAsync(id)"
                                @onclick:stopPropagation="true">@entry.Title</button>
                        <span class="entry-date">@RuDates.DayMonthShort(entry.CompletedOn)@(entry.CompletedOn.Year != Year ? $" {entry.CompletedOn.Year}" : "")</span>
                    </div>
                    @if (entry.StepCount > 0)
                    {
                        <div class="entry-steps-info">@StepsText(entry)</div>
                    }
                    @if (open)
                    {
                        <div class="entry-steps"><StepsList TaskId="id" ReadOnly="true" /></div>
                    }
                </li>
            }
        </ul>
        @if (Collection.Entries.Count > MaxEntries)
        {
            <button type="button" class="all-entries" @onclick="() => _showAll = !_showAll">
                @(_showAll ? "свернуть" : $"показать все ({Collection.Entries.Count})")
            </button>
        }
    }
    else
    {
        <p class="empty-entries">Записей пока нет: отметьте выполненным дело@(LinkedCategories.Count > 0 ? " из привязанной категории" : ", привязанное к коллекции").</p>
    }

    <div class="card-actions">
        <button type="button" class="btn quiet" @onclick="OnEdit">настроить</button>
    </div>
</article>

@code {
    private const int MaxSpines = 20;
    private const int MaxEntries = 8;
    private ElementReference _card;
    private readonly HashSet<int> _expanded = [];
    private bool _showAll;

    [Parameter, EditorRequired]
    public HabitDto Habit { get; set; } = null!;

    [Parameter]
    public bool Focused { get; set; }

    [Parameter]
    public EventCallback OnEdit { get; set; }

    private CollectionStatsDto Collection =>
        Habit.Collection ?? new CollectionStatsDto(Habit.StartCount, 0, Habit.YearGoal, [], []);

    private static int Year => RuDates.Today.Year;

    /// <summary>Корешки — последние записи; на полке старые слева, свежие справа.</summary>
    private IEnumerable<CollectionEntryDto> Spines => Collection.Entries.Take(MaxSpines).Reverse();

    private IEnumerable<CollectionEntryDto> Shown => _showAll ? Collection.Entries : Collection.Entries.Take(MaxEntries);

    private List<string> LinkedCategories =>
        [.. (Habit.CategoryIds ?? []).Select(id => State.FindCategory(id)).OfType<CategoryDto>().Select(c => $"{c.Emoji} {c.Name}".Trim())];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Focused)
        {
            await _card.FocusAsync();
        }
    }

    private void Toggle(CollectionEntryDto entry)
    {
        if (entry.StepCount > 0 && !_expanded.Remove(entry.TaskId))
        {
            _expanded.Add(entry.TaskId);
        }
    }

    /// <summary>Окно дела (экран «Копилки» закрывается — окно дела рисуется на месте его).</summary>
    private async Task OpenTaskAsync(int taskId)
    {
        if (await State.ShowTaskAsync(taskId))
        {
            Windows.OpenTask(taskId);
        }
    }

    // Корешки разной высоты и оттенка — но у одной книги всегда одинаковые
    private static int SpineHeight(int taskId) => 34 + (int)((uint)(taskId * 2654435761) % 19);

    private static int SpineShade(int taskId) => (int)((uint)(taskId * 40503) % 4) * 8;

    private static int Percent(int value, int goal) => Math.Min(100, value * 100 / Math.Max(1, goal));

    /// <summary>«14 шагов · 5 недель», «3 шага · за 1 день», «4 шага».</summary>
    public static string StepsText(CollectionEntryDto entry)
    {
        var steps = $"{entry.StepCount} {Plural(entry.StepCount, "шаг", "шага", "шагов")}";
        return entry.SpanDays is { } days ? $"{steps} · {SpanText(days)}" : steps;
    }

    /// <summary>Длительность: «за 1 день», «6 дней», «5 недель», «3 месяца».</summary>
    public static string SpanText(int days) => days switch
    {
        1 => "за 1 день",
        < 14 => $"{days} {Plural(days, "день", "дня", "дней")}",
        < 60 => Weeks((int)Math.Round(days / 7.0)),
        _ => Months((int)Math.Round(days / 30.4)),
    };

    private static string Weeks(int n) => $"{n} {Plural(n, "неделя", "недели", "недель")}";

    private static string Months(int n) => $"{n} {Plural(n, "месяц", "месяца", "месяцев")}";

    private static string Plural(int n, string one, string few, string many) =>
        (n % 100 is >= 11 and <= 14) ? many
        : (n % 10) switch { 1 => one, >= 2 and <= 4 => few, _ => many };
}
