@* Окно копилки: название, иконка, цвет (палитра ролей), норма в неделю, сколько скрепок в банке, стартовое число;
   у существующей — «в архив» / «из архива» и «удалить» (с вопросом в окне). Открывается с экрана «Копилки»
   и из строки «🫙 В копилку» в окне цели или дела (Nested — поверх того окна). Enter в названии — сохранить, Esc — отмена.
   Стили — css/editor.css. *@
@inject PlannerState State

<div class="editor-backdrop @(Nested ? "nested" : "")" @onclick="OnClose"></div>

<div class="editor habit-editor @(Nested ? "nested" : "")" role="dialog" aria-label="Копилка"
     @onkeydown="OnKeyDown" @onkeydown:stopPropagation="true" @onclick:stopPropagation="true">
    <div class="habit-title-row">
        <button type="button" class="emoji-btn @(_emoji.Length == 0 ? "empty" : "")" title="Иконка копилки"
                aria-label="Иконка копилки" @onclick="() => _showEmojis = !_showEmojis">@(_emoji.Length == 0 ? "🫙" : _emoji)</button>
        <input @ref="_nameInput" class="title-input" maxlength="100" placeholder="Название копилки"
               @bind="_name" @bind:event="oninput" @onkeydown="OnNameKey" />
    </div>
    @if (_showEmojis)
    {
        <EmojiPicker Selected="@_emoji" OnPick="PickEmoji" />
    }

    <div class="rock-note">скрепка — выполненное дело, привязанное к копилке (через цель или напрямую)</div>

    <div class="field">
        <div class="label">Цвет</div>
        <ColorSwatches Selected="@_color" SelectedChanged="c => _color = c" />
    </div>

    <div class="row">
        <div class="field">
            <div class="label">Норма в неделю</div>
            <Stepper Value="_norm" ValueChanged="v => _norm = v ?? 1" Min="1" Max="50" Label="Норма в неделю" Unit="раз" />
        </div>
        <div class="field">
            <div class="label">В банке</div>
            <Stepper Value="_jarSize" ValueChanged="v => _jarSize = v ?? 30" Min="1" Max="1000" Step="5" Label="Скрепок в банке" Unit="скрепок" />
        </div>
    </div>

    <div class="field">
        <div class="label">Стартовое число</div>
        <Stepper Value="_startCount" ValueChanged="v => _startCount = v ?? 0" Min="0" Max="1000000" Label="Стартовое число" />
        <div class="date-hint">сколько скрепок уже было до копилки — идут только в общий счёт</div>
    </div>

    @if (_confirmDelete)
    {
        <div class="confirm-line">
            <span>Удалить копилку «@Habit!.Name»? Дела и цели останутся, а счёт пропадёт.</span>
            <button type="button" class="btn danger" @onclick="DeleteAsync">Удалить</button>
            <button type="button" class="btn quiet" @onclick="() => _confirmDelete = false">Отмена</button>
        </div>
    }
    else
    {
        <div class="buttons">
            @if (Habit is not null)
            {
                <button type="button" class="btn danger trash" @onclick="() => _confirmDelete = true">удалить</button>
                <button type="button" class="btn quiet" @onclick="ToggleArchiveAsync">@(Habit.IsArchived ? "из архива" : "в архив")</button>
            }
            <button type="button" class="btn quiet" @onclick="OnClose">Отмена</button>
            <button type="button" class="btn" disabled="@string.IsNullOrWhiteSpace(_name)" @onclick="SaveAsync">
                @(Habit is null ? "Создать" : "Сохранить")
            </button>
        </div>
    }
</div>

@code {
    private ElementReference _nameInput;
    private string _name = "";
    private string _emoji = "";
    private string? _color;
    private int _norm = 3;
    private int _jarSize = 30;
    private int _startCount;
    private bool _showEmojis;
    private bool _confirmDelete;

    /// <summary>Правка копилки; null — новая.</summary>
    [Parameter]
    public HabitDto? Habit { get; set; }

    /// <summary>Для новой: название (из цели или дела).</summary>
    [Parameter]
    public string? DefaultName { get; set; }

    /// <summary>Для новой: норма — «раз в неделю» цели.</summary>
    [Parameter]
    public int DefaultNorm { get; set; } = 3;

    /// <summary>Для новой: цвет (например, первой роли цели); null — следующий цвет палитры.</summary>
    [Parameter]
    public string? DefaultColor { get; set; }

    /// <summary>Окно поверх другого окна (цели, дела).</summary>
    [Parameter]
    public bool Nested { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Копилку сохранили (новую — уже с Id).</summary>
    [Parameter]
    public EventCallback<HabitDto> OnSaved { get; set; }

    protected override void OnInitialized()
    {
        if (Habit is { } habit)
        {
            _name = habit.Name;
            _emoji = habit.Emoji ?? "";
            _color = habit.Color;
            _norm = habit.WeeklyNorm;
            _jarSize = habit.JarSize;
            _startCount = habit.StartCount;
        }
        else
        {
            _name = DefaultName?.Trim() ?? "";
            _norm = Math.Clamp(DefaultNorm, 1, 50);
            _color = DefaultColor ?? (State.RolePalette.Count > 0 ? State.RolePalette[State.Habits.Count % State.RolePalette.Count] : null);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _nameInput.FocusAsync();
        }
    }

    private void PickEmoji(string emoji)
    {
        _emoji = emoji;
        _showEmojis = false;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task OnNameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveAsync();
        }
    }

    private SaveHabitRequest Form(bool? archived = null) =>
        new(_name.Trim(), _emoji.Length == 0 ? null : _emoji, _color, _norm, _jarSize, _startCount, archived);

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            return;
        }

        if (Habit is { } habit)
        {
            await OnClose.InvokeAsync();
            await State.UpdateHabitAsync(habit.Id, Form());
        }
        else if (await State.CreateHabitAsync(Form()) is { } created)
        {
            await OnSaved.InvokeAsync(created);
            await OnClose.InvokeAsync();
        }
    }

    private async Task ToggleArchiveAsync()
    {
        var habit = Habit!;
        await OnClose.InvokeAsync();
        await State.UpdateHabitAsync(habit.Id, Form(archived: !habit.IsArchived));
    }

    private async Task DeleteAsync()
    {
        var habitId = Habit!.Id;
        await OnClose.InvokeAsync();
        await State.DeleteHabitAsync(habitId);
    }
}
