@* Карточка копилки (docs/habits-mockup.html): банка с уровнем, общий счёт, полка полных банок, 🔥 серия недель (⚠ пауза),
   🌙 серия месяцев, точки «эта неделя N из нормы» (сверх нормы — розовые), 26 последних недель квадратиками, полоса месяцев,
   среднее за неделю, за месяц и год, подсказки «не пропускай дважды» и про каникулы; «+1 сегодня» и «настроить».
   Всё посчитано на сервере (HabitStatsCalculator). *@
@using System.Globalization

<article @ref="_card" class="jar-card @(Focused ? "focused" : "") @(Habit.IsArchived ? "archived" : "")" tabindex="-1"
         style="--c: @Habit.Color" data-habit="@Habit.Id" aria-label="Копилка «@Habit.Name»">
    <div class="jar-top">
        <JarPicture Fill="@((double)Stats.InJar / Habit.JarSize)" Color="@Habit.Color" />
        <div class="jar-info">
            <div class="jar-name"><span class="dot"></span>@if (Habit.Emoji is { } emoji) { <span class="emoji">@emoji</span> }<span class="name">@Habit.Name</span></div>
            <div class="total"><span class="total-n">@Stats.Total</span> <small>@ClipsWord(Stats.Total) за всё время</small></div>
            <div class="shelf">
                @if (Stats.FullJars > 0)
                {
                    <span class="shelf-jars" aria-hidden="true">@string.Concat(Enumerable.Repeat("🫙", Math.Min(Stats.FullJars, MaxShelf)))@(Stats.FullJars > MaxShelf ? "…" : "")</span>
                }
                @Stats.FullJars @FullWord(Stats.FullJars) · в текущей @Stats.InJar из @Habit.JarSize
            </div>
            <div class="stats">
                @if (Stats.WeekPaused)
                {
                    <span class="chip warn" title="первый пропуск: серия жива, но не растёт">⚠ пауза · 🔥 @Stats.WeekStreak нед.</span>
                }
                else
                {
                    <span class="chip accent" title="засчитанных недель подряд (текущая — после воскресенья)">🔥 @Stats.WeekStreak нед. подряд</span>
                }
                <span class="chip @(Stats.MonthPaused ? "warn" : "")" title="месяцев подряд без двух пропусков недели подряд">
                    @(Stats.MonthPaused ? "⚠ " : "")🌙 @Stats.MonthStreak мес. подряд
                </span>
            </div>
        </div>
    </div>

    <div class="week-now">
        <b>Эта неделя</b>
        @if (Habit.WeeklyNorm <= MaxPips)
        {
            <span class="pips" aria-hidden="true">
                @for (var i = 0; i < Habit.WeeklyNorm; i++)
                {
                    <span class="pip @(i < Stats.ThisWeek ? "on" : "")"></span>
                }
                @for (var i = 0; i < Math.Min(Extra, MaxPips); i++)
                {
                    <span class="pip extra"></span>
                }
            </span>
        }
        <span class="of">@Stats.ThisWeek из @Habit.WeeklyNorm@(Stats.ThisWeek >= Habit.WeeklyNorm ? " ✓" : "")</span>
    </div>

    <div class="strip-label"><span>последние @Stats.Weeks.Count недель</span><span>сейчас →</span></div>
    <div class="weeks">
        @foreach (var week in Stats.Weeks)
        {
            <span class="w @Css(week.Result)" title="@WeekTitle(week)"></span>
        }
    </div>
    <div class="months">
        @foreach (var month in Stats.Months)
        {
            <span class="m @Css(month.Result)" title="@MonthTitle(month)">@RuDates.MonthShort(month.Month)</span>
        }
    </div>

    <div class="stats totals">
        <span class="chip grey">в среднем @Average/нед</span>
        <span class="chip grey">месяц: @Stats.ThisMonth</span>
        <span class="chip grey">год: @Stats.ThisYear</span>
    </div>

    @if (Stats.WeekPaused)
    {
        var left = Habit.WeeklyNorm - Stats.ThisWeek;
        <div class="hint warn">
            @if (left > 0)
            {
                <text>⚠ Прошлая неделя не засчитана. Не пропускай дважды: ещё @left до конца воскресенья — и серия продолжится.</text>
            }
            else
            {
                <text>⚠ Прошлая неделя не засчитана, но на этой норма уже есть ✓ — серия продолжится.</text>
            }
        </div>
    }
    @if (Stats.VacationUntil is { } until)
    {
        <div class="hint vac">🏖 Каникулы до @RuDates.DayMonthShort(until): серия замирает, но не прерывается.</div>
    }
    else if (Stats.Months.LastOrDefault(m => m.Result == PeriodResultDto.Vacation) is { } vacationMonth)
    {
        <div class="hint vac">🏖 @Capitalize(RuDates.Month(vacationMonth.Month)) — каникулы: серия замирала, но не прерывалась.</div>
    }

    <div class="card-actions">
        @if (!Habit.IsArchived)
        {
            <button type="button" class="btn pink plus-one" @onclick="OnPlusOne">+1 сегодня</button>
        }
        <button type="button" class="btn quiet" @onclick="OnEdit">настроить</button>
    </div>
</article>

@code {
    private const int MaxShelf = 12;
    private const int MaxPips = 14;
    private ElementReference _card;

    [Parameter, EditorRequired]
    public HabitDto Habit { get; set; } = null!;

    /// <summary>Открыли экран кликом по пилюле этой копилки: карточка прокручивается в вид и подсвечивается.</summary>
    [Parameter]
    public bool Focused { get; set; }

    [Parameter]
    public EventCallback OnPlusOne { get; set; }

    [Parameter]
    public EventCallback OnEdit { get; set; }

    private HabitStatsDto Stats => Habit.Stats;

    private int Extra => Math.Max(0, Stats.ThisWeek - Habit.WeeklyNorm);

    private string Average => Stats.AveragePerWeek.ToString("0.#", CultureInfo.InvariantCulture).Replace('.', ',');

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Focused)
        {
            await _card.FocusAsync(); // фокус прокручивает карточку в вид
        }
    }

    public static string Css(PeriodResultDto result) => result switch
    {
        PeriodResultDto.BeforeStart => "before",
        PeriodResultDto.Done => "done",
        PeriodResultDto.Neutral => "neutral",
        PeriodResultDto.Paused => "warn",
        PeriodResultDto.Missed => "miss",
        PeriodResultDto.Vacation => "vac",
        PeriodResultDto.Current => "now",
        _ => "",
    };

    private static string ResultText(PeriodResultDto result) => result switch
    {
        PeriodResultDto.BeforeStart => "до копилки",
        PeriodResultDto.Done => "засчитана",
        PeriodResultDto.Neutral => "первая неделя — не пропуск",
        PeriodResultDto.Paused => "первый пропуск (пауза)",
        PeriodResultDto.Missed => "пропуск — серия прервана",
        PeriodResultDto.Vacation => "каникулы",
        PeriodResultDto.Current => "в процессе",
        _ => "",
    };

    private string WeekTitle(HabitWeekDto week) =>
        $"{RuDates.DayMonthShort(week.WeekStart)}: {week.Count} из {Habit.WeeklyNorm} — {ResultText(week.Result)}";

    private static string MonthTitle(HabitMonthDto month) => $"{Capitalize(RuDates.Month(month.Month))}: " + month.Result switch
    {
        PeriodResultDto.Done => "засчитан",
        PeriodResultDto.Paused => "не засчитан (первый раз)",
        PeriodResultDto.Missed => "не засчитан — серия месяцев прервана",
        PeriodResultDto.Vacation => "каникулы",
        PeriodResultDto.Current => "в процессе",
        PeriodResultDto.Neutral => "неполный, не пропуск",
        _ => "до копилки",
    };

    private static string Capitalize(string text) => text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..];

    /// <summary>«1 скрепка», «3 скрепки», «5 скрепок».</summary>
    public static string ClipsWord(int n) => Plural(n, "скрепка", "скрепки", "скрепок");

    private static string FullWord(int n) => Plural(n, "полная", "полных", "полных");

    private static string Plural(int n, string one, string few, string many) =>
        (n % 100 is >= 11 and <= 14) ? many
        : (n % 10) switch { 1 => one, >= 2 and <= 4 => few, _ => many };
}
