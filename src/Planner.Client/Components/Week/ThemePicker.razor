@* Переключатель темы оформления — кнопка-палитра в правом верхнем углу шапки недели.
   Открывает сетку карточек: мини-превью из четырёх цветов темы и короткое имя; выбранная — с галочкой
   и обводкой. Закрывается выбором, кликом мимо и Esc. Цвета превью берутся из самой темы
   (атрибут data-theme на картинке); шрифты тем в превью не используются. *@
@implements IDisposable
@inject ThemeState Theme

<div class="picker @(Inline ? "inline" : "")">
    @if (!Inline)
    {
    <button type="button" class="icon-b palette-b" title="Тема оформления" aria-haspopup="listbox"
            aria-expanded="@(_open ? "true" : "false")" @onclick="Toggle">
        <Icon Name="palette" Size="16" />
    </button>
    }

    @if (_open || Inline)
    {
        @if (!Inline)
        {
            <div class="picker-backdrop" @onclick="Close"></div>
        }
        <div @ref="_list" class="themes @(Inline ? "inline" : "")" role="listbox" aria-label="Тема оформления" tabindex="-1" @onkeydown="OnKeyDown">
            @foreach (var theme in ThemeState.Themes)
            {
                var key = theme.Key;
                var on = key == Theme.Current;
                <button type="button" class="theme @(on ? "on" : "")" role="option" aria-selected="@(on ? "true" : "false")"
                        data-key="@key" @onclick="() => ChooseAsync(key)">
                    <span class="swatches" data-theme="@key" aria-hidden="true">
                        <i class="sw page"></i><i class="sw paper"></i><i class="sw main"></i><i class="sw accent"></i>
                    </span>
                    <span class="t-name">@theme.Name</span>
                    @if (on)
                    {
                        <span class="check" aria-hidden="true"><Icon Name="check" Size="11" /></span>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    private bool _open;

    /// <summary>Список тем прямо на месте, без кнопки (окно «⚙ Настройки», batch-ux.md BI5).</summary>
    [Parameter]
    public bool Inline { get; set; }
    private bool _focusList;
    private ElementReference _list;

    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    public void Dispose() => Theme.Changed -= OnThemeChanged;

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void Toggle()
    {
        _open = !_open;
        _focusList = _open;
    }

    private void Close() => _open = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Фокус в список — чтобы Esc закрывал его сразу, без клика внутрь
        if (_focusList)
        {
            _focusList = false;
            await _list.FocusAsync();
        }
    }

    private async Task ChooseAsync(string key)
    {
        _open = false;
        await Theme.SetAsync(key);
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _open = false;
        }
    }
}
