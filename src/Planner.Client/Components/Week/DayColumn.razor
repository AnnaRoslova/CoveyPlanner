@* День — страница «в точку»: сначала дела со временем, затем без времени.
   Клик по делу — окно редактирования, по чекбоксу — «выполнено».
   🗑 справа при наведении (на касании — после свайпа влево) — в корзину сразу, с плашкой «Вернуть».
   Новое дело (docs/specs/polish-2.md, A): клик по пустому месту под последним делом или «+» у названия дня (при наведении,
   на касании — всегда) — строка «Новое дело…»; Enter — добавить и оставить строку, Esc или клик мимо — закрыть.
   Клик по дню выделяет его — туда клавиша D. Пустое место — data-press: долгое или «дёрнувшееся» нажатие — не клик (dnd.js).
   «щёлкни, чтобы записать» (polish-3.md, H) — при наведении на пустое место, пока не добавлено три дела кликом по нему; на касании — один раз. *@
@inject PlannerState State
@inject ProjectFoldState Folds
@inject WindowHost Windows
@inject DayHintState Hint
@implements IDisposable

<section class="day @(IsToday ? "today" : "") @(RuDates.IsWeekend(Date) ? "weekend" : "") @(Tasks.Count == 0 ? "empty" : "") @(State.PickedDay == Date ? "picked" : "")"
         data-drop="@DragDropService.DayZone" data-key="@Css.Date(Date)"
         data-accept="@DragDropService.DayAccepts" data-fixed-sort @onclick="() => State.PickDay(Date)">
    <div class="day-h" data-list-head>
        <span class="dow">@RuDates.ShortDay(Date)</span>
        <span class="num">@Date.Day</span>
        @if (!_adding)
        {
            <button type="button" class="day-plus" title="Новое дело в этот день (D)" aria-label="Новое дело в этот день" @onclick="() => StartAddingAsync(byBlank: false)">+</button>
        }
        @if (TotalMinutes > 0)
        {
            <span class="load" title="Сумма длительностей дел дня">~@RuDates.Duration(TotalMinutes)</span>
        }
        @if (IsToday)
        {
            <span class="tag">сегодня</span>
        }
    </div>

    @foreach (var task in Tasks)
    {
        var roles = State.RolesOf(task);
        // Чьи шаги у строки: у занятия цели — проекта цели (G4), у дела без родителя — свои
        var host = task.Id > 0 ? State.StepsHostOf(task) : null;
        var goal = task.GoalId is { } goalId ? State.FindGoal(goalId) : null;
        var project = host is { } hostId ? State.ProjectOf(hostId) : null;
        var expanded = project is not null && Folds.IsOpen(task.Id); // раскрытие — свойство строки (R1)
        var isStep = task.ParentId is not null;
        var stepOfOwnGoal = goal?.ProjectId is { } goalProject && task.ParentId == goalProject;
        // N2: середина строки дела — сделать брошенное его шагом (не у шагов, занятий целей и выполненных)
        var takesSteps = task.Id > 0 && !isStep && task.GoalId is null && !PlannerState.IsClosed(task);
        <ItemRow @key="task.Id" Title="@task.Title" Clamp="true"
                 Color="@roles.FirstOrDefault()?.Color"
                 RoleDots="@(roles.Count > 1 ? roles : null)"
                 IsDone="task.State == TaskStateDto.Done"
                 Skip="@task.SkipKind" SkipReason="@task.SkipReason"
                 OnSkip="@SkipHandler(task)"
                 TimeLabel="@(task.StartTime is { } time ? RuDates.Time(time) : null)"
                 DurationLabel="@(task.DurationMinutes is { } minutes ? "~" + RuDates.Duration(minutes) : null)"
                 IsRock="State.IsRock(task.Id)" RockTitle="@(goal is null ? null : $"занятие цели «{goal.Title}»")"
                 Notes="@task.Notes"
                 IsPending="task.Id < 0"
                 IsFlashing="State.FlashTaskId == task.Id"
                 Expanded="@(project is null ? null : expanded)"
                 OnExpand="() => Folds.ToggleAsync(task.Id)"
                 ProjectLabel="@PlannerState.ProjectLabel(project)"
                 IsProject="task.IsProject"
                 StepsProgress="@PlannerState.ProgressOf(project)"
                 ParentCaption="@(stepOfOwnGoal ? null : State.ParentTitleOf(task))"
                 OnParentClick="() => OpenParentAsync(task.ParentId)"
                 DropZone="@(takesSteps ? DragDropService.TaskZone : project is null ? null : DragDropService.ProjectZone)"
                 DropKey="@((takesSteps ? task.Id : host ?? task.Id).ToString())"
                 DropAccept="@(takesSteps ? DragDropService.TaskAccepts : DragDropService.StepsAccepts)"
                 DropHint="@(takesSteps ? $"сделать шагом «{task.Title}»" : "снять с дня — в список шагов")"
                 DropHintOwn="снять с дня — в список шагов"
                 DragParent="task.ParentId"
                 NoStep="@(task.IsProject || (project is not null && host == task.Id))"
                 OnToggle="() => State.SetDoneAsync(task.Id, task.State != TaskStateDto.Done)"
                 OnClick="() => task.Id > 0 ? OnEdit.InvokeAsync(task.Id) : Task.CompletedTask"
                 OnTrash="() => task.Id > 0 ? State.TrashTaskAsync(task.Id) : Task.CompletedTask"
                 DragKind="@(task.Id > 0 ? isStep ? DragDropService.StepItem : DragDropService.DayItem : null)"
                 DragFixed="task.StartTime is not null || PlannerState.IsClosed(task)"
                 DragId="task.Id" />
        @if (expanded)
        {
            <ProjectSteps @key="@($"steps-{task.Id}")" ParentId="host!.Value" GoalId="goal?.Id" ViaSessionId="@(goal is null ? null : task.Id)" />
        }
    }

    @if (_adding)
    {
        @* Пустое место — внутри слоя: клик по нему не «мимо», а снова в строку *@
        <Dismissable OnDismiss="StopAdding" OnClickOutside="SaveAndCloseAsync">
            <InlineInput @ref="_input" @bind-Value="_newTitle" Placeholder="Новое дело…" MaxLength="500"
                         OnSubmit="AddAsync" OnCancel="StopAdding" CancelOnEmptyBlur="false" />
            <div class="day-blank" data-press @onclick="() => StartAddingAsync(byBlank: true)"></div>
        </Dismissable>
    }
    else
    {
        <div class="day-blank" data-press @onclick="() => StartAddingAsync(byBlank: true)">
            @if (Hint.ShowOnceForTouch && Tasks.Count == 0)
            {
                <span class="blank-hint once">щёлкни, чтобы записать</span>
            }
            else if (Hint.ShowOnHover)
            {
                <span class="blank-hint">щёлкни, чтобы записать</span>
            }
        </div>
    }
</section>

@code {
    private bool _adding;
    private bool _addingByBlank; // строку открыли кликом по пустому месту — её дела считаются для подсказки (H2)
    private InlineInput? _input;
    private string _newTitle = "";

    [Parameter, EditorRequired]
    public DateOnly Date { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<TaskDto> Tasks { get; set; } = [];

    /// <summary>Открыть окно редактирования дела (Id).</summary>
    [Parameter]
    public EventCallback<int> OnEdit { get; set; }

    private bool IsToday => Date == RuDates.Today;

    protected override void OnInitialized()
    {
        Folds.Changed += OnFoldsChanged;
        Hint.Changed += OnFoldsChanged;
    }

    public void Dispose()
    {
        Folds.Changed -= OnFoldsChanged;
        Hint.Changed -= OnFoldsChanged;
    }

    private void OnFoldsChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Клик по «↳ Ремонт» — окно проекта (проект на другой неделе сначала подгружается).</summary>
    private async Task OpenParentAsync(int? parentId)
    {
        if (parentId is not { } id || !await State.EnsureTaskAsync(id))
        {
            return;
        }

        if (State.FindTask(id) is { State: TaskStateDto.Someday })
        {
            Windows.OpenSomedayTask(id);
        }
        else
        {
            Windows.OpenTask(id);
        }
    }

    /// <summary>Сумма длительностей дел дня (у кого указана) — «~3 ч» в заголовке.</summary>
    private int TotalMinutes => Tasks.Where(t => t.State != TaskStateDto.Skipped).Sum(t => t.DurationMinutes ?? 0); // пропущенные — не нагрузка (V2)

    /// <summary>✕ у дела — только у того, что можно пропустить (K3).</summary>
    private EventCallback SkipHandler(TaskDto task) =>
        PlannerState.CanSkip(task) ? EventCallback.Factory.Create(this, () => ToggleSkipAsync(task)) : default;

    /// <summary>✕ у дела: открыть окошко пропуска; у пропущенного — отменить пропуск (skips.md, A1).</summary>
    private Task ToggleSkipAsync(TaskDto task)
    {
        if (task.State == TaskStateDto.Skipped)
        {
            return State.UnskipTaskAsync(task.Id);
        }

        Windows.OpenSkip(task.Id);
        return Task.CompletedTask;
    }

    /// <summary>Пустое место дня или «+» (и клавиша D): открыть строку «Новое дело…» (открыта — фокус в неё).</summary>
    private async Task StartAddingAsync(bool byBlank)
    {
        if (_adding && _input is not null)
        {
            await _input.FocusAsync();
            return;
        }

        _adding = true;
        _addingByBlank = byBlank;
    }

    private async Task AddAsync(string title)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            return;
        }

        _newTitle = "";
        var counts = _addingByBlank;
        await State.CreateDayTaskAsync(title, Date);
        if (counts)
        {
            await Hint.CountAddAsync();
        }
    }

    /// <summary>Клик мимо: набранный текст сохраняется, пустое поле просто закрывается (Esc — отмена).</summary>
    private async Task SaveAndCloseAsync()
    {
        var title = _newTitle;
        StopAdding();
        await AddAsync(title);
    }

    private void StopAdding()
    {
        _adding = false;
        _newTitle = "";
    }
}
