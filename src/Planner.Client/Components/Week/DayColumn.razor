@* День — страница «в точку»: сначала дела со временем, затем без времени.
   Клик по делу — окно редактирования, по чекбоксу — «выполнено», «+ дело» — новое дело в конец.
   🗑 справа при наведении (на касании — после свайпа влево) — в корзину сразу, с плашкой «Вернуть». *@
@inject PlannerState State
@inject ProjectFoldState Folds
@inject WindowHost Windows
@implements IDisposable

<section class="day @(IsToday ? "today" : "") @(RuDates.IsWeekend(Date) ? "weekend" : "")"
         data-drop="@DragDropService.DayZone" data-key="@Css.Date(Date)"
         data-accept="@DragDropService.DayAccepts" data-fixed-sort>
    <div class="day-h" data-list-head>
        <span class="dow">@RuDates.ShortDay(Date)</span>
        <span class="num">@Date.Day</span>
        @if (TotalMinutes > 0)
        {
            <span class="load" title="Сумма длительностей дел дня">~@RuDates.Duration(TotalMinutes)</span>
        }
        @if (IsToday)
        {
            <span class="tag">сегодня</span>
        }
    </div>

    @foreach (var task in Tasks)
    {
        var roles = State.RolesOf(task);
        // Чьи шаги у строки: у занятия цели — проекта цели (G4), у дела без родителя — свои
        var host = task.Id > 0 ? State.StepsHostOf(task) : null;
        var goal = task.GoalId is { } goalId ? State.FindGoal(goalId) : null;
        var project = host is { } hostId ? State.ProjectOf(hostId) : null;
        var expanded = project is not null && Folds.IsOpen(host!.Value);
        var isStep = task.ParentId is not null;
        var stepOfOwnGoal = goal?.ProjectId is { } goalProject && task.ParentId == goalProject;
        <ItemRow @key="task.Id" Title="@task.Title" Clamp="true"
                 Color="@roles.FirstOrDefault()?.Color"
                 RoleDots="@(roles.Count > 1 ? roles : null)"
                 IsDone="task.State == TaskStateDto.Done"
                 TimeLabel="@(task.StartTime is { } time ? RuDates.Time(time) : null)"
                 DurationLabel="@(task.DurationMinutes is { } minutes ? "~" + RuDates.Duration(minutes) : null)"
                 IsRock="State.IsRock(task.Id)"
                 Notes="@task.Notes"
                 IsPending="task.Id < 0"
                 IsFlashing="State.FlashTaskId == task.Id"
                 Expanded="@(project is null ? null : expanded)"
                 OnExpand="() => Folds.ToggleAsync(host ?? task.Id)"
                 ProjectLabel="@PlannerState.ProjectLabel(project)"
                 ParentCaption="@(stepOfOwnGoal ? null : State.ParentTitleOf(task))"
                 OnParentClick="() => OpenParentAsync(task.ParentId)"
                 DropZone="@(project is null ? null : DragDropService.ProjectZone)"
                 DropKey="@((host ?? task.Id).ToString())"
                 DropAccept="@DragDropService.StepsAccepts"
                 DropHint="снять с дня — в список шагов"
                 OnToggle="() => State.SetDoneAsync(task.Id, task.State != TaskStateDto.Done)"
                 OnClick="() => task.Id > 0 ? OnEdit.InvokeAsync(task.Id) : Task.CompletedTask"
                 OnTrash="() => task.Id > 0 ? State.TrashTaskAsync(task.Id) : Task.CompletedTask"
                 DragKind="@(task.Id > 0 ? isStep ? DragDropService.StepItem : DragDropService.DayItem : null)"
                 DragFixed="task.StartTime is not null"
                 DragId="task.Id" />
        @if (expanded)
        {
            <ProjectSteps @key="@($"steps-{task.Id}")" ParentId="host!.Value" GoalId="goal?.Id" />
        }
    }

    @if (_adding)
    {
        <Dismissable OnDismiss="StopAdding" OnClickOutside="SaveAndCloseAsync">
            <InlineInput @bind-Value="_newTitle" Placeholder="Новое дело — Enter" MaxLength="500"
                         OnSubmit="AddAsync" OnCancel="StopAdding" CancelOnEmptyBlur="false" />
        </Dismissable>
    }
    else
    {
        <button class="add" @onclick="() => _adding = true">+ дело</button>
    }
</section>

@code {
    private bool _adding;
    private string _newTitle = "";

    [Parameter, EditorRequired]
    public DateOnly Date { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<TaskDto> Tasks { get; set; } = [];

    /// <summary>Открыть окно редактирования дела (Id).</summary>
    [Parameter]
    public EventCallback<int> OnEdit { get; set; }

    private bool IsToday => Date == RuDates.Today;

    protected override void OnInitialized() => Folds.Changed += OnFoldsChanged;

    public void Dispose() => Folds.Changed -= OnFoldsChanged;

    private void OnFoldsChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Клик по «↳ Ремонт» — окно проекта (проект на другой неделе сначала подгружается).</summary>
    private async Task OpenParentAsync(int? parentId)
    {
        if (parentId is not { } id || !await State.EnsureTaskAsync(id))
        {
            return;
        }

        if (State.FindTask(id) is { State: TaskStateDto.Someday })
        {
            Windows.OpenSomedayTask(id);
        }
        else
        {
            Windows.OpenTask(id);
        }
    }

    /// <summary>Сумма длительностей дел дня (у кого указана) — «~3 ч» в заголовке.</summary>
    private int TotalMinutes => Tasks.Sum(t => t.DurationMinutes ?? 0);

    private async Task AddAsync(string title)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            return;
        }

        _newTitle = "";
        await State.CreateDayTaskAsync(title, Date);
    }

    /// <summary>Клик мимо: набранный текст сохраняется, пустое поле просто закрывается (Esc — отмена).</summary>
    private async Task SaveAndCloseAsync()
    {
        var title = _newTitle;
        StopAdding();
        await AddAsync(title);
    }

    private void StopAdding()
    {
        _adding = false;
        _newTitle = "";
    }
}
