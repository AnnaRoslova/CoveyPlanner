@* Мини-календарь «перейти к дате» (docs/specs/batch-3.md, J): окошко под подписью недели (клик по ней или G).
   Сетка — сплошная лента недель (polish-3.md, C): колесо мыши и свайп листают её месяц за месяцем, подпись — месяц в середине окошка
   (js/jumpstrip.js сообщает его в OnMiddleWeek), дни других месяцев бледнее; лента дорастает по полгода у края. «‹ ›» — к соседнему месяцу.
   Наведение подсвечивает всю неделю, клик по дню — переход на его неделю. Поле вверху понимает «12.03», «12 марта», «март 2027» (DateQuery) — Enter.
   Стрелки двигают выбранный день, Enter без текста — его неделя. Esc и клик мимо закрывают только календарь (Popover).
   Только чтение: точки дней — GET /api/calendar (J7). *@
@using System.Globalization
@inject PlannerState State
@inject PlannerApi Api
@inject IJSRuntime JS
@implements IAsyncDisposable

<Popover Anchor="Anchor" OnClose="OnClose" Class="week-jump" Role="dialog" Label="Перейти к дате">
    <div class="jump" @onkeydown="OnKeyDown">
        <input class="jump-input" type="text" tabindex="0" placeholder="12.03, 12 марта, март 2027" aria-label="Дата"
               value="@_text" @oninput="OnInput" />
        <p class="jump-hint @(_typed is null && _text.Trim().Length > 0 ? "unknown" : "")" aria-live="polite">@Hint</p>

        <div class="jump-head">
            <button type="button" class="nav" title="Предыдущий месяц" aria-label="Предыдущий месяц" @onclick="() => ShowMonthAsync(_month.AddMonths(-1), smooth: true)">
                <Icon Name="chevron-left" />
            </button>
            <span class="jump-month">@RuDates.Month(_month) @_month.Year</span>
            <button type="button" class="nav" title="Следующий месяц" aria-label="Следующий месяц" @onclick="() => ShowMonthAsync(_month.AddMonths(1), smooth: true)">
                <Icon Name="chevron-right" />
            </button>
            <button type="button" class="btn small jump-today" @onclick="GoTodayAsync">Сегодня</button>
        </div>

        <div class="jump-grid" role="grid" aria-label="@($"{RuDates.Month(_month)} {_month.Year}")">
            <div class="jump-dows" role="row">
                @foreach (var name in DayNames)
                {
                    <span role="columnheader">@name</span>
                }
            </div>
            <div @ref="_strip" class="jump-strip">
                @for (var week = StripStart; week <= StripEnd; week = week.AddDays(7))
                {
                    var monday = week;
                    <div @key="monday" class="jump-week @(monday == State.WeekStart ? "shown" : "") @(monday == RuDates.WeekStartOf(_selected) ? "picked" : "")"
                         role="row" data-week="@Css.Date(monday)">
                        @for (var i = 0; i < 7; i++)
                        {
                            var day = monday.AddDays(i);
                            <button type="button" role="gridcell" tabindex="-1"
                                    class="jump-day @(MonthOf(day) != _month ? "out" : "") @(day == RuDates.Today ? "today" : "") @(day == _selected ? "sel" : "")"
                                    title="@DayTitle(day)"
                                    data-date="@Css.Date(day)"
                                    @onclick="() => GoAsync(day)">
                                <span class="num">@day.Day</span>
                                @if (_busy.Contains(day))
                                {
                                    <span class="busy" aria-label="есть дела"></span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</Popover>

@code {
    /// <summary>На сколько месяцев лента дорастает за раз (C5).</summary>
    private const int ChunkMonths = 6;

    private static readonly string[] DayNames = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];

    /// <summary>Подпись недели в шапке — окошко стоит под ней.</summary>
    [Parameter, EditorRequired]
    public ElementReference Anchor { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string _text = "";
    private DateQueryResult? _typed;
    private DateOnly _month; // подпись: месяц в середине окошка
    private DateOnly _selected;
    private DateOnly _firstMonth; // лента — от первой недели _firstMonth до последней недели _lastMonth
    private DateOnly _lastMonth;
    private readonly HashSet<DateOnly> _busy = [];

    private ElementReference _strip;
    private IJSObjectReference? _module;
    private DotNetObjectReference<WeekJump>? _self;
    private int _stripId;
    private bool _disposed;

    // Что сделать с прокруткой после перерисовки
    private DateOnly? _scrollTo;
    private bool _scrollSmooth;
    private bool _extended;
    private DateOnly? _reveal;
    private DateTime _navUntil; // стрелки «‹ ›» плавно листают — до этого момента подпись уже показывает цель, промежуточные месяцы не в счёт

    private DateOnly StripStart => RuDates.WeekStartOf(_firstMonth);

    private DateOnly StripEnd => RuDates.WeekStartOf(_lastMonth.AddMonths(1).AddDays(-1));

    /// <summary>Подсказка дня: «сегодня · 19 — 25 октября» — какая неделя откроется.</summary>
    private static string DayTitle(DateOnly day) =>
        (day == RuDates.Today ? "сегодня · " : "") + RuDates.WeekRange(RuDates.WeekStartOf(day));

    private string Hint => _typed switch
    {
        { } typed => $"→ {RuDates.WeekRange(RuDates.WeekStartOf(typed.Date))}",
        null when _text.Trim().Length > 0 => "не понимаю — например, 12.03 или 12 марта",
        _ => "Enter — к выбранной неделе · стрелки — по дням",
    };

    protected override async Task OnInitializedAsync()
    {
        _selected = State.WeekStart;
        await ShowMonthAsync(MonthOf(State.WeekStart.AddDays(3)), smooth: false); // месяц недели — по её четвергу
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/jumpstrip.js");
                if (_disposed)
                {
                    return;
                }

                _self = DotNetObjectReference.Create(this);
                _stripId = await _module.InvokeAsync<int>("init", _strip, _self);
            }

            if (_module is null)
            {
                return;
            }

            if (_extended)
            {
                _extended = false;
                await _module.InvokeVoidAsync("afterExtend", _stripId);
            }

            if (_scrollTo is { } week)
            {
                _scrollTo = null;
                await _module.InvokeVoidAsync("scrollToWeek", _stripId, Css.Date(week), _scrollSmooth);
            }

            if (_reveal is { } picked)
            {
                _reveal = null;
                await _module.InvokeVoidAsync("reveal", _stripId, Css.Date(picked));
            }
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or ObjectDisposedException)
        {
            // Календарь уже закрыли
        }
    }

    private static DateOnly MonthOf(DateOnly date) => new(date.Year, date.Month, 1);

    /// <summary>
    /// Показать месяц: его первая неделя — к верху окошка (стрелки — плавно). Месяца в ленте нет (набрали «март 2030») —
    /// лента строится заново вокруг него.
    /// </summary>
    private async Task ShowMonthAsync(DateOnly month, bool smooth)
    {
        _navUntil = smooth ? DateTime.UtcNow.AddMilliseconds(800) : default;
        _month = month;
        if (_firstMonth == default || month < _firstMonth || month > _lastMonth)
        {
            // Границы — локальные: пока грузятся точки, следующий ввод может перестроить ленту ещё раз
            var first = _firstMonth = month.AddMonths(-ChunkMonths);
            var last = _lastMonth = month.AddMonths(ChunkMonths);
            _busy.Clear();
            smooth = false;
            _scrollTo = RuDates.WeekStartOf(month); // до загрузки точек: лента перерисуется, пока они грузятся
            _scrollSmooth = false;
            await LoadDotsAsync(month, last); // сначала то, что на экране
            await LoadDotsAsync(first, month.AddMonths(-1));
        }

        _scrollTo = RuDates.WeekStartOf(month);
        _scrollSmooth = smooth;
    }

    /// <summary>Точки «есть дела» для недель месяцев from..to (включительно).</summary>
    private async Task LoadDotsAsync(DateOnly fromMonth, DateOnly toMonth)
    {
        try
        {
            var from = RuDates.WeekStartOf(fromMonth);
            var to = RuDates.WeekStartOf(toMonth.AddMonths(1).AddDays(-1)).AddDays(6);
            _busy.UnionWith((await Api.GetCalendarAsync(from, to)).BusyDays);
        }
        catch (ApiException)
        {
            // Без точек календарь работает так же
        }
    }

    /// <summary>js/jumpstrip.js: в середине окошка — эта неделя; подпись — месяц её четверга (C2).</summary>
    [JSInvokable]
    public void OnMiddleWeek(string week)
    {
        if (DateTime.UtcNow < _navUntil)
        {
            return;
        }

        if (DateOnly.TryParse(week, CultureInfo.InvariantCulture, out var monday) && MonthOf(monday.AddDays(3)) is var month && month != _month)
        {
            _month = month;
            StateHasChanged();
        }
    }

    /// <summary>js/jumpstrip.js: лента подошла к краю — дорастить на полгода в эту сторону (C5).</summary>
    [JSInvokable]
    public async Task ExtendAsync(int direction)
    {
        // Сначала дорисовать недели (прокрутка поправится в afterExtend, пока на экране то же самое), потом — точки
        DateOnly from, to;
        if (direction < 0)
        {
            to = _firstMonth.AddMonths(-1);
            from = _firstMonth = _firstMonth.AddMonths(-ChunkMonths);
        }
        else
        {
            from = _lastMonth.AddMonths(1);
            to = _lastMonth = _lastMonth.AddMonths(ChunkMonths);
        }

        _extended = true;
        StateHasChanged();
        await LoadDotsAsync(from, to);
        StateHasChanged();
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? "";
        _typed = DateQuery.Parse(_text, RuDates.Today);
        if (_typed is { } typed)
        {
            _selected = typed.Date;
            await ShowMonthAsync(MonthOf(typed.Date), smooth: false);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // ← → в непустом поле — курсор в тексте; ↑ ↓ — всегда по неделям
        var step = e.Key switch
        {
            "ArrowLeft" when _text.Length == 0 => -1,
            "ArrowRight" when _text.Length == 0 => 1,
            "ArrowUp" => -7,
            "ArrowDown" => 7,
            _ => 0,
        };
        if (step != 0)
        {
            _selected = _selected.AddDays(step);
            if (MonthOf(_selected) < _firstMonth || MonthOf(_selected) > _lastMonth)
            {
                await ShowMonthAsync(MonthOf(_selected), smooth: false);
            }

            _reveal = RuDates.WeekStartOf(_selected); // ушёл за край окошка — подтянуть (C4)
            return;
        }

        if (e.Key == "Enter")
        {
            if (_text.Trim().Length == 0)
            {
                await GoAsync(_selected);
            }
            else if (_typed is { } typed)
            {
                await GoAsync(typed.Date);
            }
        }
    }

    private async Task GoAsync(DateOnly day)
    {
        await OnClose.InvokeAsync();
        await State.GoToWeekAsync(day);
    }

    private async Task GoTodayAsync()
    {
        await OnClose.InvokeAsync();
        await State.TodayAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _stripId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Страница уже закрыта
            }
        }

        _self?.Dispose();
    }
}
