@* Шаги дела (дело-чеклист, один уровень) в окне дела: отметить, переименовать (клик по названию), удалить (×),
   «+ шаг» — Enter. Меняется сразу на сервере, кнопка «Сохранить» окна для шагов не нужна.
   Стили — css/editor.css (.steps). *@
@inject PlannerState State

<div class="steps">
    @foreach (var step in _steps)
    {
        var id = step.Id;
        <div class="step @(step.IsDone ? "done" : "")">
            <button type="button" class="step-ck @(step.IsDone ? "on" : "")" role="checkbox"
                    aria-checked="@(step.IsDone ? "true" : "false")" title="@(step.IsDone ? "Снять отметку" : "Выполнено")"
                    @onclick="() => ToggleAsync(step)"></button>
            @if (_editingId == id)
            {
                @* Esc — отменить только переименование, а не закрыть окно *@
                <span class="step-edit" @onkeydown:stopPropagation="true">
                    <InlineInput Value="@_editTitle" ValueChanged="v => _editTitle = v" MaxLength="500" SubmitOnBlur="true"
                                 OnSubmit="RenameAsync" OnCancel="() => _editingId = null" />
                </span>
            }
            else
            {
                <button type="button" class="step-title" title="Переименовать" @onclick="() => StartEdit(step)">@step.Title</button>
                <button type="button" class="row-action" title="Удалить шаг" aria-label="Удалить шаг" @onclick="() => DeleteAsync(id)">
                    <Icon Name="x" Size="11" />
                </button>
            }
        </div>
    }
    <input class="step-new" maxlength="500" placeholder="+ шаг — Enter" aria-label="Новый шаг"
           @bind="_newTitle" @bind:event="oninput" @onkeydown="OnNewKeyAsync" />
</div>

@code {
    private List<StepDto> _steps = [];
    private string _newTitle = "";
    private int? _editingId;
    private string _editTitle = "";

    [Parameter, EditorRequired]
    public int TaskId { get; set; }

    /// <summary>Сколько шагов и сколько отмечено — окну для подписи «Шаги 2/5».</summary>
    [Parameter]
    public EventCallback<(int Done, int Total)> OnCountChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _steps = await State.GetStepsAsync(TaskId);
        await ReportAsync();
    }

    private Task ReportAsync() => OnCountChanged.InvokeAsync((_steps.Count(s => s.IsDone), _steps.Count));

    private async Task OnNewKeyAsync(KeyboardEventArgs e)
    {
        // Enter в поле шага — добавить шаг (окно сохраняет только Enter в названии и Ctrl+Enter)
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_newTitle))
        {
            return;
        }

        var title = _newTitle;
        _newTitle = "";
        if (await State.AddStepAsync(TaskId, title) is { } step)
        {
            _steps.Add(step);
            await ReportAsync();
        }
    }

    private async Task ToggleAsync(StepDto step)
    {
        if (await State.SetStepDoneAsync(step.Id, !step.IsDone) is { } saved)
        {
            _steps[_steps.FindIndex(s => s.Id == saved.Id)] = saved;
            await ReportAsync();
        }
    }

    private void StartEdit(StepDto step)
    {
        _editingId = step.Id;
        _editTitle = step.Title;
    }

    private async Task RenameAsync(string title)
    {
        if (_editingId is not { } id)
        {
            return;
        }

        _editingId = null;
        if (!string.IsNullOrWhiteSpace(title) && await State.RenameStepAsync(id, title) is { } saved)
        {
            _steps[_steps.FindIndex(s => s.Id == saved.Id)] = saved;
        }
    }

    private async Task DeleteAsync(int stepId)
    {
        if (await State.DeleteStepAsync(stepId))
        {
            _steps.RemoveAll(s => s.Id == stepId);
            await ReportAsync();
        }
    }
}
