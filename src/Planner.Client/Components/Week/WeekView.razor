@* Центр: неделя из 7 дней-списков («страницы в точку») *@
@inherits StateComponent

<main class="panel week">
    <div class="week-h">
        <button class="nav" title="Предыдущая неделя" @onclick="State.PreviousWeekAsync">
            <Icon Name="chevron-left" />
        </button>
        <span class="wt">@RuDates.WeekRange(State.WeekStart)</span>
        <button class="nav" title="Следующая неделя" @onclick="State.NextWeekAsync">
            <Icon Name="chevron-right" />
        </button>
        @if (!IsCurrentWeek)
        {
            <button class="today-b" @onclick="State.TodayAsync">Сегодня</button>
        }
        @if (State.RocksTotal > 0)
        {
            <span class="rocks">камней: <b>@State.RocksDone из @State.RocksTotal</b></span>
        }
    </div>

    <div class="days">
        @foreach (var day in State.WeekDays)
        {
            <DayColumn Date="day" Tasks="State.TasksOn(day).ToList()" />
        }
    </div>
</main>

@code {
    private bool IsCurrentWeek => State.WeekStart == RuDates.WeekStartOf(RuDates.Today);
}
