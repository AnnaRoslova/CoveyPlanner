@* Центр: неделя из 7 дней-списков (временная версия до редизайна) *@
@inherits StateComponent

<main class="week">
    <div class="week-toolbar">
        <button class="icon-btn" title="Предыдущая неделя" @onclick="State.PreviousWeekAsync">
            <Icon Name="chevron-left" />
        </button>
        <span class="week-title">@RuDates.WeekRange(State.WeekStart)</span>
        <button class="icon-btn" title="Следующая неделя" @onclick="State.NextWeekAsync">
            <Icon Name="chevron-right" />
        </button>
    </div>
    <div class="week-body">
        @foreach (var day in State.WeekDays)
        {
            <DayPriorities Date="day" Tasks="State.PrioritiesOn(day).ToList()" />
        }
    </div>
</main>
