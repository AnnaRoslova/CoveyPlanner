@* Центр: неделя из 7 дней-списков («страницы в точку»).
   Листание во время перетаскивания дела (data-flip, js/dnd.js): широкие зоны по краям недели — они проступают,
   только пока тащат дело, — и стрелки «‹ ›» в шапке. *@
@inherits StateComponent
@inject WindowHost Windows
@inject RightPanelState RightPanel

<main class="panel week">
    <div class="week-h">
        <button class="nav" title="Предыдущая неделя" @onclick="State.PreviousWeekAsync"
                data-flip="-1" data-flip-accept="@DragDropService.FlipAccepts">
            <Icon Name="chevron-left" />
        </button>
        <span class="wt">@RuDates.WeekRange(State.WeekStart)</span>
        <button class="nav" title="Следующая неделя" @onclick="State.NextWeekAsync"
                data-flip="1" data-flip-accept="@DragDropService.FlipAccepts">
            <Icon Name="chevron-right" />
        </button>
        @if (!IsCurrentWeek)
        {
            <button class="today-b" @onclick="State.TodayAsync">Сегодня</button>
        }
        <div class="tools">
            @if (State.RocksTotal > 0)
            {
                <span class="rocks" title="камень выполнен, когда отмечены все его занятия">
                    камней: <b>@State.RocksDone из @State.RocksTotal</b>
                    · занятий <b>@State.SessionsDone из @State.SessionsTotal</b>
                </span>
            }
        </div>
        @* «🛠 Проекты» — на месте ленты (N6.8); нажата — показаны проекты *@
        <button type="button" class="projects-b @(RightPanel.IsProjects ? "on" : "")" title="Проекты" aria-label="Проекты"
                aria-pressed="@(RightPanel.IsProjects ? "true" : "false")" @onclick="RightPanel.ToggleAsync">🛠</button>
        <button type="button" class="jar-b" title="Копилки привычек" aria-label="Копилки привычек" @onclick="() => Windows.OpenHabits()">🫙</button>
        <button type="button" class="report-b" title="Отчёт за период" aria-label="Отчёт за период" @onclick="Windows.OpenReport">📊</button>
        <ThemePicker />
    </div>

    <div class="days">
        @foreach (var day in State.WeekDays)
        {
            <DayColumn @key="day" Date="day" Tasks="State.TasksOn(day).ToList()" OnEdit="Windows.OpenTask" />
        }
    </div>

    @* Края недели во время перетаскивания: навести и держать — неделя листается *@
    <div class="flip-zone prev" data-flip="-1" data-flip-overlay data-flip-accept="@DragDropService.FlipAccepts" aria-hidden="true">
        <span>‹ прошлая неделя</span>
    </div>
    <div class="flip-zone next" data-flip="1" data-flip-overlay data-flip-accept="@DragDropService.FlipAccepts" aria-hidden="true">
        <span>следующая неделя ›</span>
    </div>
</main>

@code {
    private bool IsCurrentWeek => State.WeekStart == RuDates.WeekStartOf(RuDates.Today);
}
