@* Центр: неделя из 7 дней-списков («страницы в точку»).
   Листание во время перетаскивания дела (data-flip, js/dnd.js): широкие зоны по краям недели — они проступают,
   только пока тащат дело, — и стрелки «‹ ›» в шапке. *@
@inherits StateComponent
@inject WindowHost Windows
@inject TotalsState Totals

<main class="panel week">
    <div class="week-h">
        @* C1: «‹» и «›» рядом, подпись — после них: при листании подряд стрелки не «убегают» из-под курсора (fixes-2026-10.md, C) *@
        <div class="week-nav">
            <button class="nav" title="Предыдущая неделя (←)" @onclick="State.PreviousWeekAsync"
                    data-flip="-1" data-flip-accept="@DragDropService.FlipAccepts">
                <Icon Name="chevron-left" />
            </button>
            <button class="nav" title="Следующая неделя (→)" @onclick="State.NextWeekAsync"
                    data-flip="1" data-flip-accept="@DragDropService.FlipAccepts">
                <Icon Name="chevron-right" />
            </button>
        </div>
        @* J1: подпись недели — кнопка «перейти к дате» (мини-календарь, batch-3.md) *@
        <button type="button" @ref="_title" class="wt" title="Перейти к дате (G)" aria-haspopup="dialog" @onclick="ToggleCalendar">@RuDates.WeekRange(State.WeekStart)</button>
        @if (Windows.CalendarOpen)
        {
            <WeekJump Anchor="_title" OnClose="CloseCalendar" />
        }
        @if (!IsCurrentWeek)
        {
            <button class="today-b" title="К сегодня (T)" @onclick="State.TodayAsync">Сегодня</button>
        }
        <div class="tools">
            @if (State.RocksTotal > 0)
            {
                <span class="rocks" title="камень выполнен, когда отмечены все его занятия">
                    камней: <b>@State.RocksDone из @State.RocksTotal</b>
                    · занятий <b>@State.SessionsDone из @State.SessionsTotal</b>
                </span>
            }
        </div>
        @* В шапке — только «📈 Итоги» и «⚙ Настройки», линейные значки одного стиля (batch-ux.md, BI1; ui-declutter.md, D9):
           ✓ 🫙 📊 — вкладки «Итогов», тема и «Как это устроено» — в «Настройках», 🛠 — вкладка правой колонки *@
        <button type="button" class="icon-b totals-b" title="Итоги (H)" aria-label="Итоги" @onclick="() => Windows.OpenTotals(Totals.Last)">
            <Icon Name="chart" Size="16" />
        </button>
        <button type="button" class="icon-b settings-b" title="Настройки" aria-label="Настройки" @onclick="Windows.OpenSettings">
            <Icon Name="gear" Size="16" />
        </button>
    </div>

    <div class="days">
        @foreach (var day in State.WeekDays)
        {
            <DayColumn @key="day" Date="day" Tasks="State.DayRows(day).ToList()" OnEdit="Windows.OpenTask" />
        }
    </div>

    @* Края недели во время перетаскивания: навести и держать — неделя листается *@
    <div class="flip-zone prev" data-flip="-1" data-flip-overlay data-flip-accept="@DragDropService.FlipAccepts" aria-hidden="true">
        <span>‹ прошлая неделя</span>
    </div>
    <div class="flip-zone next" data-flip="1" data-flip-overlay data-flip-accept="@DragDropService.FlipAccepts" aria-hidden="true">
        <span>следующая неделя ›</span>
    </div>
</main>

@code {
    private ElementReference _title;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Windows.Changed += OnWindowsChanged; // календарь открывают и клавишей G (Hotkeys)
    }

    public override void Dispose()
    {
        Windows.Changed -= OnWindowsChanged;
        base.Dispose();
    }

    private void OnWindowsChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Сколько после закрытия календаря клик по подписи — не «открыть снова»: календарь закрыли Enter, фокус вернулся на подпись,
    /// и браузер нажимает её тем же Enter.
    /// </summary>
    private static readonly TimeSpan ReopenGuard = TimeSpan.FromMilliseconds(400);

    private DateTime _calendarClosedAt;

    private void ToggleCalendar()
    {
        if (Windows.CalendarOpen)
        {
            CloseCalendar();
        }
        else if (DateTime.UtcNow - _calendarClosedAt > ReopenGuard)
        {
            Windows.OpenCalendar();
        }
    }

    private void CloseCalendar()
    {
        _calendarClosedAt = DateTime.UtcNow;
        Windows.Close();
    }

    private bool IsCurrentWeek => State.WeekStart == RuDates.WeekStartOf(RuDates.Today);
}
