@* Сетка часов одного дня: «Встречи и обязательства» *@

<div class="day-grid @(Date == RuDates.Today ? "today" : "")"
     style="height: @Css.Px(Height); --slots-per-hour: @(60 / Settings.SlotMinutes)"
     data-drop="grid" data-date="@Css.Date(Date)"
     data-day-start="@Settings.DayStartHour" data-day-end="@Settings.DayEndHour"
     data-slot-minutes="@Settings.SlotMinutes" data-slot-height="@Css.Px(GridLayout.SlotHeight)">
    @foreach (var block in GridLayout.Arrange(Tasks, Settings))
    {
        <div class="grid-block"
             style="top: @Css.Px(block.Top); height: @Css.Px(block.Height); left: @Css.Percent(100.0 * block.Lane / block.LaneCount); width: @Css.Percent(100.0 / block.LaneCount)">
            <TaskCard Task="block.Task" Variant="TaskCardVariant.Grid" Compact="block.Height < CompactHeight" />
        </div>
    }
</div>

@code {
    /// <summary>Ниже этой высоты (px) карточка показывается в одну строку.</summary>
    private const double CompactHeight = 36;

    [Parameter, EditorRequired]
    public DateOnly Date { get; set; }

    [Parameter, EditorRequired]
    public SettingsDto Settings { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyList<TaskDto> Tasks { get; set; } = [];

    private double Height =>
        GridLayout.MinutesToPixels((Settings.DayEndHour - Settings.DayStartHour) * 60, Settings.SlotMinutes);
}
