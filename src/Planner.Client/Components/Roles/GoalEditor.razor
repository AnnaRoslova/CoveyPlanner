@* Окно цели — шаблон занятий: название, роли (можно несколько), «раз в неделю», «каждую неделю», время, квадрант, длительность, заметки.
   Изменения расходятся по невыполненным занятиям недели (кроме полей, которые у занятия свои);
   роль и квадрант — по всем занятиям. Постоянная цель пилы — привычка: строка «🫙 привычка: 102 скрепки · 🔥13»
   (клик — экран «Копилки» на ней) и настройки банки. Enter в названии — сохранить, Esc или клик мимо — отмена.
   Стили — css/editor.css. *@
@inherits StateComponent
@inject WindowHost Windows

<div class="editor-backdrop" @onclick="OnClose"></div>

<div class="editor" role="dialog" aria-label="Цель недели" tabindex="-1" @onkeydown="OnKeyDown">
    <input @ref="_titleInput" class="title-input" maxlength="500" placeholder="Цель на неделю"
           @bind="_title" @bind:event="oninput" @onkeydown="OnTitleKey" />

    <div class="rock-note">
        <span class="pill-rock">цель</span>
        шаблон занятий: новые занятия берут эти значения
        @if (EditedGoal.TimesPerWeek > 1 || EditedGoal.Sessions.Count > 0)
        {
            <text> · сделано @EditedGoal.DoneCount из @EditedGoal.TimesPerWeek</text>
        }
    </div>

    <div class="field">
        <div class="label">Роль</div>
        @* Роли — можно несколько: цель видна под каждой (одна и та же, прогресс общий); хотя бы одна *@
        <RolePicker Roles="State.OrderedRoles" Value="_roleIds" ValueChanged="ids => _roleIds = [.. ids]" Required="true" />
    </div>

    <div class="field">
        <div class="label">Раз в неделю</div>
        <div class="times-per-week">
            @if (DaysChosen)
            {
                @* Дни выбраны — «раз в неделю» задают они *@
                <span class="times-fixed">@DayCount(_days)</span>
                <span class="hint">= числу выбранных дней</span>
            }
            else
            {
                <Stepper Value="_times" ValueChanged="times => _times = times ?? 1" Min="1" Max="MaxTimesPerWeek" Label="Раз в неделю" />
            }
        </div>
    </div>

    @* «Каждую неделю»: цель сама появляется на следующих неделях; правка — с этой недели и дальше *@
    <label class="switch-row">
        <input type="checkbox" role="switch" @bind="_recurring" @bind:after="OnRecurringChanged" />
        <span class="switch"></span>
        <span>каждую неделю</span>
        <span class="hint">@(_recurring ? "появится и на следующих неделях; изменения — с этой недели и дальше" : "только на этой неделе")</span>
    </label>

    @if (_recurring)
    {
        @* «🫙 копить»: постоянная цель с ним — привычка с банкой. Свойство всей серии, история не теряется *@
        <label class="switch-row">
            <input type="checkbox" role="switch" @bind="_habit" />
            <span class="switch"></span>
            <span>🫙 копить</span>
            <span class="hint">@(_habit ? "занятия — скрепки в банку привычки" : "без банки и серий")</span>
        </label>

        @* Повтор: «сам раскладываю» — как раньше; дни выбраны — занятия встают в них сами.
           Кружки дней можно переключать руками — тогда в списке «свои дни» *@
        <div class="field">
            <div class="repeat-row">
                <span class="label">Повтор</span>
                <ChoiceField TValue="Repeat" Items="RepeatChoices" Value="_repeat" ValueChanged="SetRepeat" Label="Повтор" />
            </div>
            @if (_repeat != Repeat.Manual)
            {
                <div class="day-dots" role="group" aria-label="Дни">
                    @for (var i = 0; i < DayNames.Length; i++)
                    {
                        var bit = 1 << i;
                        var on = (_days & bit) != 0;
                        <button type="button" class="day-dot @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")"
                                title="@DayNames[i]" aria-label="@DayNames[i]" @onclick="() => ToggleDay(bit)">@DayNames[i][..1]</button>
                    }
                </div>
            }
            @if (DaysChosen)
            {
                <div class="date-hint">занятия встанут в эти дни сами — на этой неделе и дальше; выполненные не трогаются</div>
            }
        </div>
    }

    @* Проект цели (P1): новые занятия — его шаги; его шаги — шаги цели, один список (G1–G2).
       У постоянной цели проект — только выбранный, сам он не создаётся (fixes-2026-10.md, A1–A2): без проекта блока «Шаги» нет *@
    <div class="field">
        <div class="project-row">
            <span class="label">Проект</span>
            <ChoiceField TValue="int" Items="ProjectChoices" Value="ShownProjectId" ValueChanged="SetProject" Label="Проект" Searchable="true" />
        </div>
        <div class="date-hint">@(ShowsSteps ? "новые занятия — шаги проекта" : "у привычки проект — только выбранный: книга, курс…")</div>
    </div>
    @if (ShowsSteps)
    {
        <GoalStepsBlock Goal="@(State.FindGoal(EditedGoal.Id) ?? EditedGoal)" />
    }

    <label class="switch-row">
        <input type="checkbox" role="switch" @bind="_several" />
        <span class="switch"></span>
        <span>можно несколько раз в день</span>
        <span class="hint">@(_several ? "например, утром и вечером" : "в один день — не больше одного занятия")</span>
    </label>

    @* Постоянная цель с «копить» — привычка: её счёт и банка (норма — «раз в неделю», скрепки — выполненные занятия) *@
    @if (_recurring && _habit && State.HabitOfGoal(EditedGoal) is { } habit)
    {
        <div class="field habit-of-goal">
            <button type="button" class="habit-line" title="Открыть на экране «Копилки»" @onclick="() => OpenHabitAsync(habit.Id)">
                🫙 привычка: @habit.Stats.Total @HabitCard.ClipsWord(habit.Stats.Total) · @(habit.Stats.WeekPaused ? "⚠" : $"🔥{habit.Stats.WeekStreak}")
            </button>
            <div class="row">
                <div class="field">
                    <div class="label">Стартовое число</div>
                    <Stepper Value="_startCount" ValueChanged="v => _startCount = v ?? 0" Min="0" Max="1000000" Label="Стартовое число" />
                </div>
                <div class="field">
                    <div class="label">В банке</div>
                    <Stepper Value="_jarSize" ValueChanged="v => _jarSize = v ?? 30" Min="1" Max="1000" Step="5" Label="Скрепок в банке" Unit="скрепок" />
                </div>
            </div>
            <div class="date-hint">стартовое число — сколько скрепок было до привычки: идут только в общий счёт</div>
        </div>
    }

    <div class="row">
        <div class="field">
            <div class="label">Время</div>
            <TimePicker @bind-Value="_time" />
        </div>

        <div class="field">
            <div class="label">Квадрант</div>
            <QuadrantPicker @bind-Value="_quadrant" />
        </div>
    </div>
    @if (_quadrant is { } q)
    {
        <div class="quadrant-hint">@QuadrantPicker.Hint(q)</div>
    }

    <div class="field">
        <div class="label">Длительность</div>
        <DurationPicker @bind-Value="_duration" />
    </div>

    <div class="field">
        <div class="label">Заметки</div>
        <textarea rows="3" maxlength="10000" placeholder="Что делать на занятии, ссылки…" @bind="_notes" @bind:event="oninput"></textarea>
    </div>

    <div class="buttons">
        <button type="button" class="btn danger trash" @onclick="DeleteAsync">удалить цель</button>
        <button type="button" class="btn quiet" @onclick="OnClose">Отмена</button>
        <button type="button" class="btn" disabled="@string.IsNullOrWhiteSpace(_title)" @onclick="SaveAsync">Сохранить</button>
    </div>
</div>

@code {
    private const int MaxTimesPerWeek = 7;

    private ElementReference _titleInput;
    private string _title = "";
    private List<int> _roleIds = [];
    private int _times;
    private TimeOnly? _time;
    private int? _quadrant;
    private int? _duration;
    private string? _notes;
    private bool _recurring;
    private bool _habit;
    private int _projectId; // 0 — без проекта
    private bool _projectChanged;

    /// <summary>
    /// Кого можно выбрать проектом (P1, S7): открытые дела без родителя, не занятия целей — из ленты и из показанной недели;
    /// текущий проект — всегда (даже выполненный, с пометкой).
    /// </summary>
    private IReadOnlyList<Choice<int>> ProjectChoices
    {
        get
        {
            var current = State.FindGoal(EditedGoal.Id) ?? EditedGoal;
            var list = new List<Choice<int>> { new(0, "— нет") };
            if (current.ProjectId is { } id && ShownProjectId == id)
            {
                list.Add(new(id, (current.ProjectTitle ?? "проект") + (current.ProjectIsTrashed ? " (в корзине)" : current.ProjectIsOpen ? "" : " (выполнен)")));
            }

            list.AddRange(State.ProjectCandidates()
                .Where(t => t.Id != current.ProjectId)
                .Select(t => new Choice<int>(t.Id, t.Title)));
            return list.DistinctBy(c => c.Value).ToList();
        }
    }

    /// <summary>Что в поле: выбранное здесь, а пока не трогали — проект цели (его мог только что создать «+ шаг», G3).</summary>
    private int ShownProjectId => _projectChanged ? _projectId : (State.FindGoal(EditedGoal.Id) ?? EditedGoal).ProjectId ?? 0;

    /// <summary>
    /// Блок «Шаги»: у разовой цели — всегда (первый шаг создаст проект, G3); у постоянной (здесь или уже на сервере) — только при выбранном
    /// проекте не в корзине (A2). Выбор в поле до «Сохранить» блок не показывает: шаги — того проекта, что уже выбран у цели.
    /// </summary>
    private bool ShowsSteps =>
        !(_recurring || EditedGoal.IsRecurring) || (State.FindGoal(EditedGoal.Id) ?? EditedGoal) is { ProjectId: not null, ProjectIsTrashed: false };

    private void SetProject(int projectId)
    {
        _projectId = projectId;
        _projectChanged = true;
    }
    private bool _several;
    private int _startCount;
    private int _jarSize = 30;
    private int _days; // маска дней (Пн = 1 … Вс = 64), 0 — «сам раскладываю»

    private const int EveryDay = 127;
    private const int WorkDaysMask = 31; // Пн–Пт
    private const int WeekendMask = 96; // Сб, Вс
    private static readonly string[] DayNames = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];

    private enum Repeat { Manual, EveryDay, Weekdays, Weekend, Custom }

    private static readonly List<Choice<Repeat>> RepeatChoices =
    [
        new(Repeat.Manual, "сам раскладываю"),
        new(Repeat.EveryDay, "каждый день"),
        new(Repeat.Weekdays, "будни"),
        new(Repeat.Weekend, "выходные"),
        new(Repeat.Custom, "свои дни"),
    ];

    private Repeat _repeat;

    private static Repeat RepeatOf(int days) => days switch
    {
        0 => Repeat.Manual,
        EveryDay => Repeat.EveryDay,
        WorkDaysMask => Repeat.Weekdays,
        WeekendMask => Repeat.Weekend,
        _ => Repeat.Custom,
    };

    private void SetRepeat(Repeat repeat)
    {
        _repeat = repeat;
        _days = repeat switch
        {
            Repeat.Manual => 0,
            Repeat.EveryDay => EveryDay,
            Repeat.Weekdays => WorkDaysMask,
            Repeat.Weekend => WeekendMask,
            _ => _days, // «свои дни» — с выбранных сейчас
        };
    }

    private void ToggleDay(int bit)
    {
        _days ^= bit;
        _repeat = Repeat.Custom;
    }

    private bool DaysChosen => _recurring && _days != 0;

    private static int DayCount(int days) => System.Numerics.BitOperations.PopCount((uint)days);

    [Parameter, EditorRequired]
    public WeeklyGoalDto EditedGoal { get; set; } = null!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized(); // перерисовка при изменениях: «+ шаг» мог создать проект (G3)
        _title = EditedGoal.Title;
        _roleIds = [.. EditedGoal.RoleIds];
        _times = EditedGoal.TimesPerWeek;
        _time = EditedGoal.StartTime;
        _quadrant = EditedGoal.Quadrant;
        _duration = EditedGoal.DurationMinutes;
        _notes = EditedGoal.Notes;
        _recurring = EditedGoal.IsRecurring;
        _habit = EditedGoal.IsRecurring ? EditedGoal.IsHabit : HabitByDefault;
        _projectId = EditedGoal.ProjectId ?? 0;
        _several = EditedGoal.AllowSeveralPerDay;
        if (State.HabitOfGoal(EditedGoal) is { } habit)
        {
            _startCount = habit.StartCount;
            _jarSize = habit.JarSize;
        }

        _days = EditedGoal.Days ?? 0;
        _repeat = RepeatOf(_days);
    }

    /// <summary>«Копить» по умолчанию (так же решает сервер): есть роль-измерение пилы — копить.</summary>
    private bool HabitByDefault => _roleIds.Any(id => State.FindRole(id)?.IsSharpenSaw == true);

    /// <summary>Включили «каждую неделю» — «копить» предустанавливается по ролям (видно до «Сохранить»).</summary>
    private void OnRecurringChanged()
    {
        if (_recurring && !EditedGoal.IsRecurring)
        {
            _habit = HabitByDefault;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _titleInput.FocusAsync();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
        else if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
        {
            await SaveAsync();
        }
    }

    private async Task OnTitleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.CtrlKey && !e.MetaKey)
        {
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_title))
        {
            return;
        }

        // Банка — у привычки, а не у цели: сохраняется отдельно (привычка остаётся той же, даже если цель перестанет повторяться)
        var habit = State.HabitOfGoal(EditedGoal);
        await OnClose.InvokeAsync();
        await State.UpdateGoalAsync(EditedGoal.Id,
            new UpdateGoalRequest(_title, _roleIds, DaysChosen ? DayCount(_days) : _times, _time, _quadrant, _notes, _duration,
                _recurring, _several, Days: DaysChosen ? _days : 0, IsHabit: _recurring ? _habit : null,
                ProjectId: _projectChanged ? _projectId : null)); // проект, созданный «+ шаг», уже выбран на сервере
        if (habit is not null && (habit.StartCount, habit.JarSize) != (_startCount, _jarSize))
        {
            await State.UpdateHabitAsync(habit.Id, _startCount, _jarSize);
        }
    }

    /// <summary>Пилюля «🫙 привычка: …» — экран «Копилки» на этой привычке (несохранённая правка окна теряется, как при «Отмена»).</summary>
    private async Task OpenHabitAsync(int habitId)
    {
        await OnClose.InvokeAsync();
        Windows.OpenHabits(habitId);
    }

    /// <summary>Удалить; мысль цели без дня вернётся в ленту (без своей категории — в «неразобранное»).</summary>
    private async Task DeleteAsync()
    {
        var goalId = EditedGoal.Id;
        await OnClose.InvokeAsync();
        await Windows.DeleteGoalAsync(State, goalId); // постоянную — с вопросом
    }
}
