@* Окно цели — шаблон занятий (docs/specs/ui-declutter.md, U2.D): основное — одна-две строки «роль · раз в неделю · каждую неделю · 🫙 копить»;
   редкие поля (повтор по дням, время, длительность, «несколько раз в день», квадрант, проект с шагами, заметки, банка привычки) — заполненные
   одной строкой-сводкой (клик раскрывает поле), пустые — «+ …» (U2.2). Изменения расходятся по невыполненным занятиям недели (кроме полей,
   которые у занятия свои); роль и квадрант — по всем занятиям. Внизу — «⋯» («🫙 открыть привычку», «удалить цель»), «Отмена», «Сохранить».
   Enter в названии — сохранить, Esc или клик мимо — отмена.
   Выключили «каждую неделю», а на следующих неделях уже есть цели, — перед сохранением вопрос «Закончить серию?» (SeriesEndDialog, E1.2).
   Стили — css/editor.css. *@
@inherits StateComponent
@inject WindowHost Windows
@inject IJSRuntime JS

<div class="editor-backdrop" @onclick="OnClose"></div>

<div @ref="_root" class="editor" role="dialog" aria-label="Цель недели" tabindex="-1" @onkeydown="OnKeyDown">
    <input @ref="_titleInput" class="title-input" maxlength="500" placeholder="Цель на неделю"
           @bind="_title" @bind:event="oninput" @onkeydown="OnTitleKey" />

    <div class="rock-note">
        <span class="pill-rock" title="шаблон занятий: новые занятия берут эти значения">цель недели</span>
        @if (EditedGoal.TimesPerWeek > 1 || EditedGoal.Sessions.Count > 0)
        {
            <span>выполнено @EditedGoal.DoneCount из @EditedGoal.Norm@(EditedGoal.NotNeededCount > 0 ? $" · не нужно: {EditedGoal.NotNeededCount}" : "")</span>
        }
        @* Дни занятий — здесь и в подсказке строки цели, под названием в панели их нет (batch-3.md, M2) *@
        @if (RoleCard.SessionDays(EditedGoal) is { Length: > 0 } sessionDays)
        {
            <span class="session-days">· дни: @sessionDays</span>
        }
    </div>

    @* Основное — одна-две строки (U2.2): роль · раз в неделю · каждую неделю · 🫙 копить *@
    <div class="goal-main">
        @* Роли — можно несколько: цель видна под каждой (одна и та же, прогресс общий); хотя бы одна *@
        <RolePicker Roles="State.OrderedRoles" Value="_roleIds" ValueChanged="ids => _roleIds = [.. ids]" Required="true" />
        <span class="times-per-week" title="@(DaysChosen ? "раз в неделю = числу выбранных дней" : "раз в неделю")">
            @if (DaysChosen)
            {
                @* Дни выбраны — «раз в неделю» задают они *@
                <span class="times-fixed">@DayCount(_days)</span>
            }
            else
            {
                <Stepper Value="_times" ValueChanged="times => _times = times ?? 1" Min="1" Max="MaxTimesPerWeek" Label="Раз в неделю" />
            }
            <span class="times-word">раз в неделю</span>
        </span>
        @* «Каждую неделю»: цель сама появляется на следующих неделях; правка — с этой недели. «🫙 копить» — привычка с банкой *@
        <span class="switches">
            <label class="switch-row" title="@RecurringHint">
                <input type="checkbox" role="switch" @bind="_recurring" @bind:after="OnRecurringChanged" />
                <span class="switch"></span>
                <span>каждую неделю</span>
            </label>
            @if (_recurring)
            {
                <label class="switch-row" title="@HabitHint">
                    <input type="checkbox" role="switch" @bind="_habit" @bind:after="OnHabitChanged" />
                    <span class="switch"></span>
                    <span>🫙 копить</span>
                </label>
            }
        </span>
    </div>
    @if (TouchedHint is { } touchedHint)
    {
        <div class="date-hint">@touchedHint</div>
    }

    @* Редкие поля (U2.2): заполненное — одной строкой-сводкой (клик раскрывает это поле), пустое — «+ …» *@
    <div class="rare">
        @if (_recurring)
        {
            @if (_rare.IsOpen("days"))
            {
                @* Повтор: «сам раскладываю» — как раньше; дни выбраны — занятия встают в них сами. Кружки — «свои дни» *@
                <div class="field" data-field="days">
                    <div class="line repeat-row">
                        <span class="label">Повтор</span>
                        <ChoiceField TValue="Repeat" Items="RepeatChoices" Value="_repeat" ValueChanged="SetRepeat" Label="Повтор" />
                        <RareClear Key="days" OnClear="@(() => Clear("days", () => SetRepeat(Repeat.Manual)))" />
                    </div>
                    @if (_repeat != Repeat.Manual)
                    {
                        <div class="day-dots" role="group" aria-label="Дни">
                            @for (var i = 0; i < DayNames.Length; i++)
                            {
                                var bit = 1 << i;
                                var on = (_days & bit) != 0;
                                <button type="button" class="day-dot @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")"
                                        title="@DayNames[i]" aria-label="@DayNames[i]" @onclick="() => ToggleDay(bit)">@DayNames[i][..1]</button>
                            }
                        </div>
                    }
                    @if (DaysChosen)
                    {
                        <div class="date-hint">занятия встанут в эти дни сами</div>
                    }
                </div>
            }
            else if (DaysChosen)
            {
                <SummaryChip Key="days" Text="@($"Повтор: {DaysText}")" OnClick="@(() => _rare.Open("days"))" />
            }
        }

        @if (_rare.IsOpen("time"))
        {
            <div class="line" data-field="time">
                <span class="label">Время</span>
                <TimePicker @bind-Value="_time" />
                <RareClear Key="time" OnClear="@(() => Clear("time", () => _time = null))" />
            </div>
        }
        else if (_time is { } time)
        {
            <SummaryChip Key="time" Text="@($"🕐 {RuDates.Time(time)}")" OnClick="@(() => _rare.Open("time"))" />
        }

        @if (_rare.IsOpen("duration"))
        {
            <div class="line" data-field="duration">
                <span class="label">Длительность</span>
                <DurationPicker @bind-Value="_duration" />
                <RareClear Key="duration" OnClear="@(() => Clear("duration", () => _duration = null))" />
            </div>
        }
        else if (_duration is { } minutes)
        {
            <SummaryChip Key="duration" Text="@($"⏱ {RuDates.Duration(minutes)}")" OnClick="@(() => _rare.Open("duration"))" />
        }

        @if (_rare.IsOpen("several"))
        {
            <div class="several-row" data-field="several">
                <label class="switch-row" title="@(_several ? "можно утром и вечером" : "одно в день")">
                    <input type="checkbox" role="switch" @bind="_several" />
                    <span class="switch"></span>
                    <span>можно несколько раз в день</span>
                </label>
                <RareClear Key="several" OnClear="@(() => Clear("several", () => _several = false))" />
            </div>
        }
        else if (_several)
        {
            <SummaryChip Key="several" Text="можно несколько раз в день" OnClick="@(() => _rare.Open("several"))" />
        }

        @if (_rare.IsOpen("quadrant"))
        {
            <div class="line" data-field="quadrant">
                <span class="label">Квадрант</span>
                <QuadrantPicker @bind-Value="_quadrant" />
                <RareClear Key="quadrant" OnClear="@(() => Clear("quadrant", () => _quadrant = null))" />
            </div>
        }
        else if (_quadrant is { } q)
        {
            <SummaryChip Key="quadrant" Text="@($"Квадрант {QuadrantPicker.Label(q)}")" OnClick="@(() => _rare.Open("quadrant"))" />
        }

        @if (_rare.IsOpen("project"))
        {
            @* Проект цели (P1): новые занятия — его шаги; его шаги — шаги цели, один список (G1–G2).
               У постоянной цели проект — только выбранный, сам он не создаётся (fixes-2026-10.md, A1–A2) *@
            <div class="field" data-field="project">
                <div class="line project-row">
                    <span class="label">Проект</span>
                    <ChoiceField TValue="int" Items="ProjectChoices" Value="ShownProjectId" ValueChanged="SetProject" Label="Проект" Searchable="true" />
                    <RareClear Key="project" OnClear="@(() => Clear("project", () => SetProject(0)))" />
                </div>
                <div class="date-hint">@ProjectHint</div>
            </div>
        }
        else if (ShownProjectId != 0)
        {
            <SummaryChip Key="project" Text="@($"🛠 {ProjectChoices.FirstOrDefault(c => c.Value == ShownProjectId)?.Label ?? "проект"}")"
                         OnClick="@(() => _rare.Open("project"))" />
        }
        @* Шаги цели — содержимое: видны, когда проект выбран или поле «Проект» раскрыто (у разовой цели первый шаг создаст проект) *@
        @if (ShowsSteps && (ShownProjectId != 0 || _rare.IsOpen("project")))
        {
            <GoalStepsBlock Goal="@(State.FindGoal(EditedGoal.Id) ?? EditedGoal)" />
        }

        @if (_rare.IsOpen("notes"))
        {
            <div class="field" data-field="notes">
                <div class="label">Заметки</div>
                <textarea rows="3" maxlength="10000" placeholder="Что делать на занятии, ссылки…" @bind="_notes" @bind:event="oninput"></textarea>
                <RareClear Key="notes" OnClear="@(() => Clear("notes", () => _notes = null))" />
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_notes))
        {
            <SummaryChip Key="notes" Text="@($"📝 {RareFields.FirstLine(_notes)}")" Title="@_notes" OnClick="@(() => _rare.Open("notes"))" />
        }

        @* Банка привычки: «🫙 19 скрепок · 🔥2 ▸» — стартовое число и размер (как «настроить» на экране привычек) *@
        @if (_recurring && _habit && State.HabitOfGoal(EditedGoal) is { } habit)
        {
            @if (_rare.IsOpen("jar"))
            {
                <div class="line habit-of-goal" data-field="jar" title="стартовое число — скрепки до привычки">
                    <span class="label">Банка</span>
                    <div class="line-values">
                        <Stepper Value="_startCount" ValueChanged="v => _startCount = v ?? 0" Min="0" Max="1000000" Label="Стартовое число" />
                        <Stepper Value="_jarSize" ValueChanged="v => _jarSize = v ?? 30" Min="1" Max="1000" Step="5" Label="Скрепок в банке" Unit="скрепок" />
                    </div>
                </div>
            }
            else
            {
                <SummaryChip Key="jar" Title="стартовое число и размер банки"
                             Text="@($"🫙 {habit.Stats.Total} {HabitCard.ClipsWord(habit.Stats.Total)} · {(habit.Stats.WeekPaused ? "⚠" : $"🔥{habit.Stats.WeekStreak}")}")"
                             OnClick="@(() => _rare.Open("jar"))" />
            }
        }
    </div>
    <AddersRow Items="Adders" OnAdd="key => _rare.Open(key)" />

    <div class="buttons">
        <MoreMenu Class="left">
            @if (_recurring && _habit && State.HabitOfGoal(EditedGoal) is { } habitItem)
            {
                <MenuItem Label="🫙 открыть привычку" OnClick="() => OpenHabitAsync(habitItem.Id)" />
                <div class="menu-sep" role="separator"></div>
            }
            <MenuItem Label="удалить цель" Danger="true" Class="trash" OnClick="DeleteAsync" />
        </MoreMenu>
        <button type="button" class="btn quiet" @onclick="OnClose">Отмена</button>
        <button type="button" class="btn primary" disabled="@string.IsNullOrWhiteSpace(_title)" @onclick="SaveAsync">Сохранить</button>
    </div>
</div>

@if (_endQuestion is { } preview)
{
    <SeriesEndDialog Title="@_title.Trim()" Preview="preview" OnConfirm="ConfirmEndAsync" OnCancel="CancelEnd" />
}

@code {
    private const int MaxTimesPerWeek = 7;

    private ElementReference _titleInput;
    private string _title = "";
    private List<int> _roleIds = [];
    private int _times;
    private TimeOnly? _time;
    private int? _quadrant;
    private int? _duration;
    private string? _notes;
    private bool _recurring;
    private bool _habit;
    private int _projectId; // 0 — без проекта
    private bool _projectChanged;
    private RareFields _rare = null!; // раскрытые редкие поля (не запоминаются, U2-b)
    private Touched _touched; // какой переключатель меняли в этом окне — его подсказка видна строкой (U2.6)

    private enum Touched { None, Recurring, Habit }

    private string RecurringHint => _recurring ? "каждую неделю, правка — с этой недели" : "только эта неделя";

    private string HabitHint => _habit ? "занятия — скрепки" : "без банки";

    private string? TouchedHint => _touched switch
    {
        Touched.Recurring => RecurringHint,
        Touched.Habit when _recurring => HabitHint,
        _ => null,
    };

    private void OnHabitChanged() => _touched = Touched.Habit;

    /// <summary>«Повтор: будни» — сводка выбранных дней: по пункту списка, а у «своих дней» — сами дни.</summary>
    private string DaysText => _repeat == Repeat.Custom
        ? string.Join(", ", DayNames.Where((_, i) => (_days & (1 << i)) != 0))
        : RepeatChoices.First(c => c.Value == _repeat).Label;

    /// <summary>«+ дни · + время · + длительность · + несколько в день · + квадрант · + проект · + заметки» — пустые и не раскрытые (U2.2).</summary>
    private IReadOnlyList<(string Key, string Label)> Adders
    {
        get
        {
            var list = new List<(string, string)>();
            void Add(bool empty, string key, string label)
            {
                if (empty && !_rare.IsOpen(key))
                {
                    list.Add((key, label));
                }
            }

            Add(_recurring && !DaysChosen, "days", "дни");
            Add(_time is null, "time", "время");
            Add(_duration is null, "duration", "длительность");
            Add(!_several, "several", "несколько в день");
            Add(_quadrant is null, "quadrant", "квадрант");
            Add(ShownProjectId == 0, "project", "проект");
            Add(string.IsNullOrWhiteSpace(_notes), "notes", "заметки");
            return list;
        }
    }
    /// <summary>Подсказка поля «Проект» (D6): у постоянной — только выбранный; у разовой без проекта — первый шаг его создаст.</summary>
    private string ProjectHint => !ShowsSteps ? "только выбранный: книга, курс" : ShownProjectId == 0 ? "первый шаг создаст проект" : "новые занятия — шаги проекта";

    private SeriesEndPreviewDto? _endQuestion; // вопрос «Закончить серию?» (E1.2) открыт
    private bool _endConfirmed;
    private bool _refocus; // вопрос закрыли «Отмена» — фокус обратно в окно (иначе Esc его не закроет)
    private ElementReference _root;

    /// <summary>
    /// Кого можно выбрать проектом (P1, S7): открытые дела без родителя, не занятия целей — из ленты и из показанной недели;
    /// текущий проект — всегда (даже выполненный, с пометкой).
    /// </summary>
    private IReadOnlyList<Choice<int>> ProjectChoices
    {
        get
        {
            var current = State.FindGoal(EditedGoal.Id) ?? EditedGoal;
            var list = new List<Choice<int>> { new(0, "— нет") };
            if (current.ProjectId is { } id && ShownProjectId == id)
            {
                list.Add(new(id, (current.ProjectTitle ?? "проект") + (current.ProjectIsTrashed ? " (в корзине)" : current.ProjectIsOpen ? "" : " (выполнен)"), Emoji: "🛠"));
            }

            list.AddRange(State.ProjectCandidates()
                .Where(t => t.Id != current.ProjectId)
                .Select(t => new Choice<int>(t.Id, t.Title, Emoji: "🛠"))); // BP6
            return list.DistinctBy(c => c.Value).ToList();
        }
    }

    /// <summary>Что в поле: выбранное здесь, а пока не трогали — проект цели (его мог только что создать «+ шаг», G3).</summary>
    private int ShownProjectId => _projectChanged ? _projectId : (State.FindGoal(EditedGoal.Id) ?? EditedGoal).ProjectId ?? 0;

    /// <summary>
    /// Блок «Шаги»: у разовой цели — всегда (первый шаг создаст проект, G3); у постоянной (здесь или уже на сервере) — только при выбранном
    /// проекте не в корзине (A2). Выбор в поле до «Сохранить» блок не показывает: шаги — того проекта, что уже выбран у цели.
    /// </summary>
    private bool ShowsSteps =>
        !(_recurring || EditedGoal.IsRecurring) || (State.FindGoal(EditedGoal.Id) ?? EditedGoal) is { ProjectId: not null, ProjectIsTrashed: false };

    /// <summary>«×» у раскрытого поля (batch-3.md, M1.2): очистить и свернуть обратно в «+ …».</summary>
    private void Clear(string key, Action reset)
    {
        reset();
        _rare.Close(key);
    }

    private void SetProject(int projectId)
    {
        _projectId = projectId;
        _projectChanged = true;
    }
    private bool _several;
    private int _startCount;
    private int _jarSize = 30;
    private int _days; // маска дней (Пн = 1 … Вс = 64), 0 — «сам раскладываю»

    private const int EveryDay = 127;
    private const int WorkDaysMask = 31; // Пн–Пт
    private const int WeekendMask = 96; // Сб, Вс
    private static readonly string[] DayNames = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];

    private enum Repeat { Manual, EveryDay, Weekdays, Weekend, Custom }

    private static readonly List<Choice<Repeat>> RepeatChoices =
    [
        new(Repeat.Manual, "сам раскладываю"),
        new(Repeat.EveryDay, "каждый день"),
        new(Repeat.Weekdays, "будни"),
        new(Repeat.Weekend, "выходные"),
        new(Repeat.Custom, "свои дни"),
    ];

    private Repeat _repeat;

    private static Repeat RepeatOf(int days) => days switch
    {
        0 => Repeat.Manual,
        EveryDay => Repeat.EveryDay,
        WorkDaysMask => Repeat.Weekdays,
        WeekendMask => Repeat.Weekend,
        _ => Repeat.Custom,
    };

    private void SetRepeat(Repeat repeat)
    {
        _repeat = repeat;
        _days = repeat switch
        {
            Repeat.Manual => 0,
            Repeat.EveryDay => EveryDay,
            Repeat.Weekdays => WorkDaysMask,
            Repeat.Weekend => WeekendMask,
            _ => _days, // «свои дни» — с выбранных сейчас
        };
    }

    private void ToggleDay(int bit)
    {
        _days ^= bit;
        _repeat = Repeat.Custom;
    }

    private bool DaysChosen => _recurring && _days != 0;

    private static int DayCount(int days) => System.Numerics.BitOperations.PopCount((uint)days);

    [Parameter, EditorRequired]
    public WeeklyGoalDto EditedGoal { get; set; } = null!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized(); // перерисовка при изменениях: «+ шаг» мог создать проект (G3)
        _rare = new RareFields(JS);
        _title = EditedGoal.Title;
        _roleIds = [.. EditedGoal.RoleIds];
        _times = EditedGoal.TimesPerWeek;
        _time = EditedGoal.StartTime;
        _quadrant = EditedGoal.Quadrant;
        _duration = EditedGoal.DurationMinutes;
        _notes = EditedGoal.Notes;
        _recurring = EditedGoal.IsRecurring;
        _habit = EditedGoal.IsRecurring ? EditedGoal.IsHabit : HabitByDefault;
        _projectId = EditedGoal.ProjectId ?? 0;
        _several = EditedGoal.AllowSeveralPerDay;
        if (State.HabitOfGoal(EditedGoal) is { } habit)
        {
            _startCount = habit.StartCount;
            _jarSize = habit.JarSize;
        }

        _days = EditedGoal.Days ?? 0;
        _repeat = RepeatOf(_days);
    }

    /// <summary>«Копить» по умолчанию (так же решает сервер): есть роль-измерение пилы — копить.</summary>
    private bool HabitByDefault => _roleIds.Any(id => State.FindRole(id)?.IsSharpenSaw == true);

    /// <summary>Включили «каждую неделю» — «копить» предустанавливается по ролям (видно до «Сохранить»).</summary>
    private void OnRecurringChanged()
    {
        _touched = Touched.Recurring;
        if (_recurring && !EditedGoal.IsRecurring)
        {
            _habit = HabitByDefault;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _titleInput.FocusAsync();
        }
        else if (_refocus)
        {
            _refocus = false;
            await _root.FocusAsync();
        }

        await _rare.AfterRenderAsync();
    }

    /// <summary>«Отмена» в вопросе E1.2: окно цели остаётся как набрано.</summary>
    private void CancelEnd()
    {
        _endQuestion = null;
        _refocus = true;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
        else if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
        {
            await SaveAsync();
        }
    }

    private async Task OnTitleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.CtrlKey && !e.MetaKey)
        {
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_title) || _endQuestion is not null)
        {
            return;
        }

        // Выключили «каждую неделю», а на следующих неделях уже есть цели — сначала вопрос (E1.2)
        if (EditedGoal.IsRecurring && !_recurring && !_endConfirmed
            && await State.SeriesEndPreviewAsync(EditedGoal.Id) is { Goals: > 0 } preview)
        {
            _endQuestion = preview;
            return;
        }

        // Банка — у привычки, а не у цели: сохраняется отдельно (привычка остаётся той же, даже если цель перестанет повторяться)
        var habit = State.HabitOfGoal(EditedGoal);
        await OnClose.InvokeAsync();
        await State.UpdateGoalAsync(EditedGoal.Id,
            new UpdateGoalRequest(_title, _roleIds, DaysChosen ? DayCount(_days) : _times, _time, _quadrant, _notes, _duration,
                _recurring, _several, Days: DaysChosen ? _days : 0, IsHabit: _recurring ? _habit : null,
                ProjectId: _projectChanged ? _projectId : null)); // проект, созданный «+ шаг», уже выбран на сервере
        if (habit is not null && (habit.StartCount, habit.JarSize) != (_startCount, _jarSize))
        {
            await State.UpdateHabitAsync(habit.Id, _startCount, _jarSize);
        }
    }

    /// <summary>«Закончить серию» в вопросе E1.2 — сохранить окно как набрано.</summary>
    private async Task ConfirmEndAsync()
    {
        _endQuestion = null;
        _endConfirmed = true;
        await SaveAsync();
    }

    /// <summary>Пилюля «🫙 привычка: …» — экран «Копилки» на этой привычке (несохранённая правка окна теряется, как при «Отмена»).</summary>
    private async Task OpenHabitAsync(int habitId)
    {
        await OnClose.InvokeAsync();
        Windows.OpenHabits(habitId);
    }

    /// <summary>Удалить; мысль цели без дня вернётся в ленту (без своей категории — в «неразобранное»).</summary>
    private async Task DeleteAsync()
    {
        var goalId = EditedGoal.Id;
        await OnClose.InvokeAsync();
        await Windows.DeleteGoalAsync(State, goalId); // постоянную — с вопросом
    }
}
