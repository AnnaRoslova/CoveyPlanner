@* Окно цели — шаблон занятий: название, роли (можно несколько), «раз в неделю», «каждую неделю», копилка, время, квадрант, длительность, заметки.
   Изменения расходятся по невыполненным занятиям недели (кроме полей, которые у занятия свои);
   роль и квадрант — по всем занятиям. Enter в названии — сохранить, Esc или клик мимо — отмена.
   Стили — css/editor.css. *@
@inject PlannerState State
@inject WindowHost Windows

<div class="editor-backdrop" @onclick="OnClose"></div>

<div class="editor" role="dialog" aria-label="Цель недели" @onkeydown="OnKeyDown">
    <input @ref="_titleInput" class="title-input" maxlength="500" placeholder="Цель на неделю"
           @bind="_title" @bind:event="oninput" @onkeydown="OnTitleKey" />

    <div class="rock-note">
        <span class="pill-rock">цель</span>
        шаблон занятий: новые занятия берут эти значения
        @if (EditedGoal.TimesPerWeek > 1 || EditedGoal.Sessions.Count > 0)
        {
            <text> · сделано @EditedGoal.DoneCount из @EditedGoal.TimesPerWeek</text>
        }
    </div>

    <div class="field">
        <div class="label">Роль</div>
        @* Роли — можно несколько: цель видна под каждой (одна и та же, прогресс общий); хотя бы одна *@
        <RolePicker Roles="State.OrderedRoles" Value="_roleIds" ValueChanged="ids => _roleIds = [.. ids]" Required="true" />
    </div>

    <div class="field">
        <div class="label">Раз в неделю</div>
        <div class="times-per-week">
            @if (DaysChosen)
            {
                @* Дни выбраны — «раз в неделю» задают они *@
                <span class="times-fixed">@DayCount(_days)</span>
                <span class="hint">= числу выбранных дней</span>
            }
            else
            {
                <Stepper Value="_times" ValueChanged="times => _times = times ?? 1" Min="1" Max="MaxTimesPerWeek" Label="Раз в неделю" />
            }
        </div>
    </div>

    @* «Каждую неделю»: цель сама появляется на следующих неделях; правка — с этой недели и дальше *@
    <label class="switch-row">
        <input type="checkbox" role="switch" @bind="_recurring" />
        <span class="switch"></span>
        <span>каждую неделю</span>
        <span class="hint">@(_recurring ? "появится и на следующих неделях; изменения — с этой недели и дальше" : "только на этой неделе")</span>
    </label>

    @if (_recurring)
    {
        @* Повтор: «сам раскладываю» — как раньше; дни выбраны — занятия встают в них сами.
           Кружки дней можно переключать руками — тогда в списке «свои дни» *@
        <div class="field">
            <div class="repeat-row">
                <span class="label">Повтор</span>
                <ChoiceField TValue="Repeat" Items="RepeatChoices" Value="_repeat" ValueChanged="SetRepeat" Label="Повтор" />
            </div>
            @if (_repeat != Repeat.Manual)
            {
                <div class="day-dots" role="group" aria-label="Дни">
                    @for (var i = 0; i < DayNames.Length; i++)
                    {
                        var bit = 1 << i;
                        var on = (_days & bit) != 0;
                        <button type="button" class="day-dot @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")"
                                title="@DayNames[i]" aria-label="@DayNames[i]" @onclick="() => ToggleDay(bit)">@DayNames[i][..1]</button>
                    }
                </div>
            }
            @if (DaysChosen)
            {
                <div class="date-hint">занятия встанут в эти дни сами — на этой неделе и дальше; выполненные не трогаются</div>
            }
        </div>
    }

    <label class="switch-row">
        <input type="checkbox" role="switch" @bind="_several" />
        <span class="switch"></span>
        <span>можно несколько раз в день</span>
        <span class="hint">@(_several ? "например, утром и вечером" : "в один день — не больше одного занятия")</span>
    </label>

    @* Копилка — часть шаблона: занятия цели становятся скрепками в ней *@
    <div class="field">
        <div class="label">🫙 В копилку</div>
        <HabitField @bind-Value="_habitId" NewName="@_title" NewNorm="@(DaysChosen ? DayCount(_days) : _times)"
                    NewColor="@State.OrderedRoles.FirstOrDefault(r => _roleIds.Contains(r.Id))?.Color" />
    </div>

    <div class="row">
        <div class="field">
            <div class="label">Время</div>
            <TimePicker @bind-Value="_time" />
        </div>

        <div class="field">
            <div class="label">Квадрант</div>
            <QuadrantPicker @bind-Value="_quadrant" />
        </div>
    </div>
    @if (_quadrant is { } q)
    {
        <div class="quadrant-hint">@QuadrantPicker.Hint(q)</div>
    }

    <div class="field">
        <div class="label">Длительность</div>
        <DurationPicker @bind-Value="_duration" />
    </div>

    <div class="field">
        <div class="label">Заметки</div>
        <textarea rows="3" maxlength="10000" placeholder="Что делать на занятии, ссылки…" @bind="_notes" @bind:event="oninput"></textarea>
    </div>

    <div class="buttons">
        <button type="button" class="btn danger trash" @onclick="DeleteAsync">удалить цель</button>
        <button type="button" class="btn quiet" @onclick="OnClose">Отмена</button>
        <button type="button" class="btn" disabled="@string.IsNullOrWhiteSpace(_title)" @onclick="SaveAsync">Сохранить</button>
    </div>
</div>

@code {
    private const int MaxTimesPerWeek = 7;

    private ElementReference _titleInput;
    private string _title = "";
    private List<int> _roleIds = [];
    private int _times;
    private TimeOnly? _time;
    private int? _quadrant;
    private int? _duration;
    private string? _notes;
    private bool _recurring;
    private bool _several;
    private int? _habitId;
    private int _days; // маска дней (Пн = 1 … Вс = 64), 0 — «сам раскладываю»

    private const int EveryDay = 127;
    private const int WorkDaysMask = 31; // Пн–Пт
    private const int WeekendMask = 96; // Сб, Вс
    private static readonly string[] DayNames = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];

    private enum Repeat { Manual, EveryDay, Weekdays, Weekend, Custom }

    private static readonly List<Choice<Repeat>> RepeatChoices =
    [
        new(Repeat.Manual, "сам раскладываю"),
        new(Repeat.EveryDay, "каждый день"),
        new(Repeat.Weekdays, "будни"),
        new(Repeat.Weekend, "выходные"),
        new(Repeat.Custom, "свои дни"),
    ];

    private Repeat _repeat;

    private static Repeat RepeatOf(int days) => days switch
    {
        0 => Repeat.Manual,
        EveryDay => Repeat.EveryDay,
        WorkDaysMask => Repeat.Weekdays,
        WeekendMask => Repeat.Weekend,
        _ => Repeat.Custom,
    };

    private void SetRepeat(Repeat repeat)
    {
        _repeat = repeat;
        _days = repeat switch
        {
            Repeat.Manual => 0,
            Repeat.EveryDay => EveryDay,
            Repeat.Weekdays => WorkDaysMask,
            Repeat.Weekend => WeekendMask,
            _ => _days, // «свои дни» — с выбранных сейчас
        };
    }

    private void ToggleDay(int bit)
    {
        _days ^= bit;
        _repeat = Repeat.Custom;
    }

    private bool DaysChosen => _recurring && _days != 0;

    private static int DayCount(int days) => System.Numerics.BitOperations.PopCount((uint)days);

    [Parameter, EditorRequired]
    public WeeklyGoalDto EditedGoal { get; set; } = null!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override void OnInitialized()
    {
        _title = EditedGoal.Title;
        _roleIds = [.. EditedGoal.RoleIds];
        _times = EditedGoal.TimesPerWeek;
        _time = EditedGoal.StartTime;
        _quadrant = EditedGoal.Quadrant;
        _duration = EditedGoal.DurationMinutes;
        _notes = EditedGoal.Notes;
        _recurring = EditedGoal.IsRecurring;
        _several = EditedGoal.AllowSeveralPerDay;
        _habitId = EditedGoal.HabitId;
        _days = EditedGoal.Days ?? 0;
        _repeat = RepeatOf(_days);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _titleInput.FocusAsync();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
        else if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
        {
            await SaveAsync();
        }
    }

    private async Task OnTitleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.CtrlKey && !e.MetaKey)
        {
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_title))
        {
            return;
        }

        await OnClose.InvokeAsync();
        await State.UpdateGoalAsync(EditedGoal.Id,
            new UpdateGoalRequest(_title, _roleIds, DaysChosen ? DayCount(_days) : _times, _time, _quadrant, _notes, _duration,
                _recurring, _several, Days: DaysChosen ? _days : 0, HabitId: _habitId ?? 0));
    }

    /// <summary>Удалить; мысль цели без дня вернётся в ленту (без своей категории — в «неразобранное»).</summary>
    private async Task DeleteAsync()
    {
        var goalId = EditedGoal.Id;
        await OnClose.InvokeAsync();
        await Windows.DeleteGoalAsync(State, goalId); // постоянную — с вопросом
    }
}
