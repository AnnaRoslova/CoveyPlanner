@* Окно роли: создание или правка — название и цвет; для пользовательских ролей — ещё удаление.
   Измерения «Затачивания пилы» нельзя переименовать и удалить — только сменить цвет.
   Порядок ролей меняется перетаскиванием карточки роли. Esc или клик по затемнению — отмена.
   Общие стили окна — css/editor.css. *@
@inject PlannerState State

<div class="editor-backdrop" @onclick="OnClose"></div>

<div class="editor role-editor" role="dialog" aria-label="@(Role is null ? "Новая роль" : "Роль")" @onkeydown="OnKeyDown">
    <div class="window-title">@(Role is null ? "Новая роль" : "Роль")</div>

    @if (Role is { IsSharpenSaw: true })
    {
        <div class="saw-name">@Role.Name</div>
    }
    else
    {
        <InlineInput @bind-Value="_name" Placeholder="Название роли" MaxLength="100"
                     OnSubmit="SaveAsync" OnCancel="OnClose" CancelOnEmptyBlur="false" />
    }

    <ColorSwatches @bind-Selected="_color" />

    @if (_askCategory)
    {
        <CategoryChoice Prompt="Дела целей без дня вернуть в категорию:" ButtonText="Удалить роль"
                        OnChoose="categoryId => DeleteAsync(categoryId)" OnCancel="() => _askCategory = false" />
    }
    else if (_confirmDelete)
    {
        <div class="confirm">
            <span>Удалить роль «@Role!.Name»? Её цели на всех неделях удалятся, у дел роль снимется.</span>
            <div class="buttons">
                <button type="button" class="btn quiet" @onclick="() => _confirmDelete = false">Нет</button>
                <button type="button" class="btn danger" @onclick="() => DeleteAsync(null)">Удалить</button>
            </div>
        </div>
    }
    else
    {
        <div class="buttons">
            @if (Role is { IsSharpenSaw: false })
            {
                <button type="button" class="btn danger trash delete" @onclick="() => _confirmDelete = true">удалить</button>
            }
            <button type="button" class="btn quiet" @onclick="OnClose">Отмена</button>
            <button type="button" class="btn" disabled="@(Role is not { IsSharpenSaw: true } && string.IsNullOrWhiteSpace(_name))"
                    @onclick="() => SaveAsync(_name)">
                @(Role is null ? "Создать" : "Сохранить")
            </button>
        </div>
    }
</div>

@code {
    private string _name = "";
    private string _color = "";
    private bool _confirmDelete;
    private bool _askCategory;

    /// <summary>Правка роли; null — создание новой.</summary>
    [Parameter]
    public RoleDto? Role { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override void OnInitialized()
    {
        _name = Role?.Name ?? "";
        _color = Role?.Color ?? State.NextRoleColor;
    }

    private async Task SaveAsync(string name)
    {
        if (Role is null)
        {
            if (string.IsNullOrWhiteSpace(name))
            {
                return;
            }

            await OnClose.InvokeAsync();
            await State.CreateRoleAsync(name, _color);
        }
        else
        {
            if (!Role.IsSharpenSaw && string.IsNullOrWhiteSpace(name))
            {
                return;
            }

            await OnClose.InvokeAsync();
            await State.UpdateRoleAsync(Role.Id, name, _color);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task DeleteAsync(int? categoryId)
    {
        switch (await State.DeleteRoleAsync(Role!.Id, categoryId))
        {
            case ReturnResult.Done:
                await OnClose.InvokeAsync();
                break;

            case ReturnResult.NeedsCategory:
                _confirmDelete = false;
                _askCategory = true;
                break;
        }
    }
}
