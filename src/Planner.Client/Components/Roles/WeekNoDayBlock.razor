@* «На неделе · N» (docs/specs/next-batch.md, N4.2; fixes-2026-10.md, B2) — дела показанной недели без дня: под ролью (с этой ролью) или внизу
   левой панели (RoleId = null — без роли: бывает, когда у такого дела убрали роли или удалили роль, B3a). Виден, только если дела есть,
   и всегда раскрыт; клик по делу — окно; дело тащат в день, в ленту, на цель, на роль.
   Список под ролью — ещё и место, куда бросить дело «на эту неделю без дня» с этой ролью (как на заголовок роли, B5); «без роли» — нет. *@
@inherits StateComponent
@inject WindowHost Windows

@{ var tasks = State.WeekTasksWithoutDay(RoleId); }
@if (tasks.Count > 0)
{
    <div class="week-nd"
         data-drop="@(RoleId is null ? null : DragDropService.WeekZone)" data-key="@RoleId" data-accept="@(RoleId is null ? null : DragDropService.WeekAccepts)"
         data-drop-index="@(RoleId is null ? null : "2147483647")" data-drop-hover="@(RoleId is null ? null : "")">
        <div class="wnd-h">@(RoleId is null ? "на неделе без роли" : "на неделе") · @tasks.Count</div>
        @foreach (var task in tasks)
        {
            var id = task.Id;
            var roles = State.RolesOf(task);
            <ItemRow @key="id" Title="@task.Title" Compact="true" Clamp="true"
                     Color="@roles.FirstOrDefault()?.Color"
                     IsDone="task.State == TaskStateDto.Done"
                     IsPending="id < 0"
                     IsFlashing="State.FlashTaskId == id"
                     ParentCaption="@State.ParentTitleOf(task)"
                     OnToggle="() => State.SetDoneAsync(id, task.State != TaskStateDto.Done)"
                     OnClick="() => id > 0 ? Open(id) : Task.CompletedTask"
                     DragKind="@(id < 0 ? null : task.ParentId is null ? DragDropService.DayItem : DragDropService.StepItem)"
                     DragId="id" DragParent="task.ParentId" NoStep="task.IsProject" />
        }
    </div>
}

@code {
    /// <summary>Роль блока; null — «без роли» внизу левой панели.</summary>
    [Parameter]
    public int? RoleId { get; set; }

    private Task Open(int id)
    {
        Windows.OpenTask(id);
        return Task.CompletedTask;
    }
}
