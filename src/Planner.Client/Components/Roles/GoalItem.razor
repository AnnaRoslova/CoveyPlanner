@* Цель недели: отметка, название и где она запланирована *@

<div class="goal @(Goal.IsDone ? "done" : "")" data-drag="goal" data-id="@Goal.Id">
    <span class="check @(Goal.IsDone ? "checked" : "")">
        @if (Goal.IsDone)
        {
            <Icon Name="check" Size="11" />
        }
    </span>
    <span class="title">@Goal.Title</span>
    @if (Goal.PlannedDate is { } date)
    {
        <span class="when" title="Запланировано">
            @RuDates.ShortDay(date)@(Goal.StartTime is { } time ? " " + RuDates.Time(time) : "")
        </span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public WeeklyGoalDto Goal { get; set; } = null!;
}
