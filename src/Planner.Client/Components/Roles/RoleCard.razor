@* Роль (или измерение пилы) и её цели на неделю *@
@inject PlannerState State

<div class="role @(Role.IsSharpenSaw ? "saw" : "")" style="--c: @Role.Color"
     data-drop="role" data-role="@Role.Id">
    <div class="role-h">
        <span class="dot"></span>
        <span class="name">@Role.Name</span>
        @if (Goals.Count > 0)
        {
            <span class="n">@Goals.Count(g => g.IsDone)/@Goals.Count</span>
        }
    </div>

    @foreach (var goal in Goals)
    {
        <ItemRow Title="@goal.Title" Color="@Role.Color" IsDone="goal.IsDone"
                 WhenLabel="@WhenLabel(goal)" DragKind="goal" DragId="goal.Id" />
    }

    @if (!Role.IsSharpenSaw && Goals.Count > State.RecommendedGoalsPerWeek)
    {
        <div class="hint">Кови советует 1–@State.RecommendedGoalsPerWeek больших камня</div>
    }

    <button class="add">+ цель</button>
</div>

@code {
    [Parameter, EditorRequired]
    public RoleDto Role { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyList<WeeklyGoalDto> Goals { get; set; } = [];

    /// <summary>«Ср» или «Ср 10:00», если цель уже стоит в дне.</summary>
    private static string? WhenLabel(WeeklyGoalDto goal) => goal.PlannedDate is { } date
        ? RuDates.ShortDay(date) + (goal.StartTime is { } time ? " " + RuDates.Time(time) : "")
        : null;
}
