@* Роль (или измерение пилы) и её цели на неделю.
   Цель делается N раз в неделю: у неё занятия (дела-«камни» в днях), прогресс «2/5» и дни «Чт · Пт».
   Справа у цели — процент выполненных занятий недели («50%», норма выполнена — «100% ✓»), перед ним — шаги её проекта («☑ 1/3 · 25%»).
   Свёрнутые цели (Folded) — одна строка «название · процент», без дней и «2/5».
   Чекбокс — отметить ближайшее занятие, клик по цели — окно цели (шаблон занятий, «раз в неделю»),
   крестик — удалить, «+ цель» — новая цель в конец.
   «⋯» в заголовке — окно роли (название, цвет, удаление). Порядок ролей — перетаскиванием карточки.
   Под целями — тихая строка «ещё дела: N ▸»: остальные дела недели с этой ролью; раскрывается в список
   «Чт · название», клик по делу — его окно. Раскрытие запоминается (RoleTasksState). *@
@inject PlannerState State
@inject WindowHost Windows
@inject RoleTasksState RoleTasks

<div class="role @(Role.IsSharpenSaw ? "saw" : "")" style="--c: @Role.Color"
     data-drop="@DragDropService.RoleZone" data-key="@Role.Id" data-accept="@DragDropService.RoleAccepts"
     data-drag="@(Role.IsSharpenSaw ? null : DragDropService.RoleItem)" data-id="@Role.Id">
    <div class="role-h" data-list-head>
        <span class="dot"></span>
        <span class="name">@Role.Name</span>
        <button type="button" class="menu" title="Изменить роль" @onclick="() => Windows.OpenRole(Role.Id)">
            <Icon Name="more" Size="14" />
        </button>
        @if (Goals.Count > 0)
        {
            <span class="n">@Goals.Count(g => g.IsDone)/@Goals.Count</span>
        }
    </div>

    @foreach (var goal in Goals)
    {
        <ItemRow Title="@goal.Title" Color="@Role.Color" IsDone="goal.IsDone" Compact="Folded"
                 Progress="@(Folded ? null : Progress(goal))" Days="@(Folded ? null : Days(goal))" Percent="goal.Percent" PercentPrefix="@StepsLabel(goal)" IsPending="goal.Id < 0"
                 Unplaced="@UnplacedHint(goal)"
                 OnToggle="() => State.ToggleGoalAsync(goal.Id)"
                 OnClick="() => OpenGoal(goal.Id)"
                 DragKind="@(goal.Id > 0 ? DragDropService.GoalItem : null)" DragId="goal.Id"
                 DropZone="@(goal.Id > 0 ? DragDropService.GoalZone : null)" DropKey="@goal.Id.ToString()"
                 DropAccept="@DragDropService.GoalAccepts" DropHint="сделать занятием этой цели">
            <Actions>
                @if (goal.Id > 0)
                {
                    <button type="button" class="row-action" title="Удалить цель" @onclick="() => Windows.DeleteGoalAsync(State, goal.Id)">
                        <Icon Name="x" Size="12" />
                    </button>
                }
            </Actions>
        </ItemRow>
    }

    @if (!Role.IsSharpenSaw && Goals.Count > State.RecommendedGoalsPerWeek)
    {
        <div class="hint">Кови советует 1–@State.RecommendedGoalsPerWeek больших камня</div>
    }

    @if (_adding)
    {
        <Dismissable OnDismiss="StopAdding" OnClickOutside="SaveAndCloseAsync">
            <InlineInput @bind-Value="_newTitle" Placeholder="Цель на неделю — Enter" MaxLength="500"
                         OnSubmit="AddAsync" OnCancel="StopAdding" CancelOnEmptyBlur="false" />
        </Dismissable>
    }
    else
    {
        <button class="add" @onclick="() => _adding = true">+ цель</button>
    }

    @if (OtherTasks.Count > 0)
    {
        var open = RoleTasks.IsOpen(Role.Id);
        <button type="button" class="others-h" aria-expanded="@(open ? "true" : "false")"
                @onclick="() => RoleTasks.ToggleAsync(Role.Id)">
            ещё дела: @OtherTasks.Count <span class="chev @(open ? "open" : "")"><Icon Name="chevron-right" Size="10" /></span>
        </button>
        @if (open)
        {
            <div class="others">
                @foreach (var task in OtherTasks)
                {
                    <button type="button" class="other @(task.State == TaskStateDto.Done ? "done" : "")" title="@task.Title"
                            @onclick="() => Windows.OpenTask(task.Id)" disabled="@(task.Id < 0)">
                        <span class="d">@RuDates.ShortDay(task.PlannedDate!.Value)</span><span class="sep">·</span><span class="t">@task.Title</span>
                    </button>
                }
            </div>
        }
    }
</div>

@code {
    private bool _adding;
    private string _newTitle = "";

    [Parameter, EditorRequired]
    public RoleDto Role { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyList<WeeklyGoalDto> Goals { get; set; } = [];

    /// <summary>Дела недели с этой ролью, кроме занятий целей, — тихий список «ещё дела» под целями.</summary>
    [Parameter]
    public IReadOnlyList<TaskDto> OtherTasks { get; set; } = [];

    /// <summary>Цели свёрнуты в одну строку «название · процент» (кнопка в шапке панели, все цели сразу).</summary>
    [Parameter]
    public bool Folded { get; set; }

    /// <summary>«☑ 1/3» — шаги проекта цели (R7), перед процентом; шагов нет — null. Меняется сразу: шаги лежат в состоянии экрана.</summary>
    /// <summary>N1: «не разложено: 1 из 2» у недособранной цели текущей или будущей недели; иначе подсветки нет.</summary>
    private static string? UnplacedHint(WeeklyGoalDto goal) =>
        goal.Id > 0 && PlannerState.UnplacedOf(goal, RuDates.Today) is > 0 and var n ? $"не разложено: {n} из {goal.TimesPerWeek}" : null;

    private string? StepsLabel(WeeklyGoalDto goal) =>
        State.StepsOfGoal(goal) is { Count: > 0 } steps ? $"☑ {steps.Count(s => s.State == TaskStateDto.Done)}/{steps.Count}" : null;

    /// <summary>«2/5» — только у цели на несколько раз в неделю.</summary>
    private static string? Progress(WeeklyGoalDto goal) =>
        goal.TimesPerWeek > 1 ? $"{goal.DoneCount}/{goal.TimesPerWeek}" : null;

    /// <summary>Дни, на которые стоят занятия: «Чт · Пт».</summary>
    private static IReadOnlyList<DayMark> Days(WeeklyGoalDto goal) =>
        goal.Sessions
            .Where(s => s.PlannedDate is not null)
            .OrderBy(s => s.PlannedDate)
            .Select(s => new DayMark(RuDates.ShortDay(s.PlannedDate!.Value), s.IsDone))
            .ToList();

    private void OpenGoal(int goalId)
    {
        if (goalId > 0)
        {
            Windows.OpenGoal(goalId);
        }
    }

    private async Task AddAsync(string title)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            return;
        }

        _newTitle = "";
        await State.CreateGoalAsync(Role.Id, title);
    }

    /// <summary>Клик мимо: набранный текст сохраняется, пустое поле просто закрывается (Esc — отмена).</summary>
    private async Task SaveAndCloseAsync()
    {
        var title = _newTitle;
        StopAdding();
        await AddAsync(title);
    }

    private void StopAdding()
    {
        _adding = false;
        _newTitle = "";
    }
}
