@* Роль (или измерение пилы) и её цели на неделю (docs/specs/ui-declutter.md, U1; batch-3.md, M2–M4).
   Название роли — кнопка «▾ / ▸»: сворачивает цели роли (и «на неделе», «дела роли на неделе»), запоминается (RoleFoldState);
   клик по разделу («Затачивание пилы», «Роли») сворачивает цели всех его ролей — названия ролей остаются (M4).
   Свёрнутая — одна строка «▸ ● Работа · 2 цели» и розовая точка, если что-то не разложено (N1, E2). Пока тащат дело или цель, задержка
   над свёрнутой ролью ~0,5 с раскрывает её до броска (js/dnd.js, класс peek; тело роли поэтому рисуется всегда, а прячется стилем).
   Цель делается N раз в неделю: у неё занятия (дела-«камни» в днях); дни занятий и «2 из 3» — в подсказке строки и в окне цели (M2).
   Справа у цели — процент выполненных занятий недели («50%», норма выполнена — «100% ✓»), перед ним — шаги её проекта («☑ 1/3 · 25%»).
   Чекбокс — отметить ближайшее занятие, клик по цели — окно цели (шаблон занятий, «раз в неделю»), крестик — удалить.
   «+» у названия — новая цель в конец (при наведении на роль; у роли без целей — всегда, M3). «⋯» — меню: «изменить роль…»
   (окно роли: название, цвет, удаление) и «дела роли на неделе» — список «Чт · название» под целями (дела недели с этой ролью,
   кроме занятий целей; клик — окно дела; раскрытие запоминается, RoleTasksState). Порядок ролей — перетаскиванием карточки.
   Над ним — «на неделе · N» (N4, B2): дела недели без дня с этой ролью. Дело, брошенное на заголовок роли, — туда же (B5). *@
@inject PlannerState State
@inject WindowHost Windows
@inject RoleTasksState RoleTasks
@inject RoleFoldState RoleFold

@{ var folded = RoleFold.IsFolded(Role.Id) && !FlashInside; }
<div class="role @(Role.IsSharpenSaw ? "saw" : "") @(folded ? "folded" : "") @(Goals.Count == 0 ? "no-goals" : "")" style="--c: @Role.Color"
     data-drop="@DragDropService.RoleZone" data-key="@Role.Id" data-accept="@DragDropService.RoleAccepts"
     data-drag="@(Role.IsSharpenSaw ? null : DragDropService.RoleItem)" data-id="@Role.Id">
    @* Заголовок роли — место, куда бросить дело «на эту неделю без дня» с этой ролью (B5); между целями — новая цель *@
    <div class="role-h" data-list-head data-drop="@DragDropService.WeekZone" data-key="@Role.Id" data-accept="@DragDropService.WeekAccepts"
         data-drop-index="2147483647" data-drop-hover>
        <button type="button" class="role-toggle" data-drag-ok aria-expanded="@(folded ? "false" : "true")"
                title="@((Role.Vision is { } vision ? vision + " · " : "") + (folded ? "развернуть цели роли" : "свернуть цели роли"))" @onclick="() => RoleFold.ToggleAsync(Role.Id)">
            <span class="chev"><Icon Name="@(folded ? "chevron-right" : "chevron-down")" Size="11" /></span>
            <span class="dot"></span>
            <span class="name">@Role.Name</span>
        </button>
        @if (folded)
        {
            @if (Goals.Count > 0)
            {
                <span class="peek">@GoalsWord(Goals.Count)</span>
            }
            @if (HasUnplaced)
            {
                <span class="unplaced-dot" title="есть неразложенное"></span>
            }
        }
        @* M3: «+ цель» — маленький «+» у названия (при наведении; у роли без целей — всегда) *@
        <button type="button" class="add-goal" title="@($"+ цель в «{Role.Name}»")" aria-label="@($"Новая цель в «{Role.Name}»")" @onclick="StartAddingAsync">
            <span aria-hidden="true">+</span>
        </button>
        <MoreMenu Class="menu" Title="@($"Роль «{Role.Name}»: ещё")">
            <MenuItem Label="изменить роль…" Class="edit-role" OnClick="() => Windows.OpenRole(Role.Id)" />
            <MenuItem Label="@(RoleTasks.IsOpen(Role.Id) ? "скрыть дела роли на неделе" : "дела роли на неделе")" Class="role-tasks"
                      Hint="@(OtherTasks.Count > 0 ? OtherTasks.Count.ToString() : null)"
                      DisabledReason="@(OtherTasks.Count == 0 && !RoleTasks.IsOpen(Role.Id) ? "дел на неделе нет" : null)"
                      OnClick="ToggleTasksAsync" />
        </MoreMenu>
    </div>

    <div class="role-body">
    @foreach (var goal in Goals)
    {
        <ItemRow Title="@goal.Title" Color="@Role.Color" IsDone="goal.IsDone"
                 RowTitle="@GoalHint(goal)" Days="@Days(goal)" Percent="@(AllNotNeeded(goal) ? null : goal.Percent)" PercentNone="AllNotNeeded(goal)" PercentHint="@PercentHint(goal)" PercentPrefix="@StepsLabel(goal)" IsPending="goal.Id < 0"
                 Unplaced="@UnplacedHint(goal)"
                 OnToggle="() => State.ToggleGoalAsync(goal.Id)"
                 OnClick="() => OpenGoal(goal.Id)"
                 DragKind="@(goal.Id > 0 ? DragDropService.GoalItem : null)" DragId="goal.Id"
                 DropZone="@(goal.Id > 0 ? DragDropService.GoalZone : null)" DropKey="@goal.Id.ToString()"
                 DropAccept="@DragDropService.GoalAccepts" DropHint="сделать занятием этой цели">
            <Actions>
                @if (goal.Id > 0)
                {
                    <button type="button" class="row-action" title="Удалить цель" @onclick="() => Windows.DeleteGoalAsync(State, goal.Id)">
                        <Icon Name="x" Size="12" />
                    </button>
                }
            </Actions>
        </ItemRow>
    }

    @if (!Role.IsSharpenSaw && Goals.Count > State.RecommendedGoalsPerWeek)
    {
        <div class="hint">лучше 1–@State.RecommendedGoalsPerWeek больших камня</div>
    }

    @if (_adding)
    {
        <Dismissable OnDismiss="StopAdding" OnClickOutside="SaveAndCloseAsync">
            <InlineInput @bind-Value="_newTitle" Placeholder="Цель на неделю — Enter" MaxLength="500"
                         OnSubmit="AddAsync" OnCancel="StopAdding" CancelOnEmptyBlur="false" />
        </Dismissable>
    }

    <WeekNoDayBlock RoleId="Role.Id" />

    @* M3: «дела роли на неделе» — из «⋯» роли: дела недели с этой ролью, кроме занятий целей *@
    @if (RoleTasks.IsOpen(Role.Id))
    {
        <div class="others" aria-label="@($"дела роли «{Role.Name}» на неделе")">
            <div class="others-h">
                <span>дела роли на неделе · @OtherTasks.Count</span>
                <button type="button" class="others-x" title="Скрыть" aria-label="Скрыть дела роли" @onclick="() => RoleTasks.ToggleAsync(Role.Id)">
                    <Icon Name="x" Size="11" />
                </button>
            </div>
            @foreach (var task in OtherTasks)
            {
                <button type="button" class="other @(task.State == TaskStateDto.Done ? "done" : "")" title="@task.Title"
                        @onclick="() => Windows.OpenTask(task.Id)" disabled="@(task.Id < 0)">
                    <span class="d">@RuDates.ShortDay(task.PlannedDate!.Value)</span><span class="sep">·</span><span class="t">@task.Title</span>
                </button>
            }
        </div>
    }
    </div>
</div>

@code {
    private bool _adding;
    private string _newTitle = "";

    [Parameter, EditorRequired]
    public RoleDto Role { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyList<WeeklyGoalDto> Goals { get; set; } = [];

    /// <summary>Дела недели с этой ролью, кроме занятий целей, — тихий список «ещё дела» под целями.</summary>
    [Parameter]
    public IReadOnlyList<TaskDto> OtherTasks { get; set; } = [];

    /// <summary>
    /// В свёрнутой роли что-то не разложено: цель с неразложенными занятиями (N1) или дело «на неделе» без дня (E2) — розовая точка (U1.4).
    /// </summary>
    private bool HasUnplaced =>
        Goals.Any(g => UnplacedHint(g) is not null)
        || State.WeekTasksWithoutDay(Role.Id).Any(t => PlannerState.IsUnassigned(t, State.WeekStart, RuDates.Today));

    /// <summary>Подсвечено дело «на неделе» этой роли («Показать» на плашке B4) — роль видна развёрнутой, пока идёт подсветка.</summary>
    private bool FlashInside => State.FlashTaskId is { } id && State.WeekTasksWithoutDay(Role.Id).Any(t => t.Id == id);

    /// <summary>«1 цель», «2 цели», «5 целей».</summary>
    public static string GoalsWord(int n) => (n % 10, n % 100) switch
    {
        (1, not 11) => $"{n} цель",
        (2 or 3 or 4, not (12 or 13 or 14)) => $"{n} цели",
        _ => $"{n} целей",
    };

    /// <summary>N1: «не разложено: 1 из 2» у недособранной цели текущей или будущей недели; иначе подсветки нет.</summary>
    private static string? UnplacedHint(WeeklyGoalDto goal) =>
        goal.Id > 0 && PlannerState.UnplacedOf(goal, RuDates.Today) is > 0 and var n ? $"не разложено: {n} из {goal.Norm}" : null;

    /// <summary>«☑ 1/3» — шаги проекта цели (R7), перед процентом; шагов нет — null. Меняется сразу: шаги лежат в состоянии экрана.</summary>
    private string? StepsLabel(WeeklyGoalDto goal) =>
        State.StepsOfGoal(goal) is { Count: > 0 } all && all.Where(s => s.SkipKind != PlannerState.NotNeeded).ToList() is var steps
            ? $"☑ {steps.Count(s => s.State == TaskStateDto.Done)}/{steps.Count}" : null;

    /// <summary>Все занятия «не нужно» — вместо процента тихое «—» (skips.md, H2).</summary>
    private static bool AllNotNeeded(WeeklyGoalDto goal) => goal.Norm == 0 && goal.NotNeededCount > 0;

    private static string PercentHint(WeeklyGoalDto goal) =>
        $"выполнено {goal.DoneCount} из {goal.Norm}" + (goal.NotNeededCount > 0 ? $" · не нужно: {goal.NotNeededCount}" : "");

    /// <summary>
    /// Подсказка цели (batch-3.md, M2): «Бег · Чт · Пт · 2 из 3», у недособранной — ещё «не разложено: 1 из 3».
    /// Дни занятий под названием больше не показываются — только здесь и в окне цели.
    /// </summary>
    private static string GoalHint(WeeklyGoalDto goal) =>
        string.Join(" · ", new[] { goal.Title, SessionDays(goal), $"{goal.DoneCount} из {goal.Norm}", UnplacedHint(goal) }
            .Where(part => !string.IsNullOrEmpty(part)));

    /// <summary>Дни занятий для экранного диктора (на экране — в подсказке строки, M2).</summary>
    private static IReadOnlyList<DayMark> Days(WeeklyGoalDto goal) =>
        goal.Sessions
            .Where(s => s.PlannedDate is not null)
            .OrderBy(s => s.PlannedDate)
            .Select(s => new DayMark(RuDates.ShortDay(s.PlannedDate!.Value), s.IsDone))
            .ToList();

    /// <summary>Дни, на которые стоят занятия: «Чт · Пт»; занятий в днях нет — пусто.</summary>
    public static string SessionDays(WeeklyGoalDto goal) =>
        string.Join(" · ", goal.Sessions
            .Where(s => s.PlannedDate is not null)
            .OrderBy(s => s.PlannedDate)
            .Select(s => RuDates.ShortDay(s.PlannedDate!.Value)));

    private void OpenGoal(int goalId)
    {
        if (goalId > 0)
        {
            Windows.OpenGoal(goalId);
        }
    }

    /// <summary>«+» у названия: поле новой цели под ролью (свёрнутая роль раскрывается).</summary>
    private async Task StartAddingAsync()
    {
        _adding = true;
        await RoleFold.UnfoldAsync(Role.Id);
    }

    /// <summary>«⋯ → дела роли на неделе»: показать или скрыть список под ролью (свёрнутая роль раскрывается).</summary>
    private async Task ToggleTasksAsync()
    {
        if (!RoleTasks.IsOpen(Role.Id))
        {
            await RoleFold.UnfoldAsync(Role.Id);
        }

        await RoleTasks.ToggleAsync(Role.Id);
    }

    private async Task AddAsync(string title)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            return;
        }

        _newTitle = "";
        await State.CreateGoalAsync(Role.Id, title);
    }

    /// <summary>Клик мимо: набранный текст сохраняется, пустое поле просто закрывается (Esc — отмена).</summary>
    private async Task SaveAndCloseAsync()
    {
        var title = _newTitle;
        StopAdding();
        await AddAsync(title);
    }

    private void StopAdding()
    {
        _adding = false;
        _newTitle = "";
    }
}
