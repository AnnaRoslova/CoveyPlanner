@* Левая зона: «Затачивание пилы» и роли с целями на неделю (docs/specs/ui-declutter.md, U1; batch-3.md, M4).
   Название роли сворачивает её цели; заголовок раздела («Затачивание пилы», «Роли») — цели всех его ролей, названия ролей остаются;
   в шапке — «свернуть / развернуть всё» для обоих разделов. Всё запоминается в браузере (RoleFoldState). *@
@inherits StateComponent
@inject WindowHost Windows
@inject RoleFoldState RoleFold

<aside class="panel roles-panel">
    <div class="head">
        <div>
            <h2 class="h1" title="большие камни этой недели">Роли и цели</h2>
        </div>
        <div class="head-tools">
            @{ var allFolded = RoleFold.AllFolded(State.OrderedRoles.Select(r => r.Id)); }
            <button type="button" class="icon-b fold" aria-pressed="@(allFolded ? "true" : "false")"
                    title="@(allFolded ? "Развернуть все роли" : "Свернуть все роли")" @onclick="() => RoleFold.SetAllAsync(State.OrderedRoles.Select(r => r.Id), !allFolded)">
                <Icon Name="@(allFolded ? "unfold" : "fold")" Size="14" />
            </button>
            <PanelToggle />
        </div>
    </div>

    <div class="panel-scroll">
        @if (State.ShowMissionInPanel)
        {
            <MissionBlock />
        }

        @* M4.1: заголовок раздела — кнопка-папка: сворачивает цели всех его ролей (названия ролей видны) *@
        @Section("Затачивание пилы", SawIds)
        <div class="saw">
            @foreach (var role in State.SawRoles)
            {
                <RoleCard @key="role.Id" Role="role" Goals="State.GoalsFor(role.Id).ToList()" OtherTasks="State.OtherTasksOf(role.Id)" />
            }
        </div>

        @Section("Роли", UserIds)
        @* Список ролей — зона для перетаскивания ролей (порядок) *@
        <div class="user-roles" data-drop="@DragDropService.RolesZone" data-accept="@DragDropService.RolesAccepts">
            @foreach (var role in State.UserRoles)
            {
                <RoleCard @key="role.Id" Role="role" Goals="State.GoalsFor(role.Id).ToList()" OtherTasks="State.OtherTasksOf(role.Id)" />
            }
        </div>

        <button class="add" @onclick="Windows.OpenNewRole">+ роль</button>

        @* Дела недели без дня и без роли (N4.2) *@
        <WeekNoDayBlock RoleId="null" />
        <GorinDecor Place="GorinPlace.LeftFoot" />
    </div>
</aside>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        RoleFold.Changed += OnFoldChanged;
    }

    public override void Dispose()
    {
        RoleFold.Changed -= OnFoldChanged;
        base.Dispose();
    }

    private void OnFoldChanged() => InvokeAsync(StateHasChanged);

    private IReadOnlyList<int> SawIds => [.. State.SawRoles.Select(r => r.Id)];

    private IReadOnlyList<int> UserIds => [.. State.UserRoles.Select(r => r.Id)];

    /// <summary>Заголовок раздела — «папка» (M4.1): все цели раздела свёрнуты — «▸», иначе «▾»; клик сворачивает или раскрывает их все.</summary>
    private RenderFragment Section(string title, IReadOnlyList<int> ids)
    {
        var folded = RoleFold.AllFolded(ids);
        return @<button type="button" class="sect sect-toggle" aria-expanded="@(folded ? "false" : "true")"
                        title="@(folded ? $"Развернуть цели: {title}" : $"Свернуть цели: {title}")" @onclick="() => RoleFold.ToggleSectionAsync(ids)">
            <span class="chev"><Icon Name="@(folded ? "chevron-right" : "chevron-down")" Size="11" /></span>
            @title
        </button>;
    }
}
