@* Левая зона: «Затачивание пилы» и роли с целями на неделю (docs/specs/ui-declutter.md, U1).
   Название роли сворачивает её цели, «Затачивание пилы» — все 4 измерения сразу; в шапке — «свернуть / развернуть все роли»
   (и пилу). Всё запоминается в браузере (RoleFoldState). *@
@inherits StateComponent
@inject WindowHost Windows
@inject RoleFoldState RoleFold

<aside class="panel roles-panel">
    <div class="head">
        <div>
            <h2 class="h1" title="большие камни этой недели">Роли и цели</h2>
        </div>
        <div class="head-tools">
            @{ var allFolded = RoleFold.AllFolded(State.OrderedRoles.Select(r => r.Id)); }
            <button type="button" class="icon-b fold" aria-pressed="@(allFolded ? "true" : "false")"
                    title="@(allFolded ? "Развернуть все роли" : "Свернуть все роли")" @onclick="() => RoleFold.SetAllAsync(State.OrderedRoles.Select(r => r.Id), !allFolded)">
                <Icon Name="@(allFolded ? "unfold" : "fold")" Size="14" />
            </button>
            <PanelToggle />
        </div>
    </div>

    <div class="panel-scroll">
        @* «Затачивание пилы» — кнопка: сворачивает все 4 измерения (U1.3) *@
        <button type="button" class="sect sect-toggle" aria-expanded="@(RoleFold.IsSawFolded ? "false" : "true")"
                title="@(RoleFold.IsSawFolded ? "Развернуть измерения пилы" : "Свернуть измерения пилы")" @onclick="RoleFold.ToggleSawAsync">
            <span class="chev"><Icon Name="@(RoleFold.IsSawFolded ? "chevron-right" : "chevron-down")" Size="11" /></span>
            Затачивание пилы
            @if (RoleFold.IsSawFolded && SawHasUnplaced)
            {
                <span class="unplaced-dot" title="есть неразложенное"></span>
            }
        </button>
        <div class="saw @(RoleFold.IsSawFolded ? "folded" : "")">
            @foreach (var role in State.SawRoles)
            {
                <RoleCard @key="role.Id" Role="role" Goals="State.GoalsFor(role.Id).ToList()" OtherTasks="State.OtherTasksOf(role.Id)" />
            }
        </div>

        <div class="sect">Роли</div>
        @* Список ролей — зона для перетаскивания ролей (порядок) *@
        <div class="user-roles" data-drop="@DragDropService.RolesZone" data-accept="@DragDropService.RolesAccepts">
            @foreach (var role in State.UserRoles)
            {
                <RoleCard @key="role.Id" Role="role" Goals="State.GoalsFor(role.Id).ToList()" OtherTasks="State.OtherTasksOf(role.Id)" />
            }
        </div>

        <button class="add" @onclick="Windows.OpenNewRole">+ роль</button>

        @* Дела недели без дня и без роли (N4.2) *@
        <WeekNoDayBlock RoleId="null" />
    </div>
</aside>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        RoleFold.Changed += OnFoldChanged;
    }

    public override void Dispose()
    {
        RoleFold.Changed -= OnFoldChanged;
        base.Dispose();
    }

    private void OnFoldChanged() => InvokeAsync(StateHasChanged);

    /// <summary>В свёрнутой пиле что-то не разложено (цели N1, дела «на неделе» E2) — розовая точка у заголовка.</summary>
    private bool SawHasUnplaced => State.SawRoles.Any(role =>
        State.GoalsFor(role.Id).Any(g => g.Id > 0 && PlannerState.UnplacedOf(g, RuDates.Today) > 0)
        || State.WeekTasksWithoutDay(role.Id).Any(t => PlannerState.IsUnassigned(t, State.WeekStart, RuDates.Today)));
}
