@* Левая зона: «Затачивание пилы» и роли с целями на неделю *@
@inherits StateComponent
@inject WindowHost Windows

<aside class="panel roles-panel">
    <div class="head">
        <div>
            <h2 class="h1">Роли и цели</h2>
            <div class="sub">большие камни этой недели</div>
        </div>
        <PanelToggle />
    </div>

    <div class="panel-scroll">
        <div class="sect">Затачивание пилы</div>
        <div class="saw">
            @foreach (var role in State.SawRoles)
            {
                <RoleCard @key="role.Id" Role="role" Goals="State.GoalsFor(role.Id).ToList()" />
            }
        </div>

        <div class="sect">Роли</div>
        @* Список ролей — зона для перетаскивания ролей (порядок) *@
        <div class="user-roles" data-drop="@DragDropService.RolesZone" data-accept="@DragDropService.RolesAccepts">
            @foreach (var role in State.UserRoles)
            {
                <RoleCard @key="role.Id" Role="role" Goals="State.GoalsFor(role.Id).ToList()" />
            }
        </div>

        <button class="add" @onclick="Windows.OpenNewRole">+ роль</button>
    </div>
</aside>
