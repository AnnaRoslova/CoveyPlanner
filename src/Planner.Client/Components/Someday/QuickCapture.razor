@* Быстрое поле «Записать мысль…» + выбор категории (по умолчанию — «неразобранное»; выбранная
   категория держится до перезагрузки страницы). Enter — мысль уходит наверх выбранного места,
   поле очищается и готово к следующей. *@
@inherits StateComponent

<div class="quick">
    <input placeholder="Записать мысль…" title="Записать мысль (N)" maxlength="500"
           @bind="_text" @bind:event="oninput" @onkeydown="OnKeyDown" />
    @* Видна только иконка категории; сам select прозрачный поверх неё — список раскрывается с названиями *@
    @{ var selected = State.FindCategory(SelectedCategoryId); }
    <label class="cat-pick" title="Куда: @(selected?.Name ?? UnsortedName)">
        <span class="cat-icon @(selected is not null && selected.Emoji is null ? "text" : "")">@CategoryIcon(selected)</span>
        <select aria-label="Категория" @bind:get="SelectedKey" @bind:set="SetSelectedKey">
            <option value="">@UnsortedName</option>
            @foreach (var category in State.OrderedCategories)
            {
                <option value="@category.Id">@CategoryLabel(category)</option>
            }
        </select>
    </label>
</div>

@if (_saved is not null)
{
    <div class="saved">✓ записано в @_saved</div>
}

@code {
    private static readonly TimeSpan SavedHintFor = TimeSpan.FromSeconds(2);

    private string _text = "";
    private int? _categoryId;
    private string? _saved;
    private int _savedVersion;

    private const string UnsortedName = "неразобранное";

    /// <summary>Выбранная категория; null (или её удалили) — «неразобранное».</summary>
    private int? SelectedCategoryId => State.FindCategory(_categoryId)?.Id;

    /// <summary>Значение в списке: Id категории или "" — «неразобранное».</summary>
    private string SelectedKey => SelectedCategoryId?.ToString() ?? "";

    private void SetSelectedKey(string? key) => _categoryId = int.TryParse(key, out var id) ? id : null;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _text = "";
            return;
        }

        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_text))
        {
            return;
        }

        var title = _text;
        _text = "";
        var category = State.FindCategory(SelectedCategoryId);
        ShowSaved(category is null ? UnsortedName : CategoryLabel(category));
        if (!await State.CreateSomedayTaskAsync(title, category?.Id))
        {
            _saved = null; // не сохранилось — об этом скажет сообщение внизу
        }
    }

    private void ShowSaved(string categoryLabel)
    {
        _saved = categoryLabel;
        var version = ++_savedVersion;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(SavedHintFor);
            if (version == _savedVersion)
            {
                _saved = null;
                StateHasChanged();
            }
        });
    }

    /// <summary>Эмодзи категории, а без него — название (обрезается по ширине: «Проекты» и «Покупки» различаются).</summary>
    /// <summary>Значок выбора (ui-declutter.md, D8): эмодзи категории, «неразобранное» — 📥, без эмодзи — короткое название (так «Проекты» и «Покупки» различаются); название — в подсказке и списке.</summary>
    private static string CategoryIcon(CategoryDto? category) =>
        category is null ? "📥" : category.Emoji ?? category.Name;

    private static string CategoryLabel(CategoryDto category) =>
        category.Emoji is null ? category.Name : $"{category.Emoji} {category.Name}";
}
