@* Правая зона: лента «Когда-нибудь» — поиск, быстрый ввод, категории-аккордеон, корзина.
   Сверху над категориями — «+ категория» (новая встаёт в начало) и «свернуть / развернуть всё»;
   «+ категория» есть и внизу (новая — в конец). Над всем этим — «неразобранное» (мысли без категории).
   «Записать мысль» есть всегда: без категорий мысли просто копятся в «неразобранном». *@
@inherits StateComponent

<aside class="panel someday">
    <div class="top">
        <PanelToggle />
        <div class="search">
            <Icon Name="search" Size="14" />
            <input type="search" placeholder="Поиск по ленте" @bind="_search" @bind:event="oninput"
                   @onkeydown="OnSearchKey" />
        </div>
    </div>

    <QuickCapture />

    <div class="panel-scroll">
        @{ var unsorted = State.SomedayIn(null).Where(t => !IsSearching || TextSearch.Contains(t.Title, Query)).ToList(); }
        <UnsortedSection Tasks="unsorted" Search="@Query" />

        @if (State.Categories.Count == 0 && !_creatingCategory && !IsSearching)
        {
            <button class="first-category" @onclick="() => _creatingCategory = true">
                Разложить мысли по темам помогут категории.<br />
                <span>+ создайте первую категорию</span>
            </button>
        }

        @if (State.Categories.Count > 0 && !IsSearching)
        {
            <div class="feed-tools">
                <button class="add" @onclick="() => _newCategoryAtTop = true">+ категория</button>
                <button class="fold" @onclick="() => State.SetAllCategoriesExpandedAsync(!State.AnyCategoryExpanded)">
                    @(State.AnyCategoryExpanded ? "свернуть всё" : "развернуть всё")
                </button>
            </div>
        }

        @if (_newCategoryAtTop)
        {
            <CategoryEditor AtTop="true" OnClose="() => _newCategoryAtTop = false" />
        }

        @foreach (var category in State.OrderedCategories)
        {
            var tasks = State.SomedayIn(category.Id).ToList();
            if (!IsSearching || MatchesSearch(category, tasks))
            {
                <CategorySection @key="category.Id" Category="category" Tasks="tasks" Search="@Query" />
            }
        }

        @if (IsSearching && unsorted.Count == 0 && !State.OrderedCategories.Any(c => MatchesSearch(c, State.SomedayIn(c.Id).ToList())))
        {
            <div class="nothing">Ничего не нашлось</div>
        }

        @if (_creatingCategory)
        {
            <CategoryEditor OnClose="() => _creatingCategory = false" />
        }
        else if (State.Categories.Count > 0 && !IsSearching)
        {
            <button class="add" @onclick="() => _creatingCategory = true">+ категория</button>
        }
    </div>

    <button class="trash" title="Корзина" @onclick="() => _trashOpen = !_trashOpen">
        <Icon Name="trash" Size="15" />
    </button>

    @if (_trashOpen)
    {
        <TrashPopup OnClose="() => _trashOpen = false" />
    }
</aside>

@code {
    private string _search = "";
    private bool _creatingCategory;
    private bool _newCategoryAtTop;
    private bool _trashOpen;

    private string Query => _search.Trim();

    private bool IsSearching => Query.Length > 0;

    private bool MatchesSearch(CategoryDto category, IReadOnlyList<TaskDto> tasks) =>
        TextSearch.Contains(category.Name, Query) || tasks.Any(t => TextSearch.Contains(t.Title, Query));

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _search = "";
        }
    }
}
