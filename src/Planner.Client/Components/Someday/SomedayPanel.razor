@* Правая зона: лента «Когда-нибудь» — поиск, быстрый ввод, категории-аккордеон, корзина.
   Сверху над категориями — «+ категория» (новая встаёт в начало) и «свернуть / развернуть всё»;
   «+ категория» есть и внизу (новая — в конец). Над всем этим — «неразобранное» (мысли без категории).
   «Записать мысль» есть всегда: без категорий мысли просто копятся в «неразобранном».
   Кнопка 🛠 в шапке недели показывает здесь же «🛠 Проекты» (N6.8): проекты в ленте не живут (N6.2). *@
@inherits StateComponent
@inject WindowHost Windows
@inject RightPanelState RightPanel

<aside class="panel someday @(RightPanel.IsProjects ? "projects-mode" : "")">
    @if (RightPanel.IsProjects)
    {
        <div class="top">
            <PanelToggle />
            <div class="search">
                <Icon Name="search" Size="14" />
                <input type="search" placeholder="Поиск по проектам" value="@RightPanel.ProjectQuery"
                       @oninput="e => RightPanel.ProjectQuery = e.Value?.ToString() ?? string.Empty" @onkeydown="OnProjectSearchKey" />
            </div>
        </div>
        <ProjectsList Query="@RightPanel.ProjectQuery" />
    }
    else
    {
    <div class="top">
        <PanelToggle />
        <div class="search">
            <Icon Name="search" Size="14" />
            <input type="search" placeholder="Поиск по ленте" @bind="_search" @bind:event="oninput"
                   @onkeydown="OnSearchKey" />
        </div>
    </div>

    <QuickCapture />

    <div class="panel-scroll">
        @{ var unsorted = State.SomedayIn(null).Where(t => !IsSearching || State.FeedMatches(t, Query)).ToList(); }
        <UnsortedSection Tasks="unsorted" Search="@Query" />

        @if (State.Categories.Count == 0 && !_creatingCategory && !IsSearching)
        {
            <button class="first-category" @onclick="() => _creatingCategory = true">
                Разложить мысли по темам помогут категории.<br />
                <span class="add">+ создайте первую категорию</span>
            </button>
        }

        @if (State.Categories.Count > 0 && !IsSearching)
        {
            <div class="feed-tools">
                <button class="add" @onclick="() => _newCategoryAtTop = true">+ категория</button>
                <button class="btn fold" @onclick="() => State.SetAllCategoriesExpandedAsync(!State.AnyCategoryExpanded)">
                    @(State.AnyCategoryExpanded ? "свернуть всё" : "развернуть всё")
                </button>
            </div>
        }

        @if (_newCategoryAtTop)
        {
            <CategoryEditor AtTop="true" OnClose="() => _newCategoryAtTop = false" />
        }

        @foreach (var category in State.OrderedCategories)
        {
            var tasks = State.SomedayIn(category.Id).ToList();
            if (!IsSearching || MatchesSearch(category, tasks))
            {
                <CategorySection @key="category.Id" Category="category" Tasks="tasks" Search="@Query" />
            }
        }

        @if (IsSearching && unsorted.Count == 0 && !State.OrderedCategories.Any(c => MatchesSearch(c, State.SomedayIn(c.Id).ToList())))
        {
            <div class="nothing">Ничего не нашлось</div>
        }

        @* Проекты в ленте не показываются — совпавшие найдутся в «🛠 Проекты» (N6.12) *@
        @if (IsSearching && State.ProjectsMatching(Query) is > 0 and var inProjects)
        {
            <button type="button" class="btn in-projects" @onclick="() => RightPanel.ShowProjectsAsync(Query)">🛠 в проектах: @inProjects</button>
        }

        @if (_creatingCategory)
        {
            <CategoryEditor OnClose="() => _creatingCategory = false" />
        }
        else if (State.Categories.Count > 0 && !IsSearching)
        {
            <button class="add" @onclick="() => _creatingCategory = true">+ категория</button>
        }
    </div>
    }

    <div class="feed-foot">
        @* Корзина — ещё и место, куда можно бросить запись (дело, мысль, цель): она удаляется, как из окна *@
        <button class="trash" title="Корзина" @onclick="() => _trashOpen = !_trashOpen"
                data-drop="@DragDropService.TrashZone" data-accept="@DragDropService.TrashAccepts" data-drop-index="0" data-drop-hover>
            @* Что-то ушло в корзину — значок коротко «вздрагивает» (@key: анимация заново на каждое удаление) *@
            <span @key="State.TrashPulse" class="trash-ico @(State.TrashPulse > 0 ? "shake" : "")"><Icon Name="trash" Size="15" /></span>
        </button>
    </div>

    @if (_trashOpen)
    {
        <TrashPopup OnClose="() => _trashOpen = false" />
    }
</aside>

@code {
    private string _search = "";
    private bool _creatingCategory;
    private bool _newCategoryAtTop;
    private bool _trashOpen;

    private string Query => _search.Trim();

    private bool IsSearching => Query.Length > 0;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RightPanel.Changed += OnPanelChanged;
    }

    public override void Dispose()
    {
        RightPanel.Changed -= OnPanelChanged;
        base.Dispose();
    }

    private void OnPanelChanged() => InvokeAsync(StateHasChanged);

    private bool MatchesSearch(CategoryDto category, IReadOnlyList<TaskDto> tasks) =>
        TextSearch.Contains(category.Name, Query) || tasks.Any(t => State.FeedMatches(t, Query));

    private void OnProjectSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            RightPanel.ProjectQuery = "";
        }
    }

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _search = "";
        }
    }
}
