@* Корзина: всплывающее окно над иконкой. Вернуть / удалить навсегда (с подтверждением в строке) / очистить всё
   (без вопроса: окно закрывается, внизу плашка «Корзина очищена · Вернуть»).
   Дело ленты, у которого больше нет своей категории, возвращается в «неразобранное». *@
@inject PlannerState State

<div class="backdrop" @onclick="OnClose"></div>

<div class="trash-popup" role="dialog" aria-label="Корзина" tabindex="-1" @ref="_popup" @onkeydown="OnKeyDown">
    <div class="title">
        <span>Корзина</span>
        <button type="button" class="row-action" title="Закрыть" @onclick="OnClose"><Icon Name="x" Size="12" /></button>
    </div>

    @if (_items is null)
    {
        <div class="empty">Загрузка…</div>
    }
    else if (_items.Count == 0)
    {
        <div class="empty">Пусто</div>
    }
    else
    {
        <div class="list">
            @foreach (var task in _items)
            {
                <div class="row">
                    <div class="text">
                        <div>@task.Title</div>
                        @if (_confirmDeleteId == task.Id)
                        {
                            <div class="confirm">
                                <span>Удалить навсегда?</span>
                                <button type="button" class="btn quiet" @onclick="() => _confirmDeleteId = null">Нет</button>
                                <button type="button" class="btn danger" @onclick="() => DeleteAsync(task)">Да</button>
                            </div>
                        }
                        else
                        {
                            <div class="from">@FromLabel(task)</div>
                        }
                    </div>
                    <button type="button" class="row-action positive" title="Вернуть" @onclick="() => RestoreAsync(task)">
                        <Icon Name="restore" Size="13" />
                    </button>
                    <button type="button" class="row-action" title="Удалить навсегда" @onclick="() => _confirmDeleteId = task.Id">
                        <Icon Name="x" Size="12" />
                    </button>
                </div>
            }
        </div>

        <div class="footer">
            <button type="button" class="btn danger" @onclick="EmptyAsync">очистить всё</button>
        </div>
    }
</div>

@code {
    private ElementReference _popup;
    private List<TaskDto>? _items;
    private int? _confirmDeleteId;

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnInitializedAsync() => _items = await State.GetTrashAsync();

    // Фокус на окно — чтобы Esc закрывал его сразу
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _popup.FocusAsync();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }

    /// <summary>Откуда дело попало в корзину: из дня плана или из категории ленты.</summary>
    private string FromLabel(TaskDto task)
    {
        if (task.PlannedDate is { } date)
        {
            return $"из плана: {RuDates.ShortDay(date)}, {RuDates.DayMonth(date)}";
        }

        return State.FindCategory(task.CategoryId) is { } category
            ? $"из ленты: {(category.Emoji is null ? "" : category.Emoji + " ")}{category.Name}"
            : "из ленты: неразобранное";
    }

    private async Task RestoreAsync(TaskDto task)
    {
        if (await State.RestoreFromTrashAsync(task.Id))
        {
            _items?.Remove(task);
        }
    }

    private async Task DeleteAsync(TaskDto task)
    {
        _confirmDeleteId = null;
        _items?.Remove(task);
        await State.DeleteForeverAsync(task.Id);
    }

    /// <summary>Очистить всё: окно закрывается, а «Вернуть» — на плашке внизу.</summary>
    private async Task EmptyAsync()
    {
        await OnClose.InvokeAsync();
        await State.EmptyTrashAsync();
    }
}
