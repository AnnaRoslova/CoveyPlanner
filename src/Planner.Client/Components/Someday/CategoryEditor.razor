@* Создание или правка категории: эмодзи + название; при правке — ещё и удаление.
   Пустая категория удаляется сразу; в непустой спрашиваем, что делать с делами:
   переложить в «неразобранное» или удалить вместе с ними (дела — в корзину).
   Закрывается, как окно: кликом мимо и по Esc (= «Отмена»). *@
@inject PlannerState State

<Dismissable OnDismiss="OnClose">
<div class="cat-editor">
    <div class="line">
        <button type="button" class="emoji-btn @(_emoji.Length == 0 ? "empty" : "")"
                title="Иконка категории" @onclick="() => _showEmojis = !_showEmojis">
            @(_emoji.Length == 0 ? "☺" : _emoji)
        </button>
        <InlineInput @bind-Value="_name" Placeholder="Название категории" MaxLength="100"
                     OnSubmit="SaveAsync" OnCancel="OnClose" CancelOnEmptyBlur="false" />
    </div>

    @if (Category is not null && State.CollectionOfCategory(Category.Id) is { } collection)
    {
        @* Связь с коллекцией настраивается в окне коллекции на экране «Копилки» *@
        <div class="linked" title="выполненные дела этой категории сами попадают в коллекцию">→ @collection.Emoji @collection.Name</div>
    }

    @if (_showEmojis)
    {
        <EmojiPicker Selected="@_emoji" OnPick="PickEmoji" />
    }

    @if (_confirmDelete)
    {
        <div class="confirm">
            <span>Удалить «@Category!.Name»? В ней @TaskCount @TasksWord(TaskCount).</span>
            <div class="choices">
                <button type="button" class="btn" @onclick="() => DeleteAsync(keepTasks: true)">Переложить в неразобранное</button>
                <button type="button" class="btn danger" @onclick="() => DeleteAsync(keepTasks: false)">Удалить вместе с делами</button>
                <button type="button" class="btn quiet" @onclick="() => _confirmDelete = false">Отмена</button>
            </div>
        </div>
    }
    else
    {
        <div class="buttons">
            @if (Category is not null)
            {
                <button type="button" class="btn quiet delete" @onclick="AskDeleteAsync">удалить</button>
            }
            <button type="button" class="btn quiet" @onclick="OnClose">Отмена</button>
            <button type="button" class="btn" disabled="@string.IsNullOrWhiteSpace(_name)" @onclick="() => SaveAsync(_name)">
                @(Category is null ? "Создать" : "Сохранить")
            </button>
        </div>
    }
</div>
</Dismissable>

@code {
    private string _name = "";
    private string _emoji = "";
    private bool _showEmojis;
    private bool _confirmDelete;

    /// <summary>Правка существующей категории; null — создание новой.</summary>
    [Parameter]
    public CategoryDto? Category { get; set; }

    /// <summary>Новая категория — в начало списка (кнопка сверху ленты), иначе — в конец.</summary>
    [Parameter]
    public bool AtTop { get; set; }

    /// <summary>Закрыть редактор (после сохранения, удаления или отмены).</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private int TaskCount => Category is null ? 0 : State.SomedayCount(Category.Id);

    protected override void OnInitialized()
    {
        _name = Category?.Name ?? "";
        _emoji = Category?.Emoji ?? "";
    }

    private void PickEmoji(string emoji)
    {
        _emoji = emoji;
        _showEmojis = false;
    }

    private async Task SaveAsync(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        if (Category is null)
        {
            await State.CreateCategoryAsync(name, _emoji.Length == 0 ? null : _emoji, AtTop);
        }
        else
        {
            await State.UpdateCategoryAsync(Category.Id, name, _emoji);
        }

        await OnClose.InvokeAsync();
    }

    /// <summary>Пустую категорию — удалить сразу, в непустой — спросить, что делать с делами.</summary>
    private async Task AskDeleteAsync()
    {
        if (TaskCount == 0)
        {
            await DeleteAsync(keepTasks: false);
        }
        else
        {
            _confirmDelete = true;
        }
    }

    /// <summary>keepTasks — дела в «неразобранное», иначе — в корзину.</summary>
    private async Task DeleteAsync(bool keepTasks)
    {
        await OnClose.InvokeAsync();
        await State.DeleteCategoryAsync(Category!.Id, keepTasks);
    }

    private static string TasksWord(int count) => (count % 100, count % 10) switch
    {
        ( >= 11 and <= 14, _) => "дел",
        (_, 1) => "дело",
        (_, >= 2 and <= 4) => "дела",
        _ => "дел",
    };
}
