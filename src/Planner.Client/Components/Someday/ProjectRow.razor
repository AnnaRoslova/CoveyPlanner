@* Строка «🛠 Проекты» (N6.10) — как строка ленты: чекбокс (проект без дня — «выполнено в ленте» с плашкой, в дне — обычная отметка),
   «☑ 2/5» и полоска, «⌄» — шаги с «+ шаг» (и у проекта без шагов — чтобы добавить первый), метка дня у проекта в плане, клик — окно.
   Проект тащат в день или в другую группу панели; на строку можно бросить шаг из дня (снять с дня, S20). *@
@inherits StateComponent
@inject WindowHost Windows
@inject ProjectFoldState Folds

@{
    var project = Item.Id > 0 ? State.ProjectOf(Item.Id) : null;
    var expanded = StepMatches || Folds.IsOpen(Item.Id);
    var planned = Item.State == TaskStateDto.Planned;
    var roles = State.RolesOf(Item);
}
<ItemRow Title="@Item.Title" Notes="@Item.Notes" Highlight="@Search" Clamp="true"
         Color="@(roles.FirstOrDefault()?.Color ?? "var(--b)")"
         IsPending="Item.Id < 0"
         IsFlashing="State.FlashTaskId == Item.Id"
         Expanded="@(Item.Id > 0 ? expanded : null)"
         OnExpand="() => Folds.ToggleAsync(Item.Id)"
         ProjectLabel="@PlannerState.ProjectLabel(project)"
         IsProject="true"
         StepsProgress="@PlannerState.ProgressOf(project)"
         DayLabel="@(Item.PlannedDate is { } date ? RuDates.ShortDate(date) : null)"
         DropZone="@(Item.Id > 0 ? DragDropService.TaskZone : null)"
         DropKey="@Item.Id.ToString()"
         DropAccept="@DragDropService.TaskAccepts"
         DropHint="@($"сделать шагом «{Item.Title}»")"
         DropHintOwn="снять с дня — в список шагов"
         NoStep="true"
         OnToggle="ToggleAsync"
         DragKind="@(Item.Id < 0 ? null : planned ? DragDropService.DayItem : DragDropService.SomedayItem)" DragId="Item.Id"
         OnClick="Open" />
@if (expanded && Item.Id > 0)
{
    <ProjectSteps ParentId="Item.Id" LongDates="true" Highlight="@Search" />
}

@code {
    [Parameter, EditorRequired]
    public TaskDto Item { get; set; } = null!;

    /// <summary>Текст поиска панели; пусто — поиска нет.</summary>
    [Parameter]
    public string? Search { get; set; }

    /// <summary>Во время поиска совпал шаг — проект раскрыт, совпадение подсвечено.</summary>
    private bool StepMatches =>
        !string.IsNullOrWhiteSpace(Search) && State.StepsOf(Item.Id).Any(s => TextSearch.Contains(s.Title, Search));

    private Task ToggleAsync()
    {
        if (Item.Id < 0)
        {
            return Task.CompletedTask;
        }

        return Item.State == TaskStateDto.Someday
            ? State.CompleteInFeedAsync(Item.Id)
            : State.SetDoneAsync(Item.Id, true);
    }

    private void Open()
    {
        if (Item.Id < 0)
        {
            return;
        }

        if (Item.State == TaskStateDto.Someday)
        {
            Windows.OpenSomedayTask(Item.Id);
        }
        else
        {
            Windows.OpenTask(Item.Id);
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Folds.Changed += OnFoldsChanged;
    }

    public override void Dispose()
    {
        Folds.Changed -= OnFoldsChanged;
        base.Dispose();
    }

    private void OnFoldsChanged() => InvokeAsync(StateHasChanged);
}
